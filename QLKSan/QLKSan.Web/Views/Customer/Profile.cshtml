@{
    Layout = "_CustomerLayout";
    ViewData["Title"] = "Hồ sơ";
    var customer = ViewBag.Customer as QLKSan.Models.Entities.KhachHang;
    var contact = customer?.LienHeDiaChis?.FirstOrDefault();

    int points = customer != null ? customer.DiemTichLuy : 0;
    string tierName = "Thành viên Đồng";
    string nextTier = "Thành viên Bạc";
    int maxForNext = 1000;
    
    if (points >= 5000) { tierName = "Thành viên Kim Cương"; nextTier = "Thành viên Kim Cương"; maxForNext = points; }
    else if (points >= 3000) { tierName = "Thành viên Vàng"; nextTier = "Thành viên Kim Cương"; maxForNext = 5000; }
    else if (points >= 1000) { tierName = "Thành viên Bạc"; nextTier = "Thành viên Vàng"; maxForNext = 3000; }

    double progress = maxForNext > 0 && points < 5000 ? (double)points / maxForNext * 100 : 100;
}

<!-- Hero Section -->
<div class="profile-hero">
    <div class="profile-hero-left">
        <div class="welcome-label">Chào mừng quay trở lại</div>
        <div class="profile-name">@(customer != null ? customer.Ten : "Khách quý")</div>
        <div class="profile-points">
            <div>
                <div class="points-label">Trạng thái Điểm Tích Lũy</div>
                <div class="d-flex align-items-baseline gap-2">
                    <i class="fas fa-gem" style="color:var(--lr-gold)"></i>
                    <span class="points-value">@(customer != null ? customer.DiemTichLuy.ToString("N0") : "0")</span>
                    <span style="font-size:0.85rem">Điểm</span>
                </div>
            </div>
        </div>
    </div>
    <div class="profile-hero-right">
        <img src="/images/hero.png" alt="Luxe Hotel Terrace">
    </div>
</div>

<!-- Info Grid -->
<div class="profile-grid">
    <div class="lr-card">
        <div class="d-flex justify-content-between align-items-start mb-3">
            <h4>Thông tin cá nhân</h4>
            <a href="#" onclick="alert('Tính năng chỉnh sửa thông tin cá nhân đang được bảo trì. Vui lòng liên hệ lễ tân để được hỗ trợ!')" class="lr-edit-link">Chỉnh sửa</a>
        </div>
        <div class="mb-3">
            <div class="lr-info-label">Họ và tên</div>
            <div class="lr-info-row">
                <span class="lr-info-value">@(customer != null ? $"{customer.Ho} {customer.Ten}" : "Chưa cập nhật")</span>
                <span class="lr-info-label">CCCD / Passport</span>
            </div>
            <span class="lr-info-value" style="float:right;margin-top:-20px">@(customer != null ? customer.CCCD_Passport : "N/A")</span>
        </div>
        <div class="mb-0 mt-4">
            <div class="lr-info-label">Sở thích nghỉ dưỡng</div>
            <div class="lr-info-value">Hạng phòng cao cấp, Hướng biển đẹp, Dịch vụ ẩm thực Michelin, Phục vụ chu đáo 24/7</div>
        </div>
    </div>

    <div class="lr-card-dark">
        <div class="lr-card-label">Liên hệ & Địa chỉ</div>
        <h4 style="font-family:'Playfair Display',serif;color:#fff">Liên hệ & Địa chỉ</h4>
        <div class="lr-contact-row">
            <i class="fas fa-envelope"></i>
            <div>
                <div class="lr-info-label" style="color:rgba(255,255,255,0.5)">Email</div>
                <span>@(contact != null ? contact.Email : "chưa cập nhật")</span>
            </div>
        </div>
        <div class="lr-contact-row">
            <i class="fas fa-phone"></i>
            <div>
                <div class="lr-info-label" style="color:rgba(255,255,255,0.5)">Số điện thoại</div>
                <span>@(contact != null ? contact.SDT : "chưa cập nhật")</span>
            </div>
        </div>
        <div class="lr-contact-row">
            <i class="fas fa-map-marker-alt"></i>
            <div>
                <div class="lr-info-label" style="color:rgba(255,255,255,0.5)">Địa chỉ</div>
                <span>@(contact != null ? $"{contact.DiaChi}, {contact.QuocGia}" : "chưa cập nhật")</span>
            </div>
        </div>
        <button onclick="alert('Tính năng đang được cập nhật!')" class="btn-dark-full mt-3">Cập nhật thông tin liên hệ</button>
    </div>
</div>

<!-- Bottom Cards -->
<div class="profile-bottom-grid">
    <div class="bottom-card">
        <div class="bc-icon"><i class="fas fa-tag"></i></div>
        <h5>@tierName</h5>
        <p>Bạn tích lũy được @(points.ToString("N0")) điểm dịch vụ tại Luxe Reserve.</p>
        <div class="membership-bar" style="background:#eee">
            <div class="membership-bar-fill" style="width:@(progress)%;background:var(--lr-gold); height:8px; border-radius:4px;"></div>
        </div>
        <div class="d-flex justify-content-between mt-2">
            <small class="text-muted">HIỆN TẠI</small>
            <small class="text-muted">@nextTier.ToUpper()</small>
        </div>
    </div>
    <div class="bottom-card">
        <div class="bc-label">Trải nghiệm thượng lưu</div>
        <h5>Dịch vụ ẩm thực Michelin</h5>
        <p>Thưởng thức tinh hoa ẩm thực đỉnh cao với thẻ thành viên hoàng gia.</p>
        <a href="#accommodation-section" class="bc-link">Xem thực đơn Michelin →</a>
    </div>
    <div class="bottom-card">
        <div class="bc-label">Quản gia</div>
        <h5>Hỗ trợ riêng biệt</h5>
        <p>Trợ lý cá nhân của bạn đã sẵn sàng hỗ trợ lịch trình.</p>
        <a href="mailto:concierge@luxereserve.com" class="bc-link">Gửi email cho Quản gia <i class="fas fa-envelope"></i></a>
    </div>
</div>
