@{
    Layout = "_CustomerLayout";
    ViewData["Title"] = "Hồ sơ";
    var customer = ViewBag.Customer as QLKSan.Models.DTOs.CustomerDto;
    var contact = customer?.LienHeDiaChis?.FirstOrDefault();
    var lichSuDiem = ViewBag.Points as List<QLKSan.Models.DTOs.PointHistoryDto> ?? new List<QLKSan.Models.DTOs.PointHistoryDto>();

    // Hạng thành viên do API xét theo điểm trọn đời (điểm hiện có + điểm đã đổi)
    int points = customer != null ? customer.DiemTichLuy : 0;
    var tv = customer?.ThanhVien;
    string tierName = tv?.Hang ?? "Thành viên";
    string nextTier = tv?.HangKeTiep ?? tierName;
    double progress = tv == null || tv.HangKeTiep == null || tv.MocHangKeTiep <= 0 ? 100 : Math.Min(100, (double)tv.DiemXetHang / tv.MocHangKeTiep * 100);
    var diaChi = contact == null ? null : string.Join(", ", new[] { contact.DiaChi, contact.QuocGia }.Where(x => !string.IsNullOrWhiteSpace(x)));
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<!-- Hero Section -->
<div class="profile-hero">
    <div class="profile-hero-left">
        <div class="welcome-label">Chào mừng quay trở lại</div>
        <div class="profile-name">@(customer?.HoTen ?? "Quý khách")</div>
        <div class="profile-points">
            <div>
                <div class="points-label">Điểm tích luỹ</div>
                <div class="d-flex align-items-baseline gap-2">
                    <i class="fas fa-gem" style="color:var(--lr-gold)"></i>
                    <span class="points-value">@points.ToString("N0")</span>
                    <span style="font-size:0.85rem">điểm · @tierName</span>
                </div>
            </div>
        </div>
    </div>
    <div class="profile-hero-right">
        <img src="/images/hero.png" alt="Sảnh khách sạn LUXE RESERVE">
    </div>
</div>

<!-- Info Grid -->
<div class="profile-grid">
    <div class="lr-card">
        <h4>Thông tin cá nhân</h4>
        <div class="row g-3">
            <div class="col-sm-6">
                <div class="lr-info-label">Họ và tên</div>
                <div class="lr-info-value">@(customer?.HoTen ?? "Chưa cập nhật")</div>
            </div>
            <div class="col-sm-6">
                <div class="lr-info-label">CCCD / Hộ chiếu</div>
                <div class="lr-info-value">@(customer?.CCCD_Passport ?? "Chưa cập nhật")</div>
            </div>
            <div class="col-sm-6">
                <div class="lr-info-label">Ngày sinh</div>
                <div class="lr-info-value">@(customer != null && customer.NgaySinh > DateTime.MinValue ? customer.NgaySinh.ToString("dd/MM/yyyy") : "Chưa cập nhật")</div>
            </div>
            <div class="col-sm-6">
                <div class="lr-info-label">Số lần đặt phòng</div>
                <div class="lr-info-value">@(customer?.SoLanDatPhong ?? 0) lần</div>
            </div>
        </div>
        <p class="text-muted small mt-4 mb-2"><i class="fas fa-circle-info me-1"></i>Cần thay đổi họ tên hoặc giấy tờ? Vui lòng liên hệ quầy lễ tân để được cập nhật.</p>
        <a href="@Url.Action("ChangePassword", "Auth")" class="lr-edit-link"><i class="fas fa-key me-1"></i>Đổi mật khẩu</a>
    </div>

    <div class="lr-card-dark">
        <div class="lr-card-label">Liên hệ</div>
        <h4 style="font-family:var(--lr-serif);color:#fff">Liên hệ &amp; Địa chỉ</h4>
        <div class="lr-contact-row">
            <i class="fas fa-envelope"></i>
            <div>
                <div class="lr-info-label" style="color:rgba(255,255,255,0.5)">Email</div>
                <span>@(string.IsNullOrWhiteSpace(contact?.Email) ? "Chưa cập nhật" : contact.Email)</span>
            </div>
        </div>
        <div class="lr-contact-row">
            <i class="fas fa-phone"></i>
            <div>
                <div class="lr-info-label" style="color:rgba(255,255,255,0.5)">Số điện thoại</div>
                <span>@(string.IsNullOrWhiteSpace(contact?.SDT) ? "Chưa cập nhật" : contact.SDT)</span>
            </div>
        </div>
        <div class="lr-contact-row">
            <i class="fas fa-map-marker-alt"></i>
            <div>
                <div class="lr-info-label" style="color:rgba(255,255,255,0.5)">Địa chỉ</div>
                <span>@(string.IsNullOrWhiteSpace(diaChi) ? "Chưa cập nhật" : diaChi)</span>
            </div>
        </div>
        <div class="lr-contact-row">
            <i class="fas fa-heart"></i>
            <div>
                <div class="lr-info-label" style="color:rgba(255,255,255,0.5)">Sở thích lưu trú</div>
                <span>@(string.IsNullOrWhiteSpace(customer?.SoThich) ? "Chưa cập nhật" : customer.SoThich)</span>
            </div>
        </div>
        <button type="button" class="lr-btn-outline-sm mt-2" data-bs-toggle="modal" data-bs-target="#contactModal">
            <i class="fas fa-pen"></i> Cập nhật liên hệ
        </button>
    </div>
</div>

<!-- Sửa liên hệ -->
<div class="modal fade" id="contactModal" tabindex="-1" aria-labelledby="contactModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="UpdateContact" method="post">
                <div class="modal-header">
                    <h5 class="modal-title font-playfair" id="contactModalTitle">Cập nhật liên hệ</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold" for="ctSdt">Số điện thoại</label>
                        <input id="ctSdt" name="SDT" class="form-control" value="@contact?.SDT" required pattern="0[35789][0-9]{8}" title="10 số, bắt đầu bằng 03, 05, 07, 08 hoặc 09" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold" for="ctEmail">Email</label>
                        <input id="ctEmail" name="Email" type="email" class="form-control" value="@contact?.Email" maxlength="100" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold" for="ctDiaChi">Địa chỉ</label>
                        <input id="ctDiaChi" name="DiaChi" class="form-control" value="@contact?.DiaChi" required maxlength="255" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold" for="ctQuocGia">Quốc gia</label>
                        <input id="ctQuocGia" name="QuocGia" class="form-control" value="@(contact?.QuocGia ?? "Việt Nam")" maxlength="50" />
                    </div>
                    <div>
                        <label class="form-label small fw-semibold" for="ctSoThich">Sở thích lưu trú</label>
                        <textarea id="ctSoThich" name="SoThich" class="form-control" rows="2" maxlength="500" placeholder="Gối mềm, tầng cao, dị ứng…">@customer?.SoThich</textarea>
                        <small class="text-muted">Khách sạn sẽ chuẩn bị theo sở thích của bạn khi còn phòng phù hợp.</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="lr-btn-outline-sm" data-bs-dismiss="modal">Huỷ</button>
                    <button type="submit" class="lr-btn-gold-sm">Lưu thay đổi</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Bottom Cards -->
<div class="profile-bottom-grid">
    <div class="bottom-card">
        <div class="bc-icon"><i class="fas fa-tag"></i></div>
        <h5>@tierName</h5>
        <p>
            Hiện có <strong>@points.ToString("N0")</strong> điểm@(tv != null && points >= tv.DiemDoiToiThieu ? $" — đổi được {points * tv.GiaTriMotDiem:N0} ₫ khi thanh toán" : "").
            @if (tv?.HangKeTiep != null)
            {
                <span>Còn @tv.DiemLenHang.ToString("N0") điểm để lên @tv.HangKeTiep.</span>
            }
        </p>
        @if (tv != null && tv.QuyenLoi.Any())
        {
            <ul class="small ps-3 mb-3" style="color:var(--lr-text-muted)">
                @foreach (var q in tv.QuyenLoi)
                {
                    <li>@q</li>
                }
            </ul>
        }
        <div class="membership-bar" style="background:#eee">
            <div class="membership-bar-fill" style="width:@(progress.ToString("0", System.Globalization.CultureInfo.InvariantCulture))%;background:var(--lr-gold); height:8px; border-radius:4px;"></div>
        </div>
        <div class="d-flex justify-content-between mt-2">
            <small class="text-muted">HIỆN TẠI</small>
            <small class="text-muted">@nextTier.ToUpper()</small>
        </div>
    </div>
    <div class="bottom-card">
        <div class="bc-label">Đặt phòng</div>
        <h5>Lên kế hoạch kỳ nghỉ mới</h5>
        <p>Xem phòng trống theo ngày và giá từng đêm trước khi đặt.</p>
        <a href="@Url.Action("BookRoom", "Customer")" class="bc-link">Đặt phòng ngay <i class="fas fa-arrow-right"></i></a>
    </div>
    <div class="bottom-card">
        <div class="bc-label">Kỳ nghỉ</div>
        <h5>Lịch sử &amp; hoá đơn</h5>
        <p>Theo dõi phiếu đặt, huỷ phiếu chưa nhận phòng và tải hoá đơn.</p>
        <a href="@Url.Action("MyStays", "Customer")" class="bc-link">Xem kỳ nghỉ của tôi <i class="fas fa-arrow-right"></i></a>
    </div>
</div>

@if (lichSuDiem.Any())
{
    <div class="lr-card mt-4">
        <h4>Lịch sử điểm</h4>
        <table class="table mb-0">
            <tbody>
                @foreach (var x in lichSuDiem.Take(10))
                {
                    <tr>
                        <td class="small text-muted" style="width:120px">@x.ThoiGian.ToString("dd/MM/yyyy")</td>
                        <td class="small">@x.Loai@(string.IsNullOrEmpty(x.NoiDung) ? "" : " — " + x.NoiDung)</td>
                        <td class="text-end fw-semibold @(x.SoDiem >= 0 ? "text-success" : "text-danger")">@(x.SoDiem > 0 ? "+" : "")@x.SoDiem.ToString("N0")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
