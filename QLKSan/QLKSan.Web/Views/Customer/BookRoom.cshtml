@model QLKSan.Models.Requests.BookRoomRequest
@using QLKSan.Models.DTOs
@{
    Layout = "_CustomerLayout";
    ViewData["Title"] = "Đặt phòng";
    var types = ViewBag.Types as List<RoomTypeAvailabilityDto> ?? new List<RoomTypeAvailabilityDto>();
    var selected = ViewBag.Selected as RoomTypeAvailabilityDto;
    var customer = ViewBag.Customer as CustomerDto;
    var hotel = ViewBag.Hotel as HotelInfoDto ?? new HotelInfoDto();
    var laKhach = User.IsLoggedIn() && User.GetRole() == "Customer";
    var soDem = (Model.CheckOut.Date - Model.CheckIn.Date).Days;
    var buoc = selected != null ? 3 : 2;

    // Liên kết giữ nguyên ngày / số khách đang tìm
    string BookUrl(string maLoai) => Url.Action("BookRoom", "Customer", new
    {
        checkIn = Model.CheckIn.ToString("yyyy-MM-dd"),
        checkOut = Model.CheckOut.ToString("yyyy-MM-dd"),
        soNguoi = Model.SoNguoi,
        maLoai
    });
    var lienHe = customer?.LienHeDiaChis?.FirstOrDefault();
    var gioNhan = hotel.GioNhanPhong ?? "14:00";
}

<div class="lx-page-head">
    <span class="lr-eyebrow">Đặt phòng trực tuyến</span>
    <h1>@(selected != null ? "Hoàn tất đặt phòng" : "Chọn hạng phòng")</h1>
    <p>Giá hiển thị là giá thực tế từng đêm theo ngày bạn chọn, chưa gồm VAT.</p>
</div>

<ol class="bk-steps">
    <li class="done"><span>01</span>Ngày lưu trú</li>
    <li class="@(buoc == 2 ? "active" : "done")"><span>02</span>Hạng phòng</li>
    <li class="@(buoc == 3 ? "active" : "")"><span>03</span>Xác nhận</li>
</ol>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger mb-4" role="alert">
        <i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
    </div>
}

<!-- BƯỚC 1: ngày lưu trú và số khách -->
<form class="bk-search" method="get" asp-action="BookRoom">
    <div class="lx-search-field">
        <label for="CheckIn">Ngày nhận phòng</label>
        <input type="date" id="CheckIn" name="checkIn" value="@Model.CheckIn.ToString("yyyy-MM-dd")" data-lr-date min="@DateTime.Today.ToString("yyyy-MM-dd")" />
    </div>
    <div class="lx-search-field">
        <label for="CheckOut">Ngày trả phòng</label>
        <input type="date" id="CheckOut" name="checkOut" value="@Model.CheckOut.ToString("yyyy-MM-dd")" data-lr-date data-lr-after="#CheckIn" min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" />
    </div>
    <div class="lx-search-field">
        <label for="SoNguoiSearch">Số khách</label>
        <select id="SoNguoiSearch" name="soNguoi">
            @for (var i = 1; i <= Math.Max(6, Model.SoNguoi); i++)
            {
                <option value="@i" selected="@(i == Model.SoNguoi)">@i khách</option>
            }
        </select>
    </div>
    <button type="submit" class="lr-btn lr-btn-primary">Tìm phòng</button>
</form>

@if (selected == null)
{
    <!-- BƯỚC 2: hạng phòng còn trống kèm tổng giá cho cả kỳ nghỉ -->
    <p class="bk-result">
        Còn trống từ <strong>@Model.CheckIn.ToString("dd/MM/yyyy")</strong> đến <strong>@Model.CheckOut.ToString("dd/MM/yyyy")</strong>
        · @soDem đêm · @Model.SoNguoi khách — <strong>@types.Count</strong> hạng phòng phù hợp
    </p>

    @if (!types.Any())
    {
        <div class="bk-card text-center">
            <h2>Không còn phòng phù hợp</h2>
            <p class="mb-0" style="color:var(--lr-text-muted)">
                Các hạng phòng đã kín trong khoảng ngày này hoặc không đủ sức chứa cho @Model.SoNguoi khách.
                Vui lòng chọn ngày khác@(string.IsNullOrEmpty(hotel.Hotline) ? "." : $" hoặc gọi {hotel.Hotline} để được hỗ trợ.")
            </p>
        </div>
    }

    @foreach (var t in types)
    {
        var lp = t.LoaiPhong;
        var q = t.BaoGia;
        <div class="bk-type">
            <div class="bk-type-img" style="background-image:url('@MediaUrl.Of(lp.AnhDaiDien)')" role="img" aria-label="@FormatHelper.TenHangPhong(lp.TenLoai)"></div>
            <div class="bk-type-body">
                <h3>@FormatHelper.TenHangPhong(lp.TenLoai)</h3>
                <div class="bk-facts">
                    @if (lp.DienTich != null)
                    {
                        <span><i class="fas fa-vector-square"></i>@lp.DienTich.Value.ToString("0.#") m²</span>
                    }
                    @if (!string.IsNullOrEmpty(lp.LoaiGiuong))
                    {
                        <span><i class="fas fa-bed"></i>@lp.LoaiGiuong</span>
                    }
                    @if (!string.IsNullOrEmpty(lp.HuongNhin))
                    {
                        <span><i class="fas fa-mountain-sun"></i>@lp.HuongNhin</span>
                    }
                    <span><i class="fas fa-user-group"></i>Tối đa @lp.SoNguoiToiDa khách</span>
                </div>
                <p>@lp.MoTa</p>
                @if (lp.DiemDanhGia != null)
                {
                    <div class="bk-rating"><i class="fas fa-star"></i> @lp.DiemDanhGia.Value.ToString("0.0") / 5 · @lp.SoDanhGia đánh giá</div>
                }
                @if (t.SoPhongTrong <= 2)
                {
                    <span class="bk-scarce">Chỉ còn @t.SoPhongTrong phòng cho ngày bạn chọn</span>
                }
            </div>
            <div class="bk-type-price">
                <div>
                    <small>Tổng @q.SoDem đêm</small>
                    <div class="bk-total">@FormatHelper.ToVND(q.TongTien)</div>
                    <small>@FormatHelper.ToVND(q.GiaTrungBinhDem) / đêm@(q.GiaTrungBinhDem != q.GiaGoc ? " (trung bình)" : "")</small>
                </div>
                <a href="@BookUrl(lp.MaLoai)" class="lr-btn lr-btn-primary">Chọn phòng này</a>
                <a asp-controller="Home" asp-action="RoomType" asp-route-id="@lp.MaLoai" class="lr-link">Xem chi tiết</a>
            </div>
        </div>
    }
}
else
{
    var lp = selected.LoaiPhong;
    var q = selected.BaoGia;
    <!-- BƯỚC 3: thông tin khách, yêu cầu riêng và xác nhận -->
    <div class="bk-layout">
        <div>
            @if (!laKhach)
            {
                <div class="bk-card">
                    <h2>Đăng nhập để hoàn tất</h2>
                    @if (User.IsLoggedIn())
                    {
                        <p class="mb-0" style="color:var(--lr-text-muted)">Tài khoản nhân viên không đặt phòng trực tuyến. Vui lòng dùng tài khoản khách hàng.</p>
                    }
                    else
                    {
                        <p style="color:var(--lr-text-muted)">Phòng và giá bạn chọn được giữ nguyên sau khi đăng nhập. Chưa có tài khoản? Đăng ký chỉ mất một phút.</p>
                        <div class="d-flex flex-wrap gap-3">
                            <a asp-controller="Auth" asp-action="Login" asp-route-returnUrl="@BookUrl(lp.MaLoai)" class="lr-btn lr-btn-primary">Đăng nhập</a>
                            <a asp-controller="Auth" asp-action="Register" class="lr-btn lr-btn-ghost">Tạo tài khoản</a>
                        </div>
                    }
                </div>
            }
            else
            {
                <form asp-action="BookRoom" method="post" id="bookRoomForm">
                    <input type="hidden" name="MaLoai" value="@lp.MaLoai" />
                    <input type="hidden" name="CheckIn" value="@Model.CheckIn.ToString("yyyy-MM-dd")" />
                    <input type="hidden" name="CheckOut" value="@Model.CheckOut.ToString("yyyy-MM-dd")" />
                    <input type="hidden" name="SoNguoi" value="@Model.SoNguoi" />

                    <div class="bk-card">
                        <h2>Thông tin khách</h2>
                        <div class="bk-guest">
                            <div><label>Họ tên</label><span>@customer?.HoTen</span></div>
                            <div><label>Điện thoại</label><span>@(lienHe?.SDT ?? "—")</span></div>
                            <div><label>Email</label><span>@(string.IsNullOrEmpty(lienHe?.Email) ? "—" : lienHe.Email)</span></div>
                        </div>
                        <a asp-action="Profile" class="lr-link mt-3 d-inline-block" style="font-size:0.78rem">Cập nhật thông tin liên hệ</a>
                    </div>

                    <div class="bk-card">
                        <h2>Yêu cầu riêng</h2>
                        <div class="mb-3">
                            <label asp-for="GioDenDuKien">Giờ đến dự kiến</label>
                            <select asp-for="GioDenDuKien" class="form-select">
                                <option value="">Chưa xác định</option>
                                <option value="Trước @gioNhan">Trước @gioNhan (nhận phòng sớm nếu phòng đã sẵn sàng)</option>
                                <option value="@gioNhan – 16:00">@gioNhan – 16:00</option>
                                <option value="16:00 – 18:00">16:00 – 18:00</option>
                                <option value="18:00 – 21:00">18:00 – 21:00</option>
                                <option value="Sau 21:00">Sau 21:00</option>
                            </select>
                        </div>
                        <div>
                            <label asp-for="YeuCauDacBiet">Lời nhắn cho khách sạn</label>
                            <textarea asp-for="YeuCauDacBiet" class="form-control" rows="3" maxlength="500"
                                      placeholder="Ví dụ: giường đôi, tầng cao, kỷ niệm ngày cưới, cần nôi cho em bé…"></textarea>
                            <span asp-validation-for="YeuCauDacBiet" class="text-danger small"></span>
                            <small class="d-block mt-1" style="color:var(--lr-text-muted)">Khách sạn sẽ cố gắng đáp ứng tuỳ tình trạng phòng thực tế.</small>
                        </div>
                    </div>

                    <div class="bk-card">
                        <h2>Mã ưu đãi</h2>
                        <div class="input-group">
                            <input type="text" asp-for="MaKhuyenMai" id="maKhuyenMai" class="form-control" placeholder="Nhập mã (nếu có)" />
                            <button type="button" class="lr-btn lr-btn-ghost" onclick="applyPromo()">Áp dụng</button>
                        </div>
                        <div id="promoMessage" class="form-text mt-2" style="display:none"></div>
                    </div>

                    <div class="bk-policy mb-4">
                        <strong>Nhận phòng</strong> từ @gioNhan · <strong>Trả phòng</strong> trước @(hotel.GioTraPhong ?? "12:00").<br />
                        @if (!string.IsNullOrEmpty(hotel.ChinhSachHuy))
                        {
                            <strong>Huỷ phòng:</strong> @hotel.ChinhSachHuy<br />
                        }
                        Thanh toán tại khách sạn khi trả phòng.
                    </div>

                    <button type="submit" class="lr-btn lr-btn-primary w-100">Xác nhận đặt phòng</button>
                </form>
            }
        </div>

        <aside class="bk-summary bk-summary-first">
            <div class="bk-summary-img" style="background-image:url('@MediaUrl.Of(lp.AnhDaiDien)')"></div>
            <div class="bk-summary-body">
                <span class="lr-eyebrow">Kỳ nghỉ của bạn</span>
                <h3>@FormatHelper.TenHangPhong(lp.TenLoai)</h3>
                <div class="bk-line"><span>Nhận phòng</span><span>@Model.CheckIn.ToString("dd/MM/yyyy") · @gioNhan</span></div>
                <div class="bk-line"><span>Trả phòng</span><span>@Model.CheckOut.ToString("dd/MM/yyyy") · @(hotel.GioTraPhong ?? "12:00")</span></div>
                <div class="bk-line"><span>Số khách</span><span>@Model.SoNguoi khách</span></div>
                <hr />
                @foreach (var dem in q.CacDem)
                {
                    <div class="bk-line night">
                        <span>Đêm @dem.Dem.ToString("dd/MM")<span class="bk-tag">@dem.QuyTac</span></span>
                        <span>@FormatHelper.ToVND(dem.Gia)</span>
                    </div>
                }
                <div class="bk-line" id="discountLine" style="display:none;color:#2e7d32"><span style="color:inherit">Ưu đãi</span><span id="discountValue"></span></div>
                <div class="bk-sum-total"><span>Tổng tiền phòng</span><strong id="totalValue">@FormatHelper.ToVND(q.TongTien)</strong></div>
                <p class="bk-note">Chưa gồm VAT và dịch vụ phát sinh trong kỳ nghỉ.</p>
                <a href="@BookUrl(null)" class="lr-link" style="font-size:0.78rem">Đổi hạng phòng</a>
            </div>
        </aside>
    </div>
}

@section Scripts {
    @if (selected != null && laKhach)
    {
        <script>
            // Mã ưu đãi chỉ để xem trước số tiền giảm; API áp dụng lại khi lập hoá đơn
            var tongGoc = @selected.BaoGia.TongTien.ToString(System.Globalization.CultureInfo.InvariantCulture);
            function vnd(n) { return Math.round(n).toLocaleString('vi-VN') + ' ₫'; }
            function applyPromo() {
                var code = document.getElementById('maKhuyenMai').value.trim();
                var msg = document.getElementById('promoMessage');
                var show = function (text, ok, giam) {
                    msg.textContent = text; msg.style.display = 'block'; msg.style.color = ok ? '#2e7d32' : '#b42318';
                    document.getElementById('discountLine').style.display = giam > 0 ? 'flex' : 'none';
                    document.getElementById('discountValue').textContent = '−' + vnd(giam);
                    document.getElementById('totalValue').textContent = vnd(tongGoc - giam);
                };
                if (!code) { show('Vui lòng nhập mã ưu đãi.', false, 0); return; }
                fetch('@Url.Action("CheckPromotion", "Customer")?code=' + encodeURIComponent(code))
                    .then(function (r) { return r.json(); })
                    .then(function (d) {
                        if (!d.success) { show(d.message, false, 0); return; }
                        var giam = d.loaiGiam === 'Phần trăm' ? tongGoc * d.giaTriGiam / 100 : d.giaTriGiam;
                        show(d.message, true, Math.min(giam, tongGoc));
                    })
                    .catch(function () { show('Không kiểm tra được mã, vui lòng thử lại.', false, 0); });
            }
        </script>
    }
}
