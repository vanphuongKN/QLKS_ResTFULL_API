@model QLKSan.Models.Requests.BookRoomRequest
@{
    Layout = "_CustomerLayout";
    ViewData["Title"] = "Đặt phòng trực tuyến";
    var availableRooms = ViewBag.AvailableRooms as IEnumerable<QLKSan.Models.DTOs.RoomDto>;
}
<div class="lr-section-label">Dịch vụ lưu trú</div>
<h2 class="lr-section-title" style="font-size:2rem">Đặt phòng trực tuyến</h2>
<p class="lr-section-desc mb-5">Chọn phòng lý tưởng, nhập ngày lưu trú và hoàn tất đặt phòng chỉ trong vài giây. Yêu cầu sẽ được xác nhận trong vòng 24 giờ.</p>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success mb-4" role="alert">
        <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger mb-4" role="alert">
        <i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
    </div>
}

<div class="row g-4">
    <!-- Booking Form -->
    <div class="col-lg-5">
        <div class="lr-card p-4">
            <h5 class="fw-bold mb-4"><i class="fas fa-calendar-check me-2 text-gold"></i>Thông tin đặt phòng</h5>
            <form asp-action="BookRoom" method="post" id="bookRoomForm">
                <div class="mb-4">
                    <label asp-for="MaPhong" class="form-label fw-semibold">Chọn phòng</label>
                    <select asp-for="MaPhong" id="roomSelect" class="form-select" onchange="updateRoomInfo(this)">
                        <option value="">-- Chọn phòng --</option>
                        @if (availableRooms != null)
                        {
                            foreach (var room in availableRooms)
                            {
                                <option value="@room.MaPhong"
                                        data-gia="@(room.GiaTrungBinhDem ?? room.LoaiPhong?.GiaThueNgay ?? 0)"
                                        data-loai="@(room.LoaiPhong?.TenLoai ?? "Standard")"
                                        data-so="@room.SoPhong"
                                        data-maxnguoi="@(room.LoaiPhong?.SoNguoiToiDa ?? 2)">
                                    Phòng @room.SoPhong — @(room.LoaiPhong?.TenLoai ?? "Standard") — @((room.GiaTrungBinhDem ?? room.LoaiPhong?.GiaThueNgay ?? 0).ToString("N0")) ₫/đêm
                                </option>
                            }
                        }
                    </select>
                    <span asp-validation-for="MaPhong" class="text-danger small"></span>
                </div>

                <div id="roomInfoBox" class="mb-4 p-3 rounded" style="background:rgba(197,160,89,0.08);border:1px solid rgba(197,160,89,0.2);display:none">
                    <div class="d-flex justify-content-between">
                        <span class="text-muted small">Loại phòng</span>
                        <span id="infoLoai" class="fw-semibold small"></span>
                    </div>
                    <div class="d-flex justify-content-between mt-1">
                        <span class="text-muted small">Giá / Đêm</span>
                        <span id="infoGia" class="fw-bold text-gold small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="SoNguoi" class="form-label fw-semibold">Số lượng khách</label>
                    <input asp-for="SoNguoi" id="soNguoi" class="form-control" min="1">
                    <span asp-validation-for="SoNguoi" class="text-danger small d-block"></span>
                    <small id="soNguoiHelp" class="text-muted d-none">Sức chứa tối đa: <span id="maxNguoiText" class="fw-bold text-danger"></span> người lớn.</small>
                </div>

                <div class="mb-3">
                    <label asp-for="CheckIn" class="form-label fw-semibold">Ngày Check-in</label>
                    <input type="date" asp-for="CheckIn" id="CheckIn" class="form-control" min="@DateTime.Today.ToString("yyyy-MM-dd")" onchange="calcTotal()">
                    <span asp-validation-for="CheckIn" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="CheckOut" class="form-label fw-semibold">Ngày Check-out</label>
                    <input type="date" asp-for="CheckOut" id="CheckOut" class="form-control" min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" onchange="calcTotal()">
                    <span asp-validation-for="CheckOut" class="text-danger small"></span>
                </div>
                <button type="button" class="btn w-100 mb-4" style="border:1px solid #0A192F;color:#0A192F;font-weight:600" onclick="checkAvailability()">
                    <i class="fas fa-search me-2"></i>Kiểm tra phòng trống theo ngày
                </button>

                <div class="mb-4">
                    <label asp-for="MaKhuyenMai" class="form-label fw-semibold">Mã khuyến mãi</label>
                    <div class="input-group">
                        <input type="text" asp-for="MaKhuyenMai" id="maKhuyenMai" class="form-control" placeholder="Nhập mã ưu đãi (nếu có)">
                        <button type="button" class="btn" style="border:1px solid #C5A059;color:#C5A059;font-weight:600" id="btnApplyPromo" onclick="applyPromo()">Áp dụng</button>
                    </div>
                    <div id="promoMessage" class="form-text mt-1 fw-medium" style="display:none;"></div>
                </div>

                <div id="totalBox" class="mb-4 p-3 rounded" style="background:#f8f8f8;display:none">
                    <div id="totalBoxContent">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-muted">Ước tính tổng tiền</span>
                            <span id="totalPrice" class="fw-bold text-gold fs-5"></span>
                        </div>
                    </div>
                    <small class="text-muted mt-2 d-block">* Có thể thay đổi theo dịch vụ phát sinh</small>
                </div>

                <button type="submit" class="btn-submit-feedback w-100" style="text-align:center;justify-content:center">
                    <i class="fas fa-check me-2"></i>Xác nhận đặt phòng
                </button>
            </form>
        </div>
    </div>

    <!-- Available Rooms Grid -->
    <div class="col-lg-7">
        <h5 class="fw-bold mb-3">Phòng trống từ @(Model?.CheckIn.ToString("dd/MM/yyyy")) đến @(Model?.CheckOut.ToString("dd/MM/yyyy")) (@(availableRooms?.Count() ?? 0) phòng)</h5>
        <div class="row g-3">
            @if (availableRooms != null && availableRooms.Any())
            {
                foreach (var room in availableRooms)
                {
                    var hasImage = room.HinhAnhs != null && room.HinhAnhs.Any() && !string.IsNullOrEmpty(room.HinhAnhs.FirstOrDefault()?.DuongDanAnh);
                    var imageUrl = "";
                    if (hasImage)
                    {
                        imageUrl = room.HinhAnhs.FirstOrDefault()?.DuongDanAnh;
                    }
                    else
                    {
                        var typeLower = room.LoaiPhong?.TenLoai?.ToLower() ?? "";
                        if (typeLower.Contains("presidential") || typeLower.Contains("vip") || typeLower.Contains("suite") || typeLower.Contains("sut"))
                        {
                            imageUrl = "/images/room_presidential.png";
                        }
                        else if (typeLower.Contains("deluxe") || typeLower.Contains("dlx") || typeLower.Contains("superior") || typeLower.Contains("sup") || typeLower.Contains("ocean"))
                        {
                            imageUrl = "/images/room_ocean.png";
                        }
                        else
                        {
                            imageUrl = "/images/room_garden.png";
                        }
                    }
                    
                    <div class="col-md-6">
                        <div class="lr-card p-3 h-100 d-flex flex-column justify-content-between" style="cursor:pointer" onclick="selectRoom('@room.MaPhong')">
                            <div>
                                <img src="@imageUrl" alt="Phòng @room.SoPhong" class="w-100 rounded mb-3" style="height: 140px; object-fit: cover; box-shadow: 0 4px 8px rgba(0,0,0,0.05);">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div>
                                        <span class="fw-bold">Phòng @room.SoPhong</span>
                                        <p class="text-muted small mb-0">@(room.LoaiPhong?.TenLoai ?? "Standard")</p>
                                    </div>
                                    <span class="badge-status badge-available" style="font-size:0.65rem">TRỐNG</span>
                                </div>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                                <span class="text-gold fw-bold">@((room.GiaTrungBinhDem ?? room.LoaiPhong?.GiaThueNgay ?? 0).ToString("N0")) ₫</span>
                                <span class="text-muted small">
                                    /đêm@(room.GiaTrungBinhDem != null && room.GiaTrungBinhDem != room.LoaiPhong?.GiaThueNgay ? ((Model.CheckOut - Model.CheckIn).Days > 1 ? " (trung bình)" : " (giá cuối tuần/lễ)") : "")
                                </span>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center p-5 text-muted">
                    <i class="fas fa-bed" style="font-size:3rem;opacity:0.3"></i>
                    <p class="mt-3">Hiện không có phòng trống nào.</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function selectRoom(maPhong) {
            document.getElementById('roomSelect').value = maPhong;
            updateRoomInfo(document.getElementById('roomSelect'));
        }

        function updateRoomInfo(sel) {
            var opt = sel.options[sel.selectedIndex];
            if (opt.value) {
                document.getElementById('infoLoai').textContent = opt.getAttribute('data-loai');
                document.getElementById('infoGia').textContent = parseInt(opt.getAttribute('data-gia')).toLocaleString('en-US') + ' ₫/đêm';
                
                var maxNguoi = opt.getAttribute('data-maxnguoi');
                var soNguoiInput = document.getElementById('soNguoi');
                soNguoiInput.max = maxNguoi;
                if (parseInt(soNguoiInput.value) > parseInt(maxNguoi)) {
                    soNguoiInput.value = maxNguoi;
                }
                document.getElementById('maxNguoiText').textContent = maxNguoi;
                document.getElementById('soNguoiHelp').classList.remove('d-none');

                document.getElementById('roomInfoBox').style.display = 'block';
                calcTotal();
            } else {
                document.getElementById('roomInfoBox').style.display = 'none';
                document.getElementById('totalBox').style.display = 'none';
                document.getElementById('soNguoiHelp').classList.add('d-none');
                document.getElementById('soNguoi').removeAttribute('max');
            }
        }

        var appliedPromo = null;

        // Tải lại danh sách phòng trống theo ngày nhận/trả và số khách đã chọn
        function checkAvailability() {
            var ci = document.getElementById('CheckIn').value;
            var co = document.getElementById('CheckOut').value;
            var guests = document.getElementById('soNguoi').value;
            if (!ci || !co) { alert('Vui lòng chọn ngày nhận và trả phòng.'); return; }
            var url = '@Url.Action("BookRoom", "Customer")' + '?checkIn=' + ci + '&checkOut=' + co + (guests ? '&soNguoi=' + guests : '');
            window.location.href = url;
        }

        function applyPromo() {
            var code = document.getElementById('maKhuyenMai').value.trim();
            var msgDiv = document.getElementById('promoMessage');
            if (!code) {
                msgDiv.style.color = '#dc3545';
                msgDiv.textContent = 'Vui lòng nhập mã khuyến mãi.';
                msgDiv.style.display = 'block';
                appliedPromo = null;
                calcTotal();
                return;
            }

            fetch('/Customer/CheckPromotion?code=' + encodeURIComponent(code))
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        msgDiv.style.color = '#2e7d32';
                        msgDiv.textContent = data.message;
                        msgDiv.style.display = 'block';
                        appliedPromo = data;
                        calcTotal();
                    } else {
                        msgDiv.style.color = '#dc3545';
                        msgDiv.textContent = data.message;
                        msgDiv.style.display = 'block';
                        appliedPromo = null;
                        calcTotal();
                    }
                })
                .catch(err => {
                    msgDiv.style.color = '#dc3545';
                    msgDiv.textContent = 'Lỗi kết nối khi áp dụng mã.';
                    msgDiv.style.display = 'block';
                    appliedPromo = null;
                    calcTotal();
                });
        }

        // Lấy giá từng đêm từ API (giá cuối tuần / lễ có thể khác giá niêm yết) rồi tính tổng
        var quoteSeq = 0;
        function calcTotal() {
            var sel = document.getElementById('roomSelect');
            var ci = document.getElementById('CheckIn').value;
            var co = document.getElementById('CheckOut').value;
            if (!sel.value || !ci || !co) return;
            var nights = Math.round((new Date(co) - new Date(ci)) / (1000 * 60 * 60 * 24));
            if (nights <= 0) return;
            var seq = ++quoteSeq;
            fetch('@Url.Action("Quote", "Customer")?maPhong=' + encodeURIComponent(sel.value) + '&checkIn=' + ci + '&checkOut=' + co)
                .then(res => res.json())
                .then(q => { if (seq === quoteSeq) renderTotal(q.success ? q : null, nights, sel); })
                .catch(() => { if (seq === quoteSeq) renderTotal(null, nights, sel); });
        }

        function renderTotal(quote, nights, sel) {
            var gia = parseInt(sel.options[sel.selectedIndex].getAttribute('data-gia'));
            var subtotal = quote ? quote.tongTien : nights * gia;
            if (quote) {
                document.getElementById('infoGia').textContent = quote.giaTrungBinh.toLocaleString('en-US') + ' ₫/đêm' + (quote.cacDem.some(d => d.quyTac) ? (quote.soDem > 1 ? ' (trung bình)' : ' (giá cuối tuần/lễ)') : '');
            }

            var discount = 0;
            if (appliedPromo) {
                if (appliedPromo.loaiGiam === 'Phần trăm') {
                    discount = subtotal * (appliedPromo.giaTriGiam / 100);
                } else {
                    discount = appliedPromo.giaTriGiam;
                }
                if (discount > subtotal) discount = subtotal;
            }

            var finalTotal = subtotal - discount;

            var html = '<div class="d-flex justify-content-between align-items-center mb-1">' +
                       '  <span class="text-muted">Tiền phòng (' + nights + ' đêm):</span>' +
                       '  <span class="fw-semibold">' + subtotal.toLocaleString('en-US') + ' ₫</span>' +
                       '</div>';

            // Liệt kê các đêm được điều chỉnh giá
            if (quote) {
                quote.cacDem.filter(d => d.quyTac).forEach(function (d) {
                    html += '<div class="d-flex justify-content-between small text-muted">' +
                            '  <span>· Đêm ' + d.dem + ' (' + d.quyTac + ')</span>' +
                            '  <span>' + d.gia.toLocaleString('en-US') + ' ₫</span>' +
                            '</div>';
                });
            }

            if (discount > 0) {
                html += '<div class="d-flex justify-content-between align-items-center mb-1 text-success">' +
                        '  <span>Giảm giá khuyến mãi:</span>' +
                        '  <span class="fw-semibold">-' + discount.toLocaleString('en-US') + ' ₫</span>' +
                        '</div>';
            }

            html += '<hr class="my-2">' +
                    '<div class="d-flex justify-content-between align-items-center">' +
                    '  <span class="text-muted fw-bold">Tổng tiền ước tính:</span>' +
                    '  <span id="totalPrice" class="fw-bold text-gold fs-5">' + finalTotal.toLocaleString('en-US') + ' ₫</span>' +
                    '</div>';

            document.getElementById('totalBoxContent').innerHTML = html;
            document.getElementById('totalBox').style.display = 'block';
        }

        document.getElementById('CheckIn').addEventListener('change', function() {
            var ciDate = new Date(this.value);
            if (!isNaN(ciDate)) {
                ciDate.setDate(ciDate.getDate() + 1);
                var minOut = ciDate.toISOString().split('T')[0];
                document.getElementById('CheckOut').min = minOut;
                var currentOut = document.getElementById('CheckOut').value;
                if (currentOut && new Date(currentOut) <= new Date(this.value)) {
                    document.getElementById('CheckOut').value = minOut;
                }
            }
        });
    </script>
}
