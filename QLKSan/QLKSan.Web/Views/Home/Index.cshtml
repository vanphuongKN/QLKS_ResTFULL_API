@using QLKSan.Models.DTOs
@{
    Layout = "_CustomerLayout";
    ViewData["Title"] = "Trang chủ";
    ViewData["HeaderOverlay"] = true;
    ViewData["FullWidth"] = true;
    var role = User.GetRole();
    var laKhach = User.IsLoggedIn() && role == "Customer";
    var hotel = ViewBag.Hotel as HotelInfoDto ?? new HotelInfoDto { Ten = "LUXE RESERVE" };
    var roomTypes = ViewBag.RoomTypes as List<RoomTypeDto> ?? new List<RoomTypeDto>();
    // "Trải nghiệm": dịch vụ được quản trị đánh dấu giới thiệu (không ghi bảng giá)
    var experiences = ViewBag.Experiences as List<ServiceDto> ?? new List<ServiceDto>();
    var reviews = ViewBag.Reviews as List<ReviewDto> ?? new List<ReviewDto>();
    var maxNguoi = roomTypes.Count > 0 ? roomTypes.Max(l => l.SoNguoiToiDa) : 4;
    // Xem phòng trống và giá không cần đăng nhập; bước xác nhận mới yêu cầu tài khoản khách hàng
    var bookUrl = Url.Action("BookRoom", "Customer");
}

<!-- HERO -->
<section class="lx-hero">
    <div class="lx-hero-inner">
        <span class="lr-eyebrow">Khách sạn &amp; khu nghỉ dưỡng</span>
        <h1>Nơi thời gian <em>chậm lại</em></h1>
        <p>@(string.IsNullOrWhiteSpace(hotel.MoTaNgan) ? "Không gian nghỉ dưỡng riêng tư, dịch vụ tận tâm và những buổi sáng thật thong thả." : hotel.MoTaNgan)</p>
        <div class="lx-hero-actions">
            @if (User.IsLoggedIn() && !laKhach)
            {
                <a href="@Url.Action("Portal", "Auth")" class="lr-btn lr-btn-light">Vào trang nhân viên</a>
            }
            else
            {
                <a href="@bookUrl" class="lr-btn lr-btn-light">Đặt phòng</a>
            }
            <a href="#rooms" class="lr-link lr-link-light">Khám phá hạng phòng</a>
        </div>
    </div>
</section>

<!-- TÌM PHÒNG: chuyển sang trang đặt phòng với khoảng ngày / số khách đã chọn -->
<form class="lx-search" method="get" action="@Url.Action("BookRoom", "Customer")" onsubmit="return handleBooking(event)">
    <input type="hidden" name="checkIn" id="checkin-date" value="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" />
    <input type="hidden" name="checkOut" id="checkout-date" value="@DateTime.Today.AddDays(3).ToString("yyyy-MM-dd")" />
    <div class="lx-search-field">
        <label for="stay-range">Nhận phòng — Trả phòng</label>
        <input type="text" id="stay-range" readonly value="@DateTime.Today.AddDays(1).ToString("dd/MM/yyyy") — @DateTime.Today.AddDays(3).ToString("dd/MM/yyyy")" />
    </div>
    <div class="lx-search-field">
        <label for="guest-count">Số khách</label>
        <select id="guest-count" name="soNguoi">
            @for (var i = 1; i <= maxNguoi; i++)
            {
                <option value="@i" selected="@(i == 2)">@i khách</option>
            }
        </select>
    </div>
    <button type="submit" class="lr-btn lr-btn-primary">Kiểm tra phòng trống</button>
</form>

<!-- GIỚI THIỆU -->
<section class="lx-section">
    <div class="lx-intro">
        <div>
            <span class="lr-eyebrow">Chào mừng đến @hotel.Ten</span>
            <h2>Một chốn nghỉ riêng tư, nơi mỗi chi tiết đều được chăm chút</h2>
            <p>Từ lúc đặt phòng đến khi trả phòng, đội ngũ của chúng tôi luôn sẵn sàng: phòng được chuẩn bị chu đáo trước giờ nhận, dịch vụ đặt nhanh qua lễ tân và hoá đơn minh bạch cho từng đêm lưu trú.</p>
            <div class="lx-facts">
                <div><strong>@roomTypes.Count</strong><span>Hạng phòng</span></div>
                <div><strong>24/7</strong><span>Lễ tân</span></div>
                @if (hotel.GioNhanPhong != null)
                {
                    <div><strong>@hotel.GioNhanPhong</strong><span>Giờ nhận phòng</span></div>
                }
            </div>
            <a href="#rooms" class="lr-link">Xem các hạng phòng</a>
        </div>
        <div class="lx-intro-img">
            <img src="/images/room_ocean.png" alt="Phòng nghỉ nhìn ra biển tại @hotel.Ten" />
        </div>
    </div>
</section>

<!-- HẠNG PHÒNG -->
<section class="lx-section" id="rooms">
    <div class="lx-section-head">
        <span class="lr-eyebrow">Lưu trú</span>
        <h2>Hạng phòng</h2>
        <p>Mỗi hạng phòng mang một nhịp nghỉ riêng — chọn không gian phù hợp với chuyến đi của bạn.</p>
    </div>
    @if (!roomTypes.Any())
    {
        <p class="text-center" style="color:var(--lr-text-muted)">Danh sách hạng phòng đang được cập nhật.</p>
    }
    <div class="lx-rooms">
        @foreach (var lp in roomTypes)
        {
            <a class="lx-room" asp-action="RoomType" asp-route-id="@lp.MaLoai">
                <div class="lx-room-img"><img src="@MediaUrl.Of(lp.AnhDaiDien)" alt="@FormatHelper.TenHangPhong(lp.TenLoai)" /></div>
                @if (lp.DiemDanhGia != null)
                {
                    <div class="lx-room-rating"><i class="fas fa-star"></i> @lp.DiemDanhGia.Value.ToString("0.0") · @lp.SoDanhGia đánh giá</div>
                }
                <h3>@FormatHelper.TenHangPhong(lp.TenLoai)</h3>
                <p>@(string.IsNullOrWhiteSpace(lp.MoTa) ? "Phòng nghỉ tiện nghi, yên tĩnh và được chuẩn bị chu đáo." : lp.MoTa)</p>
                <div class="lx-room-meta">
                    <span>Tối đa @lp.SoNguoiToiDa khách</span>
                    <span class="lx-room-price">Từ <strong>@lp.GiaThueNgay.ToString("N0") ₫</strong> / đêm</span>
                </div>
            </a>
        }
    </div>
</section>

@if (experiences.Any())
{
    <!-- TRẢI NGHIỆM -->
    <section class="lx-experience" id="experiences">
        <div class="lx-experience-inner">
            <div class="lx-experience-img" role="img" aria-label="Không gian nghỉ dưỡng"></div>
            <div class="lx-experience-text">
                <span class="lr-eyebrow">Trải nghiệm</span>
                <h2>Những điều làm nên một kỳ nghỉ trọn vẹn</h2>
                @for (var i = 0; i < experiences.Count; i++)
                {
                    <div class="lx-exp-item">
                        <span class="lx-exp-num">@((i + 1).ToString("00"))</span>
                        <h3>@experiences[i].TenDichVu</h3>
                        <p>@experiences[i].MoTa</p>
                    </div>
                }
            </div>
        </div>
    </section>
}

@if (reviews.Any())
{
    <!-- ĐÁNH GIÁ CỦA KHÁCH -->
    <section class="lx-section" id="reviews">
        <div class="lx-section-head">
            <span class="lr-eyebrow">Cảm nhận</span>
            <h2>Khách nói về chúng tôi</h2>
        </div>
        <div class="lx-reviews">
            @foreach (var r in reviews)
            {
                <figure class="lx-quote m-0">
                    @for (var i = 1; i <= 5; i++)
                    {
                        <i class="@(i <= r.SoSao ? "fas" : "far") fa-star"></i>
                    }
                    <blockquote>“@r.NoiDung”</blockquote>
                    <figcaption><small>@r.TenHienThi · @FormatHelper.TenHangPhong(r.TenLoaiPhong ?? "")</small></figcaption>
                </figure>
            }
        </div>
    </section>
}

<!-- LỜI MỜI ĐẶT PHÒNG -->
<section class="lx-cta">
    <span class="lr-eyebrow">Đặt phòng trực tuyến</span>
    <h2>Sẵn sàng cho kỳ nghỉ tiếp theo?</h2>
    <p>Chọn ngày, xem giá từng đêm và nhận xác nhận đặt phòng ngay trên website.</p>
    @if (!User.IsLoggedIn() || laKhach)
    {
        <a href="@bookUrl" class="lr-btn lr-btn-primary">Đặt phòng ngay</a>
    }
</section>

@section Scripts {
    <script>
        // Chọn khoảng ngày bằng một lịch duy nhất; giá trị gửi đi nằm ở 2 ô ẩn checkIn / checkOut
        (function () {
            if (!window.flatpickr) return;
            var ci = document.getElementById('checkin-date'), co = document.getElementById('checkout-date');
            flatpickr('#stay-range', {
                mode: 'range', minDate: 'today', dateFormat: 'd/m/Y', disableMobile: true,
                showMonths: window.innerWidth > 768 ? 2 : 1,
                defaultDate: [ci.value, co.value].map(function (v) { return new Date(v + 'T00:00:00'); }),
                locale: Object.assign({}, flatpickr.l10ns.vn || {}, { rangeSeparator: ' — ' }),
                onChange: function (dates) {
                    var fmt = function (d) { return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0'); };
                    if (dates.length === 2) { ci.value = fmt(dates[0]); co.value = fmt(dates[1]); }
                }
            });
        })();

        // Ai cũng xem được phòng trống và giá; tài khoản nhân viên không đặt phòng trực tuyến
        function handleBooking(event) {
            var ci = document.getElementById('checkin-date').value, co = document.getElementById('checkout-date').value;
            if (!ci || !co || co <= ci) {
                event.preventDefault();
                alert('Vui lòng chọn ngày trả phòng sau ngày nhận phòng.');
                return false;
            }
            if (@(User.IsLoggedIn() && !laKhach ? "true" : "false")) {
                event.preventDefault();
                alert('Tài khoản nhân viên không đặt phòng trực tuyến. Vui lòng dùng tài khoản khách hàng.');
                return false;
            }
            return true;
        }
    </script>
}
