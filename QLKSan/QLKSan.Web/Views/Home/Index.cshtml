@using QLKSan.Models.DTOs
@{
    Layout = "_CustomerLayout";
    ViewData["Title"] = "Trang chủ";
    var role = User.GetRole();
    var laKhach = User.IsLoggedIn() && role == "Customer";
    var roomTypes = ViewBag.RoomTypes as List<RoomTypeDto> ?? new List<RoomTypeDto>();
    var services = ViewBag.Services as List<ServiceDto> ?? new List<ServiceDto>();
    var maxNguoi = roomTypes.Count > 0 ? roomTypes.Max(l => l.SoNguoiToiDa) : 4;

    // Ảnh minh hoạ theo hạng phòng (CSDL chưa có ảnh riêng cho từng loại)
    string RoomImage(string tenLoai)
    {
        var t = (tenLoai ?? "").ToLower();
        if (t.Contains("suite") || t.Contains("tổng thống") || t.Contains("vip")) return "/images/room_presidential.png";
        if (t.Contains("deluxe") || t.Contains("superior")) return "/images/room_ocean.png";
        return "/images/room_garden.png";
    }
    string ServiceIcon(string ten)
    {
        var t = (ten ?? "").ToLower();
        if (t.Contains("spa") || t.Contains("massage")) return "fa-spa";
        if (t.Contains("ăn") || t.Contains("buffet")) return "fa-utensils";
        if (t.Contains("giặt")) return "fa-shirt";
        if (t.Contains("xe") || t.Contains("đưa đón") || t.Contains("sân bay")) return "fa-car";
        if (t.Contains("dọn")) return "fa-broom";
        return "fa-bell-concierge";
    }
}

<!-- Custom Styles for Luxury Aesthetics -->
<style>
    :root {
        --lux-navy: #0A192F;
        --lux-navy-light: #112240;
        --lux-gold: #C5A059;
        --lux-gold-hover: #D4AF37;
        --lux-white: #FFFFFF;
        --lux-dark-gray: #1E1E1E;
        --lux-light-bg: #FAF9F6; /* Premium alabaster warm white */
        --lux-transition: all 0.5s cubic-bezier(0.165, 0.84, 0.44, 1);
    }

    body {
        background-color: var(--lux-light-bg);
        font-family: 'Inter', sans-serif;
    }

    /* Hero Banner Area */
    .lux-hero {
        position: relative;
        background: linear-gradient(rgba(10, 25, 47, 0.85), rgba(2, 12, 27, 0.95)), url('/images/hero.png');
        background-size: cover;
        background-position: center;
        border-radius: 24px;
        padding: 100px 70px;
        margin-bottom: 30px;
        overflow: hidden;
        box-shadow: 0 25px 50px rgba(2, 12, 27, 0.25);
        color: var(--lux-white);
        display: flex;
        align-items: center;
        min-height: 520px;
        border: 1px solid rgba(197, 160, 89, 0.15);
    }

    .lux-hero::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        background: radial-gradient(circle at 80% 20%, rgba(197, 160, 89, 0.2) 0%, transparent 60%);
        pointer-events: none;
    }

    .lux-hero-content {
        max-width: 650px;
        z-index: 2;
        position: relative;
    }

    .lux-badge {
        display: inline-block;
        color: var(--lux-gold);
        text-transform: uppercase;
        font-size: 0.8rem;
        letter-spacing: 5px;
        font-weight: 700;
        margin-bottom: 25px;
        border-bottom: 2px solid var(--lux-gold);
        padding-bottom: 6px;
    }

    .lux-title {
        font-family: 'Playfair Display', serif;
        font-size: 3.8rem;
        font-weight: 700;
        line-height: 1.15;
        margin-bottom: 25px;
        color: var(--lux-white);
        text-shadow: 0 4px 15px rgba(0,0,0,0.4);
    }

    .lux-title span {
        color: var(--lux-gold);
        font-style: italic;
    }

    .lux-desc {
        color: rgba(255, 255, 255, 0.85);
        font-size: 1.1rem;
        line-height: 1.8;
        margin-bottom: 40px;
        font-weight: 300;
        text-shadow: 0 2px 5px rgba(0,0,0,0.3);
    }

    .lux-hero-img-wrap {
        position: absolute;
        right: 50px;
        top: 50px;
        bottom: 50px;
        width: 38%;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 20px 40px rgba(0,0,0,0.5);
        border: 2px solid var(--lux-gold);
        z-index: 1;
        display: none;
        transition: var(--lux-transition);
    }

    @@media (min-width: 1200px) {
        .lux-hero-img-wrap { display: block; }
        .lux-hero-content { max-width: 55%; }
    }

    .lux-hero-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transform: scale(1.02);
        transition: var(--lux-transition);
    }

    .lux-hero:hover .lux-hero-img-wrap {
        transform: translateY(-5px);
        box-shadow: 0 25px 50px rgba(197, 160, 89, 0.25);
    }

    .lux-hero-img-wrap:hover .lux-hero-img {
        transform: scale(1.08);
    }

    /* Floating Quick Booking Bar */
    .lux-booking-bar {
        background: var(--lux-white);
        border-radius: 16px;
        padding: 25px 35px;
        box-shadow: 0 20px 45px rgba(10, 25, 47, 0.08);
        border: 1px solid rgba(197, 160, 89, 0.25);
        margin-top: -45px;
        margin-bottom: 70px;
        position: relative;
        z-index: 10;
        transition: var(--lux-transition);
    }

    .lux-booking-bar:hover {
        box-shadow: 0 25px 55px rgba(197, 160, 89, 0.15);
        transform: translateY(-2px);
    }

    .booking-bar-form {
        display: grid;
        grid-template-columns: 1fr;
        gap: 20px;
        align-items: flex-end;
    }

    @@media (min-width: 992px) {
        .booking-bar-form {
            grid-template-columns: 1.1fr 1.1fr 1.3fr 0.9fr 1.2fr;
            gap: 24px;
        }
    }

    .booking-field {
        width: 100%;
    }

    .booking-field label {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        color: var(--lux-gold);
        margin-bottom: 8px;
        letter-spacing: 1.5px;
        white-space: nowrap;
    }

    .booking-field select, .booking-field input {
        width: 100%;
        border: none;
        border-bottom: 2px solid rgba(10, 25, 47, 0.1);
        padding: 10px 0;
        font-size: 0.95rem;
        color: var(--lux-navy);
        font-weight: 600;
        background: transparent;
        outline: none;
        transition: var(--lux-transition);
    }

    .booking-field select:focus, .booking-field input:focus {
        border-color: var(--lux-gold);
    }

    .booking-btn-wrap {
        width: 100%;
    }

    .booking-submit-btn {
        background: var(--lux-gold);
        color: var(--lux-navy);
        font-weight: 700;
        text-transform: uppercase;
        font-size: 0.8rem;
        letter-spacing: 1.5px;
        padding: 13px 20px;
        border-radius: 8px;
        border: none;
        width: 100%;
        transition: var(--lux-transition);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        box-shadow: 0 5px 15px rgba(197, 160, 89, 0.2);
        white-space: nowrap;
        margin-bottom: 2px;
    }

    .booking-submit-btn:hover {
        background: var(--lux-navy);
        color: var(--lux-white);
        box-shadow: 0 8px 20px rgba(10, 25, 47, 0.25);
    }

    /* Section Typography */
    .lux-section-header {
        text-align: center;
        margin-bottom: 60px;
        position: relative;
    }

    .lux-section-label {
        color: var(--lux-gold);
        text-transform: uppercase;
        font-size: 0.8rem;
        letter-spacing: 4px;
        font-weight: 700;
        margin-bottom: 12px;
        display: inline-block;
    }

    .lux-section-title {
        font-family: 'Playfair Display', serif;
        font-size: 2.8rem;
        font-weight: 700;
        color: var(--lux-navy);
        position: relative;
        padding-bottom: 20px;
        letter-spacing: 0.5px;
    }

    .lux-section-title::after {
        content: '';
        position: absolute;
        bottom: 0; left: 50%;
        transform: translateX(-50%);
        width: 70px; height: 3px;
        background-color: var(--lux-gold);
    }

    /* Grid of Services */
    .lux-services-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 25px;
        margin-bottom: 80px;
    }

    @@media (min-width: 576px) {
        .lux-services-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (min-width: 992px) {
        .lux-services-grid {
            grid-template-columns: repeat(4, 1fr);
        }
    }

    .lux-service-item {
        background: var(--lux-white);
        border-radius: 16px;
        padding: 35px 30px;
        text-align: center;
        box-shadow: 0 10px 30px rgba(0,0,0,0.02);
        border: 1px solid rgba(0,0,0,0.03);
        transition: var(--lux-transition);
        position: relative;
    }

    .lux-service-item::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0; height: 4px;
        background: var(--lux-gold);
        border-radius: 16px 16px 0 0;
        opacity: 0;
        transition: var(--lux-transition);
    }

    .lux-service-item:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 40px rgba(10, 25, 47, 0.08);
        border-color: rgba(197,160,89,0.15);
    }

    .lux-service-item:hover::before {
        opacity: 1;
    }

    .lux-service-icon {
        font-size: 2.2rem;
        color: var(--lux-gold);
        margin-bottom: 20px;
        transition: var(--lux-transition);
    }

    .lux-service-item:hover .lux-service-icon {
        transform: scale(1.1) rotate(5deg);
    }

    .lux-service-title {
        font-family: 'Playfair Display', serif;
        font-size: 1.2rem;
        font-weight: 700;
        color: var(--lux-navy);
        margin-bottom: 12px;
    }

    .lux-service-desc {
        font-size: 0.85rem;
        color: #666;
        line-height: 1.6;
    }

    /* Luxury Room Grid */
    .lux-room-card {
        background: var(--lux-white);
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,0.03);
        border: 1px solid rgba(0, 0, 0, 0.04);
        transition: var(--lux-transition);
        margin-bottom: 40px;
        position: relative;
    }

    .lux-room-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 25px 50px rgba(10, 25, 47, 0.12);
        border-color: rgba(197, 160, 89, 0.25);
    }

    .lux-room-img-container {
        height: 280px;
        overflow: hidden;
        position: relative;
    }

    .lux-room-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: var(--lux-transition);
    }

    .lux-room-card:hover .lux-room-img {
        transform: scale(1.08);
    }

    .lux-room-tag {
        position: absolute;
        top: 20px; right: 20px;
        background: rgba(10, 25, 47, 0.9);
        backdrop-filter: blur(5px);
        color: var(--lux-gold);
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 2px;
        padding: 8px 16px;
        border-radius: 6px;
        border: 1px solid rgba(197, 160, 89, 0.4);
        z-index: 2;
    }

    .lux-room-body {
        padding: 30px;
    }

    .lux-room-stars {
        color: var(--lux-gold);
        font-size: 0.85rem;
        letter-spacing: 2px;
        margin-bottom: 10px;
    }

    .lux-room-title {
        font-family: 'Playfair Display', serif;
        font-size: 1.45rem;
        font-weight: 700;
        color: var(--lux-navy);
        margin-bottom: 12px;
    }

    .lux-room-desc {
        font-size: 0.9rem;
        color: #555;
        line-height: 1.7;
        margin-bottom: 22px;
        height: 70px;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .lux-room-details {
        display: flex;
        gap: 15px;
        margin-bottom: 20px;
        font-size: 0.75rem;
        color: #777;
        border-bottom: 1px solid rgba(0, 0, 0, 0.05);
        padding-bottom: 15px;
    }

    .lux-room-details span {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .lux-room-details i {
        color: var(--lux-gold);
    }

    .lux-room-meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .lux-room-price {
        font-size: 1.3rem;
        font-weight: 700;
        color: var(--lux-gold);
    }

    .lux-room-price span {
        font-size: 0.8rem;
        color: #888;
        font-weight: 400;
        text-transform: uppercase;
    }

    .btn-lux-book {
        background: transparent;
        color: var(--lux-navy);
        border: 1px solid var(--lux-navy);
        border-radius: 6px;
        padding: 8px 16px;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        text-decoration: none;
        transition: var(--lux-transition);
    }

    .lux-room-card:hover .btn-lux-book {
        background: var(--lux-gold);
        border-color: var(--lux-gold);
        color: var(--lux-navy);
        box-shadow: 0 4px 12px rgba(197, 160, 89, 0.3);
    }

    /* Call to Action Button */
    .btn-lux-primary {
        background: var(--lux-gold);
        color: var(--lux-navy) !important;
        font-weight: 700;
        text-transform: uppercase;
        font-size: 0.85rem;
        letter-spacing: 2px;
        padding: 16px 36px;
        border-radius: 8px;
        border: none;
        box-shadow: 0 8px 25px rgba(197, 160, 89, 0.3);
        transition: var(--lux-transition);
        display: inline-block;
        text-decoration: none;
    }

    .btn-lux-primary:hover {
        background: var(--lux-gold-hover);
        transform: translateY(-2px);
        box-shadow: 0 12px 30px rgba(197, 160, 89, 0.45);
    }

    .btn-lux-secondary {
        background: transparent;
        color: var(--lux-white) !important;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.85rem;
        letter-spacing: 2px;
        padding: 16px 36px;
        border-radius: 8px;
        border: 1px solid rgba(255, 255, 255, 0.4);
        transition: var(--lux-transition);
        display: inline-block;
        text-decoration: none;
        margin-left: 15px;
    }

    .btn-lux-secondary:hover {
        border-color: var(--lux-white);
        background: rgba(255,255,255,0.08);
    }

    .lux-actions { display: flex; flex-wrap: wrap; gap: 15px; }
    /* Số dịch vụ thay đổi theo dữ liệu: chia đều cột thay vì cố định 4 cột (tránh ô lẻ một mình) */
    @@media (min-width: 992px) {
        .lux-services-grid { grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); }
    }
    .btn-lux-secondary { margin-left: 0; }
    .lux-room-meta { gap: 12px; flex-wrap: wrap; }
    .lux-room-price { white-space: nowrap; }
    .btn-lux-book { white-space: nowrap; }
    .lux-empty { text-align: center; color: #888; padding: 30px 0 60px; }

    @@media (max-width: 991.98px) {
        .lux-hero { padding: 60px 40px; min-height: 0; }
        .lux-title { font-size: 2.8rem; }
        .lux-section-title { font-size: 2.2rem; }
    }
    @@media (max-width: 575.98px) {
        .lux-hero { padding: 40px 22px 70px; border-radius: 16px; }
        .lux-badge { letter-spacing: 3px; font-size: 0.7rem; margin-bottom: 18px; }
        .lux-title { font-size: 2.05rem; margin-bottom: 16px; }
        .lux-desc { font-size: 0.95rem; line-height: 1.7; margin-bottom: 28px; }
        .btn-lux-primary, .btn-lux-secondary { width: 100%; text-align: center; padding: 14px 20px; letter-spacing: 1.5px; }
        .lux-booking-bar { padding: 20px; margin-bottom: 50px; }
        .lux-section-header { margin-bottom: 36px; }
        .lux-section-label { letter-spacing: 3px; font-size: 0.7rem; }
        .lux-section-title { font-size: 1.75rem; }
        .lux-services-grid { margin-bottom: 50px; grid-template-columns: repeat(2, 1fr); gap: 14px; }
        .lux-service-item { padding: 22px 14px; }
        .lux-service-icon { font-size: 1.7rem; margin-bottom: 12px; }
        .lux-service-title { font-size: 1rem; }
        .lux-room-img-container { height: 210px; }
        .lux-room-body { padding: 22px; }
    }
</style>

<!-- HERO WELCOME SECTION -->
<div class="lux-hero">
    <div class="lux-hero-content">
        <div class="lux-badge">LUXE RESERVE</div>
        <h1 class="lux-title">Định Nghĩa Lại <span>Đẳng Cấp</span> Nghỉ Dưỡng</h1>
        <p class="lux-desc">Không gian nghỉ dưỡng sang trọng, đặt phòng trực tuyến nhanh chóng và dịch vụ tận tâm suốt kỳ nghỉ của bạn.</p>

        <div class="lux-actions">
            @if (laKhach)
            {
                <a href="@Url.Action("BookRoom", "Customer")" class="btn-lux-primary"><i class="fas fa-calendar-check me-2"></i>Đặt phòng ngay</a>
                <a href="@Url.Action("MyStays", "Customer")" class="btn-lux-secondary">Kỳ nghỉ của tôi</a>
            }
            else if (User.IsLoggedIn())
            {
                <a href="@Url.Action("Portal", "Auth")" class="btn-lux-primary"><i class="fas fa-briefcase me-2"></i>Vào trang nhân viên</a>
                <a href="#accommodation-section" class="btn-lux-secondary">Xem hạng phòng</a>
            }
            else
            {
                <a href="@Url.Action("Register", "Auth")" class="btn-lux-primary"><i class="fas fa-user-plus me-2"></i>Đăng ký đặt phòng</a>
                <a href="#accommodation-section" class="btn-lux-secondary">Xem hạng phòng</a>
            }
        </div>
    </div>
    <div class="lux-hero-img-wrap">
        <img class="lux-hero-img" src="/images/hero.png" alt="Sảnh khách sạn LUXE RESERVE">
    </div>
</div>

<!-- TÌM PHÒNG TRỐNG: chuyển sang trang đặt phòng với ngày / số khách đã chọn -->
<div class="lux-booking-bar">
    <form class="booking-bar-form" method="get" action="@Url.Action("BookRoom", "Customer")" onsubmit="return handleBooking(event)">
        <div class="booking-field">
            <label for="checkin-date"><i class="fas fa-calendar-alt"></i> Ngày nhận phòng</label>
            <input type="date" id="checkin-date" name="checkIn" min="@DateTime.Today.ToString("yyyy-MM-dd")" value="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" required>
        </div>
        <div class="booking-field">
            <label for="checkout-date"><i class="fas fa-calendar-check"></i> Ngày trả phòng</label>
            <input type="date" id="checkout-date" name="checkOut" min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" value="@DateTime.Today.AddDays(3).ToString("yyyy-MM-dd")" required>
        </div>
        <div class="booking-field">
            <label for="room-type"><i class="fas fa-bed"></i> Hạng phòng</label>
            <select id="room-type">
                <option value="">Tất cả hạng phòng</option>
                @foreach (var lp in roomTypes)
                {
                    <option value="@lp.MaLoai">@lp.TenLoai</option>
                }
            </select>
        </div>
        <div class="booking-field">
            <label for="guest-count"><i class="fas fa-users"></i> Số khách</label>
            <select id="guest-count" name="soNguoi">
                @for (var i = 1; i <= maxNguoi; i++)
                {
                    <option value="@i" selected="@(i == 2)">@i khách</option>
                }
            </select>
        </div>
        <div class="booking-btn-wrap">
            <button type="submit" class="booking-submit-btn">
                Tìm phòng trống <i class="fas fa-chevron-right"></i>
            </button>
        </div>
    </form>
</div>

<script>
    // Khách chưa đăng nhập: chuyển tới đăng nhập, xong quay lại trang đặt phòng với ngày đã chọn
    function handleBooking(event) {
        var form = document.querySelector('.booking-bar-form');
        var ci = document.getElementById('checkin-date').value, co = document.getElementById('checkout-date').value;
        if (ci && co && co <= ci) {
            event.preventDefault();
            alert('Ngày trả phòng phải sau ngày nhận phòng.');
            return false;
        }
        var laKhach = @(laKhach ? "true" : "false"), daDangNhap = @(User.IsLoggedIn() ? "true" : "false");
        if (laKhach) return true;
        event.preventDefault();
        if (daDangNhap) {
            alert('Tài khoản nhân viên không đặt phòng trực tuyến. Vui lòng dùng tài khoản khách hàng.');
            return false;
        }
        var target = '@Url.Action("BookRoom", "Customer")?' + new URLSearchParams(new FormData(form)).toString();
        window.location.href = '@Url.Action("Login", "Auth")?returnUrl=' + encodeURIComponent(target);
        return false;
    }
</script>

@if (services.Any())
{
    <!-- DỊCH VỤ CỦA KHÁCH SẠN (dữ liệu thật) -->
    <div id="services-section" class="lux-section-header">
        <div class="lux-section-label">Tiện nghi &amp; dịch vụ</div>
        <h2 class="lux-section-title">Dịch Vụ Trong Kỳ Nghỉ</h2>
    </div>

    <div class="lux-services-grid">
        @foreach (var dv in services.Take(8))
        {
            <div class="lux-service-item">
                <div class="lux-service-icon"><i class="fas @ServiceIcon(dv.TenDichVu)"></i></div>
                <h5 class="lux-service-title">@dv.TenDichVu</h5>
                <p class="lux-service-desc">@dv.GiaDichVu.ToString("N0") ₫ / @dv.DonViTinh</p>
            </div>
        }
    </div>
}

<!-- HẠNG PHÒNG (dữ liệu thật) -->
<div id="accommodation-section" class="lux-section-header">
    <div class="lux-section-label">Không gian nghỉ dưỡng</div>
    <h2 class="lux-section-title">Hạng Phòng</h2>
</div>

@if (!roomTypes.Any())
{
    <p class="lux-empty">Danh sách hạng phòng đang được cập nhật.</p>
}
<div class="row">
    @foreach (var lp in roomTypes)
    {
        <div class="col-md-6 col-lg-4">
            <div class="lux-room-card">
                <div class="lux-room-img-container">
                    <span class="lux-room-tag">@lp.MaLoai</span>
                    <img class="lux-room-img" src="@RoomImage(lp.TenLoai)" alt="Phòng @lp.TenLoai">
                </div>
                <div class="lux-room-body">
                    <h4 class="lux-room-title">@lp.TenLoai</h4>
                    <p class="lux-room-desc">@(string.IsNullOrWhiteSpace(lp.MoTa) ? "Phòng nghỉ tiện nghi, sạch sẽ và yên tĩnh." : lp.MoTa)</p>
                    <div class="lux-room-details">
                        <span><i class="fas fa-user-friends"></i> Tối đa @lp.SoNguoiToiDa khách</span>
                        <span><i class="fas fa-clock"></i> @lp.GiaThueGio.ToString("N0") ₫/giờ</span>
                    </div>
                    <div class="lux-room-meta">
                        <span class="lux-room-price">@lp.GiaThueNgay.ToString("N0") ₫ <span>/ đêm</span></span>
                        <a href="@(laKhach ? Url.Action("BookRoom", "Customer") : Url.Action("Login", "Auth", new { returnUrl = Url.Action("BookRoom", "Customer") }))" class="btn-lux-book">Đặt phòng</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
