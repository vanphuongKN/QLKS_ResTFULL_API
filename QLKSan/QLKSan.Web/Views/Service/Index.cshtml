@{
    ViewData["Title"] = "Quản lý Dịch vụ";
    var services = ViewBag.Services as IEnumerable<QLKSan.Models.DTOs.ServiceDto>;
    var activeStays = ViewBag.ActiveStays as IEnumerable<QLKSan.Models.DTOs.BookingDto>;
}

<div class="page-header">
    <div>
        <p class="page-label">Lễ tân</p>
        <h2>Quản lý Dịch vụ</h2>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success mb-3">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger mb-3">@TempData["ErrorMessage"]</div>
}

<div class="row g-4">
    <!-- CỘT TRÁI: Form đặt dịch vụ -->
    <div class="col-lg-4">
        <form asp-action="OrderService" method="post" id="orderServiceForm">
            <div class="card p-4 mb-4">
                <h6 class="ledger-label mb-4" style="color:var(--gold);letter-spacing:1px;font-weight:600">CHỈ ĐỊNH DỊCH VỤ</h6>
                
                <input type="hidden" name="maDichVu" id="selectedServiceId" required />
                
                <div class="mb-4">
                    <label class="form-label-upper" style="font-size:0.7rem;color:#888;letter-spacing:0.5px">CHỌN PHÒNG</label>
                    <select class="form-select form-control-lg-custom" name="maPhong" id="selectedRoom" required onchange="onRoomChange(this)">
                        <option value="">-- Chọn phòng --</option>
                        @if (activeStays != null)
                        {
                            foreach (var stay in activeStays)
                            {
                                var room = stay.ChiTietDatPhongs.FirstOrDefault()?.Phong;
                                var roomName = room != null ? $"Phòng {room.SoPhong} - {room.LoaiPhong?.TenLoai}" : "Phòng N/A";
                                var customerName = stay.KhachHang != null ? $"{stay.KhachHang.Ho} {stay.KhachHang.Ten}" : "Khách vãng lai";
                                
                                // Calculate previous balance
                                decimal roomTotal = room?.LoaiPhong?.GiaThueNgay ?? 0; // simplified
                                decimal servicesTotal = stay.SuDungDichVus?.Sum(s => s.ThanhTien) ?? 0;
                                decimal prevBalance = roomTotal + servicesTotal - stay.TienCoc;

                                <option value="@room?.MaPhong" 
                                        data-customer="@customerName" 
                                        data-balance="@prevBalance"
                                        data-booking="@stay.MaDatPhong">
                                    @roomName
                                </option>
                            }
                        }
                    </select>
                </div>
                
                <div class="mb-4">
                    <label class="form-label-upper" style="font-size:0.7rem;color:#888;letter-spacing:0.5px">TÊN KHÁCH HÀNG</label>
                    <input type="text" id="customerNameInput" class="form-control form-control-lg-custom bg-light" readonly placeholder="Chọn phòng để xem..." />
                </div>
                
                <div class="mb-4">
                    <label class="form-label-upper" style="font-size:0.7rem;color:#888;letter-spacing:0.5px">DANH SÁCH DỊCH VỤ ĐÃ CHỌN</label>
                    <div id="cartContainer" class="d-flex flex-column gap-2" style="max-height: 250px; overflow-y: auto;">
                        <div id="emptyCartMessage" class="p-3 text-center text-muted" style="background:#fdfcf8; border:1px solid #eaddc4; border-radius:4px; font-size: 0.85rem;">
                            Chưa chọn dịch vụ nào. Hãy bấm nút <i class="fas fa-plus-circle text-gold"></i> ở danh sách bên phải.
                        </div>
                    </div>
                </div>

                <div id="hiddenCartInputs"></div>
                
                <button type="submit" class="btn btn-outline-gold w-100 py-3 fw-bold" id="btnSubmit" disabled style="letter-spacing:1px">XÁC NHẬN SỬ DỤNG DỊCH VỤ</button>
            </div>

            <!-- Tóm tắt phí dịch vụ -->
            <div class="card p-4">
                <h6 class="fw-bold text-navy mb-4">Tóm tắt phí dịch vụ</h6>
                
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="fw-bold text-navy">Tổng phí dịch vụ mới</span>
                    <strong class="text-gold fs-4" id="newServiceFeeDisplay">0 ₫</strong>
                </div>

            </div>
        </form>
    </div>

    <!-- CỘT PHẢI: Catalog và Lịch sử -->
    <div class="col-lg-8">
        <!-- Danh mục dịch vụ -->
        <div class="card p-0 mb-4">
            <div class="d-flex justify-content-between align-items-center p-4 border-bottom">
                <h6 class="fw-bold mb-0" style="letter-spacing:1px">DỊCH VỤ HIỆN CÓ</h6>
                <div class="d-flex gap-3">
                    <a href="#" class="text-decoration-none text-white px-3 py-1 rounded" style="background:#C5A059;font-size:0.8rem">Tất cả</a>
                    <a href="#" class="text-decoration-none text-muted" style="font-size:0.8rem">Ẩm thực</a>
                    <a href="#" class="text-decoration-none text-muted" style="font-size:0.8rem">Sức khỏe</a>
                    <a href="#" class="text-decoration-none text-muted" style="font-size:0.8rem">Vận chuyển</a>
                </div>
            </div>
            
            <div class="table-responsive">
                <table class="table align-middle mb-0" style="border-collapse: separate; border-spacing: 0;">
                    <thead style="background:#fafafa">
                        <tr>
                            <th class="text-muted small fw-normal py-3 ps-4" style="font-size:0.7rem;letter-spacing:0.5px">TÊN DỊCH VỤ</th>
                            <th class="text-muted small fw-normal py-3" style="font-size:0.7rem;letter-spacing:0.5px">DANH MỤC</th>
                            <th class="text-muted small fw-normal py-3" style="font-size:0.7rem;letter-spacing:0.5px">ĐƠN GIÁ</th>
                            <th class="text-muted small fw-normal py-3" style="font-size:0.7rem;letter-spacing:0.5px">TRẠNG THÁI</th>

                            <th class="py-3 pe-4"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (services != null && services.Any())
                        {
                            foreach (var s in services)
                            {
                                var iconClass = "fa-concierge-bell";
                                var category = "Dịch vụ chung";
                                var lowerName = s.TenDichVu.ToLower();
                                if (lowerName.Contains("rượu") || lowerName.Contains("bữa") || lowerName.Contains("nước")) { iconClass = "fa-wine-glass-alt"; category = "Ẩm thực"; }
                                else if (lowerName.Contains("massage") || lowerName.Contains("yoga") || lowerName.Contains("spa")) { iconClass = "fa-spa"; category = "Sức khỏe"; }
                                else if (lowerName.Contains("đưa đón") || lowerName.Contains("xe")) { iconClass = "fa-car"; category = "Vận chuyển"; }
                                else if (lowerName.Contains("giặt") || lowerName.Contains("ủi")) { iconClass = "fa-tshirt"; category = "Giặt là"; }

                                <tr>
                                    <td class="ps-4 py-3">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="d-flex justify-content-center align-items-center rounded" style="width:40px;height:40px;background:#f5eedc">
                                                <i class="fas @iconClass" style="color:#C5A059"></i>
                                            </div>
                                            <div>
                                                <strong class="d-block text-navy" style="font-size:0.95rem">@s.TenDichVu</strong>
                                                <small class="text-muted" style="font-size:0.7rem">Đơn vị: @s.DonViTinh</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-muted" style="font-size:0.9rem">@category</td>
                                    <td><strong class="text-navy">@s.GiaDichVu.ToString("N0") ₫</strong></td>

                                    <td>
                                        @if(s.TrangThai == QLKSan.Enums.ServiceStatus.Available)
                                        {
                                            <span class="badge border text-gold px-2 py-1 bg-white" style="border-color:#eaddc4!important;font-weight:600;letter-spacing:0.5px">SẴN SÀNG</span>
                                        }
                                        else
                                        {
                                            <span class="badge border text-secondary px-2 py-1 bg-white" style="border-color:#ccc!important;font-weight:600;letter-spacing:0.5px">ĐÃ HẾT</span>
                                        }
                                    </td>
                                    <td class="pe-4 text-end">
                                        @if(s.TrangThai == QLKSan.Enums.ServiceStatus.Available)
                                        {
                                            <button type="button" class="btn btn-link text-muted p-0" onclick="addToCart('@s.MaDichVu', '@s.TenDichVu', @s.GiaDichVu)">
                                                <i class="fas fa-plus-circle" style="font-size:1.5rem;color:#ccc;transition:color 0.2s"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-link text-muted p-0" disabled>
                                                <i class="fas fa-plus-circle" style="font-size:1.5rem;color:#f0f0f0;"></i>
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            
            <div class="p-3 border-top d-flex justify-content-between align-items-center text-muted small">
                <span>@(services?.Count() ?? 0) dịch vụ</span>
            </div>
        </div>

        <!-- Dịch vụ đã gọi của khách đang ở: lọc theo phòng đang chọn, huỷ dịch vụ gọi nhầm -->
        @{
            var daGoi = (activeStays ?? Enumerable.Empty<QLKSan.Models.DTOs.BookingDto>())
                .SelectMany(st => (st.SuDungDichVus ?? new List<QLKSan.Models.DTOs.ServiceUsageDto>())
                    .Select(s => (Usage: s, Stay: st, Phong: st.ChiTietDatPhongs?.FirstOrDefault()?.Phong)))
                .OrderByDescending(x => x.Usage.NgaySuDung).ToList();
        }
        <div class="d-flex justify-content-between align-items-baseline mb-3">
            <h6 class="fw-bold mb-0" style="letter-spacing:1px;color:#555">DỊCH VỤ ĐÃ GỌI</h6>
            <small class="text-muted" id="usedInfo">@daGoi.Count dòng</small>
        </div>
        <div class="card">
            @if (!daGoi.Any())
            {
                <p class="text-muted small p-4 mb-0 text-center">Khách đang ở chưa gọi dịch vụ nào.</p>
            }
            else
            {
                <table class="table table-custom mb-0" data-no-tools id="usedTable">
                    <thead><tr><th>Phòng</th><th>Dịch vụ</th><th class="text-center">SL</th><th>Thời gian</th><th class="text-end">Thành tiền</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var x in daGoi)
                        {
                            <tr data-room="@x.Phong?.MaPhong">
                                <td class="fw-bold">@x.Phong?.SoPhong</td>
                                <td>@(x.Usage.TenDichVu ?? x.Usage.MaDichVu)</td>
                                <td class="text-center">@x.Usage.SoLuong</td>
                                <td class="small text-muted">@x.Usage.NgaySuDung.ToString("HH:mm dd/MM")</td>
                                <td class="text-end fw-semibold">@x.Usage.ThanhTien.ToString("N0") ₫</td>
                                <td class="text-end">
                                    <button type="button" class="btn btn-sm btn-outline-danger" data-void data-dp="@x.Stay.MaDatPhong" data-sd="@x.Usage.MaSDDV"
                                            data-ten="@(x.Usage.TenDichVu ?? x.Usage.MaDichVu)" data-sl="@x.Usage.SoLuong" data-room="@x.Phong?.MaPhong" title="Huỷ dịch vụ gọi nhầm">Huỷ</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <div class="modal fade" id="voidModal" tabindex="-1" aria-labelledby="voidTitle">
            <div class="modal-dialog">
                <form asp-action="VoidService" method="post" class="modal-content">
                    <div class="modal-header"><h5 class="modal-title fw-bold" id="voidTitle">Huỷ dịch vụ gọi nhầm</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div>
                    <div class="modal-body">
                        <input type="hidden" name="maDatPhong" id="vdDp" /><input type="hidden" name="maSDDV" id="vdSd" /><input type="hidden" name="maPhong" id="vdRoom" />
                        <p id="vdTen" class="fw-semibold mb-3"></p>
                        <div class="row g-3">
                            <div class="col-4"><label class="form-label fw-semibold" for="vdSl">Số lượng huỷ</label><input type="number" name="soLuong" id="vdSl" class="form-control" min="1" value="1" required /></div>
                            <div class="col-8"><label class="form-label fw-semibold" for="vdLyDo">Lý do</label><input name="lyDo" id="vdLyDo" class="form-control" maxlength="200" required placeholder="VD: Nhập nhầm phòng" /></div>
                        </div>
                        <small class="text-muted d-block mt-2">Chỉ huỷ được trước khi hoá đơn thanh toán; lý do được ghi vào phiếu và nhật ký thao tác.</small>
                    </div>
                    <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Đóng</button><button type="submit" class="btn btn-danger">Huỷ dịch vụ</button></div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var previousBalance = 0;
        var cart = [];

        function addToCart(id, name, price) {
            var item = cart.find(x => x.id === id);
            if (item) {
                if (item.qty < 20) item.qty++;
            } else {
                cart.push({ id: id, name: name, price: parseFloat(price), qty: 1 });
            }
            renderCart();
        }

        function removeFromCart(id) {
            cart = cart.filter(x => x.id !== id);
            renderCart();
        }

        function updateCartQty(id, change) {
            var item = cart.find(x => x.id === id);
            if (item) {
                var newQty = item.qty + change;
                if (newQty >= 1 && newQty <= 20) {
                    item.qty = newQty;
                    renderCart();
                }
            }
        }

        function renderCart() {
            var container = document.getElementById('cartContainer');
            var inputsContainer = document.getElementById('hiddenCartInputs');
            
            container.innerHTML = '';
            inputsContainer.innerHTML = '';

            if (cart.length === 0) {
                container.innerHTML = `
                    <div id="emptyCartMessage" class="p-3 text-center text-muted" style="background:#fdfcf8; border:1px solid #eaddc4; border-radius:4px; font-size: 0.85rem;">
                        Chưa chọn dịch vụ nào. Hãy bấm nút <i class="fas fa-plus-circle text-gold"></i> ở danh sách bên phải.
                    </div>
                `;
            } else {
                cart.forEach((item, index) => {
                    // Create Cart Item UI
                    var card = document.createElement('div');
                    card.className = 'p-3 mb-2 d-flex justify-content-between align-items-center';
                    card.style.background = '#fdfcf8';
                    card.style.border = '1px solid #eaddc4';
                    card.style.borderRadius = '4px';
                    
                    var subtotal = item.price * item.qty;
                    card.innerHTML = `
                        <div style="flex: 1;">
                            <strong class="d-block text-navy mb-1" style="font-size:0.9rem">${item.name}</strong>
                            <small class="text-gold" style="font-size:0.8rem">${formatCurrency(item.price)}</small>
                        </div>
                        <div class="d-flex align-items-center gap-1 mx-3">
                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" style="border-radius:0;" onclick="updateCartQty('${item.id}', -1)">-</button>
                            <span class="px-2 fw-bold" style="min-width:20px; text-align:center">${item.qty}</span>
                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" style="border-radius:0;" onclick="updateCartQty('${item.id}', 1)">+</button>
                        </div>
                        <div class="text-end d-flex align-items-center gap-3">
                            <strong class="text-navy" style="font-size:0.9rem">${formatCurrency(subtotal)}</strong>
                            <button type="button" class="btn btn-link text-danger p-0" onclick="removeFromCart('${item.id}')" title="Xóa">
                                <i class="fas fa-trash-alt"></i>
                            </button>
                        </div>
                    `;
                    container.appendChild(card);

                    // Add hidden inputs for form post using indexed name syntax
                    inputsContainer.innerHTML += `
                        <input type="hidden" name="services[${index}].MaDichVu" value="${item.id}" />
                        <input type="hidden" name="services[${index}].SoLuong" value="${item.qty}" />
                    `;
                });
            }

            checkFormValidity();
            calculateTotal();
        }

        function onRoomChange(selectEl) {
            var option = selectEl.options[selectEl.selectedIndex];
            if (option.value) {
                document.getElementById('customerNameInput').value = option.getAttribute('data-customer');
            } else {
                document.getElementById('customerNameInput').value = "";
            }
            checkFormValidity();
            calculateTotal();
            locDichVuDaGoi(selectEl.value);
        }

        // Bảng dịch vụ đã gọi: chỉ hiện của phòng đang chọn (không chọn = tất cả)
        function locDichVuDaGoi(maPhong) {
            var rows = document.querySelectorAll('#usedTable tbody tr'), n = 0;
            rows.forEach(function (r) { var on = !maPhong || r.getAttribute('data-room') === maPhong; r.hidden = !on; if (on) n++; });
            var info = document.getElementById('usedInfo');
            if (info && rows.length) info.textContent = n + ' dòng' + (maPhong ? ' của phòng đang chọn' : '');
        }
        document.querySelectorAll('[data-void]').forEach(function (b) {
            b.addEventListener('click', function () {
                document.getElementById('vdDp').value = b.getAttribute('data-dp');
                document.getElementById('vdSd').value = b.getAttribute('data-sd');
                document.getElementById('vdRoom').value = b.getAttribute('data-room');
                document.getElementById('vdTen').textContent = b.getAttribute('data-ten') + ' — đang ghi ' + b.getAttribute('data-sl');
                var sl = document.getElementById('vdSl'); sl.max = b.getAttribute('data-sl'); sl.value = 1;
                document.getElementById('vdLyDo').value = '';
                bootstrap.Modal.getOrCreateInstance(document.getElementById('voidModal')).show();
            });
        });
        (function () { var sel = document.getElementById('selectedRoom'); if (sel) locDichVuDaGoi(sel.value); })();

        function calculateTotal() {
            var newFee = cart.reduce((sum, item) => sum + (item.price * item.qty), 0);
            document.getElementById('newServiceFeeDisplay').innerText = formatCurrency(newFee);
        }

        function formatCurrency(amount) {
            return amount.toLocaleString('en-US') + " ₫";
        }

        function checkFormValidity() {
            var roomId = document.getElementById('selectedRoom').value;
            var btn = document.getElementById('btnSubmit');

            if (roomId && cart.length > 0) {
                btn.disabled = false;
                btn.classList.remove('btn-outline-gold');
                btn.classList.add('btn-gold');
            } else {
                btn.disabled = true;
                btn.classList.remove('btn-gold');
                btn.classList.add('btn-outline-gold');
            }
        }

        // Auto-select room from URL parameter
        (function() {
            var selectedRoom = '@(ViewBag.SelectedRoom ?? "")';
            if (selectedRoom) {
                var roomSelect = document.getElementById('selectedRoom');
                for (var i = 0; i < roomSelect.options.length; i++) {
                    if (roomSelect.options[i].value === selectedRoom) {
                        roomSelect.selectedIndex = i;
                        onRoomChange(roomSelect);
                        break;
                    }
                }
            }
        })();
    </script>
}
