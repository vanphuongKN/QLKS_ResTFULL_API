@model QLKSan.Models.Requests.ChangePasswordRequest
@{
    // Khách hàng ở giao diện khách, nhân viên ở giao diện quản trị
    var laKhach = User.IsInRole(WebRoles.Customer);
    Layout = laKhach ? "_CustomerLayout" : "_Layout";
    ViewData["Title"] = "Đổi mật khẩu";
}

<div class="@(laKhach ? "" : "page-header")">
    <div>
        <p class="@(laKhach ? "lr-section-label" : "page-label")">Tài khoản</p>
        <h2 class="@(laKhach ? "lr-section-title" : "")">Đổi mật khẩu</h2>
    </div>
</div>

<div class="row">
    <div class="col-md-8 col-lg-6">
        <div class="@(laKhach ? "lr-card" : "card p-4")">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success">@TempData["SuccessMessage"]</div>
            }
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
            <form asp-action="ChangePassword" method="post">
                <div class="mb-3">
                    <label asp-for="MatKhauCu" class="form-label fw-semibold">Mật khẩu hiện tại</label>
                    <input asp-for="MatKhauCu" type="password" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="MatKhauCu" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="MatKhauMoi" class="form-label fw-semibold">Mật khẩu mới</label>
                    <input asp-for="MatKhauMoi" type="password" class="form-control" autocomplete="new-password" placeholder="Tối thiểu 6 ký tự" />
                    <span asp-validation-for="MatKhauMoi" class="text-danger small"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="XacNhanMatKhauMoi" class="form-label fw-semibold">Nhập lại mật khẩu mới</label>
                    <input asp-for="XacNhanMatKhauMoi" type="password" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="XacNhanMatKhauMoi" class="text-danger small"></span>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="@(laKhach ? "lr-btn-gold-sm" : "btn-gold")">Đổi mật khẩu</button>
                    <a href="@(laKhach ? Url.Action("Profile", "Customer") : Url.Action("Portal", "Auth"))" class="@(laKhach ? "lr-btn-outline-sm" : "btn btn-outline-navy")">Quay lại</a>
                </div>
            </form>
        </div>
    </div>
</div>
