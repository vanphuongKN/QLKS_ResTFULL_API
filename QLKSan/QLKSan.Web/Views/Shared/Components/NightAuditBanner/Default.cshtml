@model QLKSan.Models.DTOs.NightAuditStatusDto
<div class="alert alert-warning mb-3 d-flex justify-content-between align-items-center gap-2 flex-wrap" role="status">
    <span>
        <i class="fas fa-moon me-2"></i>
        <strong>@Model.SoNgayChuaChot ngày chưa chốt</strong> — cần chốt ngày @Model.NgayCanChot?.ToString("dd/MM/yyyy")@(Model.SoNgayChuaChot > 1 ? $" (tới {DateTime.Today.AddDays(-1):dd/MM/yyyy})" : "").
        @(Model.NgayChotGanNhat != null ? $"Lần chốt gần nhất: {Model.NgayChotGanNhat:dd/MM/yyyy}." : "Chưa chốt ngày nào.")
    </span>
    <a href="@Url.Action("Index", "NightAudit")" class="btn btn-sm btn-warning"><i class="fas fa-arrow-right me-1"></i>Chốt ngày</a>
</div>
