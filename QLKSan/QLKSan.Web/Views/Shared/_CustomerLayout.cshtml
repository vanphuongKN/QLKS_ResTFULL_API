@{
    var currentAction = ViewContext.RouteData.Values["Action"]?.ToString() ?? "";
    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString() ?? "";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LUXE RESERVE</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/customer.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,500&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/flatpickr/4.6.13/flatpickr.min.css" />
</head>
<body>
    <!-- Top Navigation -->
    @{
        var navRole = User.GetRole();
        var laKhach = User.IsLoggedIn() && navRole == "Customer";
        string NavActive(string c, string a) => currentController == c && currentAction == a ? "active" : "";
    }
    @* Trang có ảnh hero (ViewData["HeaderOverlay"] = true): header trong suốt nằm đè lên ảnh, chuyển nền trắng khi cuộn *@
    <nav class="lr-navbar @(ViewData["HeaderOverlay"] is true ? "lr-navbar--overlay" : "")">
        <a href="@Url.Action("Index", "Home")" class="lr-brand">LUXE RESERVE</a>
        <button type="button" class="lr-nav-toggle" aria-label="Mở menu" onclick="this.closest('.lr-navbar').classList.toggle('open')"><i class="fas fa-bars"></i></button>
        <div class="lr-nav-collapse">
            <ul class="lr-nav-links">
                <li><a href="@Url.Action("Index", "Home")" class="@NavActive("Home", "Index")">Trang chủ</a></li>
                @if (laKhach)
                {
                    <li><a href="@Url.Action("BookRoom", "Customer")" class="@NavActive("Customer", "BookRoom")">Đặt phòng</a></li>
                    <li><a href="@Url.Action("MyStays", "Customer")" class="@NavActive("Customer", "MyStays")">Kỳ nghỉ</a></li>
                    <li><a href="@Url.Action("Feedback", "Customer")" class="@NavActive("Customer", "Feedback")">Đánh giá</a></li>
                    <li><a href="@Url.Action("Profile", "Customer")" class="@NavActive("Customer", "Profile")">Hồ sơ</a></li>
                }
                else
                {
                    <li><a href="@Url.Action("Index", "Home")#accommodation-section">Hạng phòng</a></li>
                    <li><a href="@Url.Action("Index", "Home")#services-section">Đặc quyền</a></li>
                }
            </ul>
            <div class="lr-nav-right">
                @if (User.IsLoggedIn())
                {
                    var tenHienThi = User.GetHoTen();
                    if (string.IsNullOrWhiteSpace(tenHienThi)) tenHienThi = User.Identity?.Name;
                    if (laKhach)
                    {
                        <a href="@Url.Action("Profile", "Customer")" class="lr-user-link"><i class="fas fa-user-circle"></i> @tenHienThi</a>
                    }
                    else
                    {
                        <span class="lr-user-link"><i class="fas fa-user-circle"></i> @tenHienThi</span>
                        <a href="@Url.Action("Portal", "Auth")" class="lr-btn-outline-sm"><i class="fas fa-briefcase"></i> Trang nhân viên</a>
                    }
                    <a href="@Url.Action("Logout", "Auth")" class="lr-logout-link" title="Đăng xuất"><i class="fas fa-sign-out-alt"></i><span class="lr-logout-text">Đăng xuất</span></a>
                }
                else
                {
                    <a href="@Url.Action("Login", "Auth")" class="lr-btn-outline-sm"><i class="fas fa-sign-in-alt"></i> Đăng nhập</a>
                    <a href="@Url.Action("Register", "Auth")" class="lr-btn-gold-sm"><i class="fas fa-user-plus"></i> Đăng ký</a>
                }
            </div>
        </div>
    </nav>

    <!-- Main Content: trang tự dàn khối tràn chiều ngang (trang chủ) đặt ViewData["FullWidth"] = true -->
    @if (ViewData["FullWidth"] is true)
    {
        @RenderBody()
    }
    else
    {
        <div class="lr-content">
            @RenderBody()
        </div>
    }

    @await Component.InvokeAsync("HotelFooter")

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/flatpickr/4.6.13/flatpickr.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/flatpickr/4.6.13/l10n/vn.min.js"></script>
    <script>
        // Header trong suốt: đổi sang nền trắng khi cuộn qua ảnh hero
        (function () {
            var nav = document.querySelector('.lr-navbar--overlay');
            if (!nav) return;
            var update = function () { nav.classList.toggle('scrolled', window.scrollY > 40); };
            update();
            window.addEventListener('scroll', update, { passive: true });
        })();

        // Ô chọn ngày: <input data-lr-date> dùng lịch tiếng Việt (hiển thị dd/mm/yyyy, gửi yyyy-MM-dd);
        // data-lr-after="#CheckIn": ngày tối thiểu luôn sau ô kia 1 ngày
        window.lrDatePickers = {};
        (function () {
            if (!window.flatpickr) return;
            if (flatpickr.l10ns && flatpickr.l10ns.vn) flatpickr.localize(flatpickr.l10ns.vn);
            document.querySelectorAll('input[data-lr-date]').forEach(function (el) {
                window.lrDatePickers[el.id] = flatpickr(el, {
                    altInput: true, altFormat: 'd/m/Y', dateFormat: 'Y-m-d', disableMobile: true,
                    minDate: el.getAttribute('min') || null
                });
            });
            document.querySelectorAll('input[data-lr-after]').forEach(function (el) {
                var src = document.querySelector(el.getAttribute('data-lr-after'));
                var fp = window.lrDatePickers[el.id];
                if (!src || !fp) return;
                src.addEventListener('change', function () {
                    if (!src.value) return;
                    var d = new Date(src.value + 'T00:00:00'); d.setDate(d.getDate() + 1);
                    fp.set('minDate', d);
                    if (!el.value || new Date(el.value + 'T00:00:00') < d) fp.setDate(d, true);
                });
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
