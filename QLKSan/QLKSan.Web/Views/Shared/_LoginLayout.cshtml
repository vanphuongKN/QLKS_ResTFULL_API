<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LUXE RESERVE</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/customer.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,500&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>
<body>
    @* Màn hình chia đôi: ảnh khách sạn bên trái (ẩn trên điện thoại), biểu mẫu bên phải *@
    <div class="lr-auth">
        <aside class="lr-auth-visual">
            <a href="@Url.Action("Index", "Home")" class="lr-brand-light">LUXE RESERVE</a>
            <blockquote>
                Mỗi kỳ nghỉ bắt đầu từ một lời chào ân cần.
                <span>Khách hàng &amp; nhân viên</span>
            </blockquote>
        </aside>
        <main class="lr-auth-form">
            <a href="@Url.Action("Index", "Home")" class="lr-brand-mobile">LUXE RESERVE</a>
            <div class="login-card">
                @RenderBody()
            </div>
            <a href="@Url.Action("Index", "Home")" class="login-back-home"><i class="fas fa-arrow-left me-1"></i> Về trang chủ</a>
        </main>
    </div>
</body>
</html>
