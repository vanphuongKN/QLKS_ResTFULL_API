@model QLKSan.Models.DTOs.RoomTypeDetailDto
@{
    ViewData["Title"] = "Bộ ảnh " + Model.TenLoai;
}

<div class="page-header">
    <div>
        <p class="page-label"><a asp-action="RoomTypes" class="text-reset text-decoration-none"><i class="fas fa-arrow-left me-1"></i>Loại phòng</a></p>
        <h2>Bộ ảnh — @Model.TenLoai</h2>
    </div>
    <a asp-controller="Home" asp-action="RoomType" asp-route-id="@Model.MaLoai" target="_blank" class="btn btn-outline-secondary">
        <i class="fas fa-up-right-from-square me-2"></i>Xem trang khách
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success mb-3">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger mb-3">@TempData["ErrorMessage"]</div>
}

<div class="card p-4 mb-4">
    <form asp-action="UploadRoomTypeImage" method="post" enctype="multipart/form-data" class="row g-3 align-items-end">
        <input type="hidden" name="maLoai" value="@Model.MaLoai" />
        <div class="col-md-8">
            <label class="form-label fw-semibold" for="file">Thêm ảnh</label>
            <input type="file" name="file" id="file" class="form-control" accept="image/jpeg,image/png,image/webp" required>
            <small class="text-muted">JPG, PNG hoặc WebP, tối đa 5 MB. Ảnh đầu tiên trong bộ ảnh là ảnh đại diện của hạng phòng.</small>
        </div>
        <div class="col-md-4">
            <button type="submit" class="btn-gold w-100"><i class="fas fa-upload me-2"></i>Tải lên</button>
        </div>
    </form>
</div>

@if (!Model.HinhAnhs.Any())
{
    <div class="card p-5 text-center text-muted">
        <i class="fas fa-images" style="font-size:2.5rem;opacity:.3"></i>
        <p class="mt-3 mb-0">Hạng phòng chưa có ảnh. Trang khách đang dùng @(string.IsNullOrEmpty(Model.AnhDaiDien) ? "ảnh mặc định" : "ảnh đại diện hiện có").</p>
    </div>
}
<div class="row g-3">
    @for (var i = 0; i < Model.HinhAnhs.Count; i++)
    {
        var h = Model.HinhAnhs[i];
        <div class="col-6 col-md-4 col-xl-3">
            <div class="card h-100 overflow-hidden">
                <img src="@MediaUrl.Of(h.DuongDan)" alt="Ảnh @(i + 1)" style="width:100%;aspect-ratio:4/3;object-fit:cover" />
                <div class="d-flex justify-content-between align-items-center p-2">
                    <span class="small">
                        @if (i == 0)
                        {
                            <span class="badge bg-gold-light text-gold">Ảnh đại diện</span>
                        }
                        else
                        {
                            <span class="text-muted">#@(i + 1)</span>
                        }
                    </span>
                    <form asp-action="DeleteRoomTypeImage" method="post" onsubmit="return confirm('Xoá ảnh này?')">
                        <input type="hidden" name="maLoai" value="@Model.MaLoai" />
                        <input type="hidden" name="maHinhAnh" value="@h.MaHinhAnh" />
                        <button type="submit" class="btn btn-sm btn-outline-danger border-0" title="Xoá ảnh"><i class="fas fa-trash"></i></button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>
