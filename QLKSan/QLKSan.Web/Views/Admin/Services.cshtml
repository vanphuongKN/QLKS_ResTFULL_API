@{
    ViewData["Title"] = "Quản lý Dịch vụ";
    var services = ViewBag.Services as IEnumerable<QLKSan.Models.DTOs.ServiceDto>;
}

<div class="page-header">
    <div>
        <p class="page-label">Quản lý dịch vụ</p>
        <h2>Bảng giá Dịch vụ</h2>
    </div>
    <button class="btn-gold" data-bs-toggle="modal" data-bs-target="#addServiceModal">
        <i class="fas fa-plus me-2"></i>Thêm dịch vụ
    </button>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success mb-3">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger mb-3">@TempData["ErrorMessage"]</div>
}

<div class="row g-4">
    @if (services != null && services.Any())
    {
        foreach (var svc in services)
        {
            <div class="col-md-4">
                <div class="card p-4 h-100">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <span class="badge bg-gold-light text-gold small mb-2">@svc.MaDichVu</span>
                            @if(svc.TrangThai == QLKSan.Enums.ServiceStatus.Available)
                            {
                                <span class="badge bg-success ms-2 small mb-2">Sẵn sàng</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary ms-2 small mb-2">Đã hết</span>
                            }
                            @if (svc.LaMinibar)
                            {
                                <span class="badge bg-light text-dark ms-2 small mb-2"><i class="fas fa-wine-bottle me-1"></i>Minibar</span>
                            }
                            @if (svc.LaTraiNghiem)
                            {
                                <span class="badge bg-gold-light text-gold ms-2 small mb-2" title="Hiển thị ở mục Trải nghiệm trang chủ"><i class="fas fa-star me-1"></i>Trải nghiệm</span>
                            }
                            <h6 class="fw-bold mb-0">@svc.TenDichVu</h6>
                        </div>
                        <div class="d-flex gap-2">
                            <form asp-action="SetServiceStatus" method="post">
                                <input type="hidden" name="maDichVu" value="@svc.MaDichVu" />
                                <input type="hidden" name="trangThai" value="@(svc.TrangThai == QLKSan.Enums.ServiceStatus.Available ? "Unavailable" : "Available")" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary border-0" title="@(svc.TrangThai == QLKSan.Enums.ServiceStatus.Available ? "Chuyển sang Đã hết" : "Chuyển sang Sẵn sàng")">
                                    <i class="fas fa-exchange-alt"></i>
                                </button>
                            </form>
                            <button type="button" class="btn btn-sm btn-outline-primary border-0" title="Sửa dịch vụ"
                                    data-svc="@Json.Serialize(svc)" onclick="editService(this)">
                                <i class="fas fa-pen"></i>
                            </button>
                            <form asp-action="DeleteService" method="post" onsubmit="return confirm('Xóa dịch vụ này?')">
                                <input type="hidden" name="maDichVu" value="@svc.MaDichVu" />
                                <button type="submit" class="btn btn-sm btn-outline-danger border-0" title="Xóa dịch vụ">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                    <p class="text-muted small mb-2">Đơn vị: @svc.DonViTinh</p>
                    @if (!string.IsNullOrEmpty(svc.MoTa))
                    {
                        <p class="small mb-2">@svc.MoTa</p>
                    }
                    <div class="mt-auto">
                        <span class="text-gold fw-bold fs-5">@svc.GiaDichVu.ToString("N0") ₫</span>
                        <span class="text-muted small"> / @svc.DonViTinh</span>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12 text-center p-5 text-muted">
            <i class="fas fa-concierge-bell" style="font-size:3rem; opacity:0.3"></i>
            <p class="mt-3">Chưa có dịch vụ nào. Hãy thêm dịch vụ đầu tiên!</p>
        </div>
    }
</div>

<!-- Add Service Modal -->
<div class="modal fade" id="addServiceModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold"><i class="fas fa-concierge-bell me-2"></i>Thêm dịch vụ mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="AddService" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tên dịch vụ</label>
                        <input type="text" name="tenDichVu" class="form-control" placeholder="VD: Massage, Giặt ủi..." required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Giá (₫)</label>
                        <input type="number" name="giaDichVu" class="form-control" placeholder="VD: 150000" min="0" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Đơn vị tính</label>
                        <input type="text" name="donViTinh" class="form-control" placeholder="VD: lần, kg, giờ..." required>
                    </div>
                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" name="laTraiNghiem" value="true" id="addServiceTN">
                        <label class="form-check-label" for="addServiceTN">Giới thiệu ở mục "Trải nghiệm" trên trang chủ</label>
                    </div>
                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" name="laMinibar" value="true" id="addServiceMB">
                        <label class="form-check-label" for="addServiceMB">Đồ minibar (buồng phòng ghi được vào bảng kê)</label>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Mô tả cho khách</label>
                        <textarea name="moTa" class="form-control" rows="2" maxlength="500" placeholder="Một câu giới thiệu ngắn, hiển thị trên trang chủ"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn-gold">Thêm dịch vụ</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Service Modal -->
<div class="modal fade" id="editServiceModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold"><i class="fas fa-pen me-2"></i>Cập nhật Dịch vụ</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="EditService" method="post">
                <div class="modal-body">
                    <input type="hidden" name="maDichVu" id="editServiceMa" />
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tên dịch vụ</label>
                        <input type="text" name="tenDichVu" id="editServiceTen" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Giá (₫)</label>
                        <input type="number" name="giaDichVu" id="editServiceGia" class="form-control" min="0" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Đơn vị tính</label>
                        <input type="text" name="donViTinh" id="editServiceDvt" class="form-control" required>
                    </div>
                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" name="laTraiNghiem" value="true" id="editServiceTN">
                        <label class="form-check-label" for="editServiceTN">Giới thiệu ở mục "Trải nghiệm" trên trang chủ</label>
                    </div>
                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" name="laMinibar" value="true" id="editServiceMB">
                        <label class="form-check-label" for="editServiceMB">Đồ minibar (buồng phòng ghi được vào bảng kê)</label>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Mô tả cho khách</label>
                        <textarea name="moTa" id="editServiceMoTa" class="form-control" rows="2" maxlength="500" placeholder="Một câu giới thiệu ngắn, hiển thị trên trang chủ"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn-primary btn">Cập nhật</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function editService(btn) {
        var s = JSON.parse(btn.getAttribute('data-svc'));
        document.getElementById('editServiceMa').value = s.maDichVu;
        document.getElementById('editServiceTen').value = s.tenDichVu;
        document.getElementById('editServiceGia').value = Math.floor(s.giaDichVu);
        document.getElementById('editServiceDvt').value = s.donViTinh;
        document.getElementById('editServiceTN').checked = s.laTraiNghiem;
        document.getElementById('editServiceMB').checked = s.laMinibar;
        document.getElementById('editServiceMoTa').value = s.moTa || '';
        new bootstrap.Modal(document.getElementById('editServiceModal')).show();
    }
</script>
}
