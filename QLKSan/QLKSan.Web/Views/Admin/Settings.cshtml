@model QLKSan.Models.DTOs.HotelSettingsDto
@{
    ViewData["Title"] = "Cấu hình khách sạn";
    var tab = ViewBag.Tab as string ?? "thong-tin";
    var tt = Model.ThongTin;
    var cs = Model.ChinhSach;
    var tv = Model.ThanhVien;
    var phuThu = cs.PhuThuTraMuon.ToList();
    while (phuThu.Count < 4) phuThu.Add(new QLKSan.Models.DTOs.LateCheckoutRuleDto());
    var hangs = tv.Hangs.ToList();
    while (hangs.Count < 6) hangs.Add(new QLKSan.Models.DTOs.MembershipTierDto());
    string Nguon(bool tuyChinh) => tuyChinh ? "Đã tuỳ chỉnh" : "Mặc định (appsettings.json)";
}

<div class="page-header">
    <div>
        <p class="page-label">Hệ thống</p>
        <h2>Cấu hình khách sạn</h2>
        <p class="page-desc">Thay đổi có hiệu lực ngay cho trang khách, đặt phòng và các hoá đơn lập từ bây giờ (hoá đơn đã thanh toán không đổi).@(Model.CapNhatLuc != null ? $" Cập nhật gần nhất {Model.CapNhatLuc:HH:mm dd/MM/yyyy}." : "")</p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null) { <div class="alert alert-success mb-3">@TempData["SuccessMessage"]</div> }
@if (TempData["ErrorMessage"] != null) { <div class="alert alert-danger mb-3">@TempData["ErrorMessage"]</div> }

<div class="filter-chips mb-4" role="tablist">
    <a asp-action="Settings" asp-route-tab="thong-tin" class="@(tab == "thong-tin" ? "active" : "")">Thông tin khách sạn</a>
    <a asp-action="Settings" asp-route-tab="chinh-sach" class="@(tab == "chinh-sach" ? "active" : "")">Chính sách lưu trú</a>
    <a asp-action="Settings" asp-route-tab="thanh-vien" class="@(tab == "thanh-vien" ? "active" : "")">Chương trình thành viên</a>
</div>

@if (tab == "thong-tin")
{
    <form asp-action="SaveHotelInfo" method="post" class="card p-4">
        <div class="d-flex justify-content-between mb-3"><h6 class="dash-title mb-0">Thông tin liên hệ</h6><span class="badge bg-light text-dark border">@Nguon(Model.ThongTinDaTuyChinh)</span></div>
        <div class="row g-3">
            <div class="col-md-6"><label class="form-label small fw-semibold">Tên khách sạn</label><input name="Ten" class="form-control" value="@tt.Ten" required maxlength="100" /></div>
            <div class="col-md-6"><label class="form-label small fw-semibold">Hotline</label><input name="Hotline" class="form-control" value="@tt.Hotline" maxlength="30" /></div>
            <div class="col-12"><label class="form-label small fw-semibold">Mô tả ngắn (trang chủ, footer)</label><textarea name="MoTaNgan" class="form-control" rows="2" maxlength="300">@tt.MoTaNgan</textarea></div>
            <div class="col-md-8"><label class="form-label small fw-semibold">Địa chỉ</label><input name="DiaChi" class="form-control" value="@tt.DiaChi" maxlength="255" /></div>
            <div class="col-md-4"><label class="form-label small fw-semibold">Email đặt phòng</label><input name="Email" type="email" class="form-control" value="@tt.Email" maxlength="100" /></div>
            <div class="col-12"><label class="form-label small fw-semibold">Liên kết bản đồ</label><input name="BanDoUrl" type="url" class="form-control" value="@tt.BanDoUrl" maxlength="500" placeholder="https://maps.google.com/…" /></div>
        </div>
        <div class="mt-4"><button type="submit" class="btn-gold">Lưu thông tin</button></div>
    </form>
}
else if (tab == "chinh-sach")
{
    <form asp-action="SavePolicy" method="post" class="card p-4">
        <div class="d-flex justify-content-between mb-3"><h6 class="dash-title mb-0">Chính sách lưu trú</h6><span class="badge bg-light text-dark border">@Nguon(Model.ChinhSachDaTuyChinh)</span></div>
        <div class="row g-3">
            <div class="col-6 col-md-3"><label class="form-label small fw-semibold">Giờ nhận phòng</label><input name="GioNhanPhong" type="number" min="0" max="23" class="form-control" value="@cs.GioNhanPhong" required /></div>
            <div class="col-6 col-md-3"><label class="form-label small fw-semibold">Giờ trả phòng</label><input name="GioTraPhong" type="number" min="0" max="23" class="form-control" value="@cs.GioTraPhong" required /></div>
            <div class="col-6 col-md-3"><label class="form-label small fw-semibold">Cọc khách vãng lai (%)</label><input name="PhanTramTienCocVangLai" type="number" min="0" max="100" class="form-control" value="@cs.PhanTramTienCocVangLai" required /></div>
            <div class="col-6 col-md-3"><label class="form-label small fw-semibold">Chu kỳ kiểm tra khách không đến (phút)</label><input name="ChuKyKiemTraKhongDenPhut" type="number" min="5" max="1440" class="form-control" value="@cs.ChuKyKiemTraKhongDenPhut" required /></div>
            <div class="col-md-6">
                <div class="form-check form-switch"><input class="form-check-input" type="checkbox" name="TuDongXacNhanDatPhong" value="true" id="csXacNhan" @(cs.TuDongXacNhanDatPhong ? "checked" : "")><label class="form-check-label" for="csXacNhan">Tự xác nhận phiếu đặt online khi còn phòng</label></div>
            </div>
            <div class="col-md-6">
                <div class="form-check form-switch"><input class="form-check-input" type="checkbox" name="TuDongHuyKhachKhongDen" value="true" id="csHuy" @(cs.TuDongHuyKhachKhongDen ? "checked" : "")><label class="form-check-label" for="csHuy">Tự huỷ phiếu khách không đến (qua ngày nhận phòng)</label></div>
            </div>
            <div class="col-12">
                <label class="form-label small fw-semibold mb-1">Phụ thu trả phòng muộn</label>
                <p class="small text-muted mb-2">Trả phòng đến mốc giờ: tính % giá 1 đêm. Mốc phải sau giờ trả phòng và tăng dần; sau mốc cuối tính thêm 1 đêm. Để trống dòng không dùng.</p>
                <div class="row g-2">
                    @for (var i = 0; i < phuThu.Count; i++)
                    {
                        <div class="col-6 col-md-3">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text">Đến</span>
                                <input name="PhuThuTraMuon[@i].DenGio" type="number" min="0" max="23" class="form-control" value="@(phuThu[i].DenGio > 0 ? phuThu[i].DenGio.ToString() : "")" />
                                <span class="input-group-text">h</span>
                                <input name="PhuThuTraMuon[@i].PhanTram" type="number" min="0" max="100" class="form-control" value="@(phuThu[i].DenGio > 0 ? phuThu[i].PhanTram.ToString() : "")" />
                                <span class="input-group-text">%</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="mt-4"><button type="submit" class="btn-gold">Lưu chính sách</button></div>
    </form>
}
else
{
    <form asp-action="SaveLoyalty" method="post" class="card p-4">
        <div class="d-flex justify-content-between mb-3"><h6 class="dash-title mb-0">Chương trình thành viên</h6><span class="badge bg-light text-dark border">@Nguon(Model.ThanhVienDaTuyChinh)</span></div>
        <div class="row g-3 mb-4">
            <div class="col-md-4"><label class="form-label small fw-semibold">Tích 1 điểm cho mỗi (₫)</label><input name="SoTienMotDiem" type="number" min="1000" class="form-control" value="@tv.SoTienMotDiem" required /></div>
            <div class="col-md-4"><label class="form-label small fw-semibold">Giá trị 1 điểm khi đổi (₫)</label><input name="GiaTriMotDiem" type="number" min="1" class="form-control" value="@tv.GiaTriMotDiem" required /></div>
            <div class="col-md-4"><label class="form-label small fw-semibold">Số điểm đổi tối thiểu</label><input name="DiemDoiToiThieu" type="number" min="1" class="form-control" value="@tv.DiemDoiToiThieu" required /></div>
        </div>
        <label class="form-label small fw-semibold mb-1">Các hạng</label>
        <p class="small text-muted mb-2">Hạng xét theo điểm trọn đời (điểm hiện có + đã đổi). Hạng thấp nhất bắt đầu từ 0 điểm. Quyền lợi: mỗi dòng một ý. Để trống tên để bỏ hạng.</p>
        <table class="table table-custom mb-0">
            <thead><tr><th style="width:24%">Tên hạng</th><th style="width:14%">Từ điểm</th><th style="width:14%">Giảm tiền phòng</th><th>Quyền lợi hiển thị cho khách</th></tr></thead>
            <tbody>
                @for (var i = 0; i < hangs.Count; i++)
                {
                    <tr>
                        <td><input name="Hangs[@i].Ten" class="form-control form-control-sm" value="@hangs[i].Ten" maxlength="50" /></td>
                        <td><input name="Hangs[@i].DiemToiThieu" type="number" min="0" class="form-control form-control-sm" value="@(hangs[i].Ten != null ? hangs[i].DiemToiThieu.ToString() : "")" /></td>
                        <td><div class="input-group input-group-sm"><input name="Hangs[@i].PhanTramGiamPhong" type="number" min="0" max="50" class="form-control" value="@(hangs[i].Ten != null ? hangs[i].PhanTramGiamPhong.ToString() : "")" /><span class="input-group-text">%</span></div></td>
                        <td><textarea name="Hangs[@i].QuyenLoi" class="form-control form-control-sm" rows="2">@string.Join("\n", hangs[i].QuyenLoi ?? new List<string>())</textarea></td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="mt-4"><button type="submit" class="btn-gold">Lưu chương trình thành viên</button></div>
    </form>
}
