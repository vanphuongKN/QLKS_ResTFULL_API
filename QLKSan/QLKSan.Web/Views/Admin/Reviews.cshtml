@{
    ViewData["Title"] = "Đánh giá khách hàng";
    var reviews = ViewBag.Reviews as IEnumerable<QLKSan.Models.DTOs.ReviewDto>;
}

<div class="page-header">
    <div>
        <p class="page-label">Trải nghiệm khách hàng</p>
        <h2>Đánh giá & Nhận xét</h2>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-custom mb-0">
            <thead>
                <tr>
                    <th>Khách hàng</th>
                    <th>Phòng</th>
                    <th>Đánh giá</th>
                    <th>Nhận xét</th>
                    <th>Ngày</th>
                    <th>Ẩn danh</th>
                </tr>
            </thead>
            <tbody>
                @if (reviews != null && reviews.Any())
                {
                    foreach (var r in reviews)
                    {
                        <tr>
                            <td>
                                <strong>@(r.AnDanh ? "Ẩn danh" : (r.HoTenKhachHang ?? "N/A"))</strong>
                            </td>
                            <td>@(r.MaPhong ?? "N/A")</td>
                            <td>
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <i class="fas fa-star @(i <= r.SoSao ? "text-gold" : "text-muted")" style="font-size:0.8rem"></i>
                                }
                                <small class="ms-1 text-muted">(@r.SoSao/5)</small>
                            </td>
                            <td style="max-width:250px">
                                <small class="text-muted">@(r.NoiDung?.Length > 80 ? r.NoiDung.Substring(0, 80) + "..." : r.NoiDung)</small>
                            </td>
                            <td><small>@r.NgayDanhGia.ToString("dd/MM/yyyy")</small></td>
                            <td>
                                @if (r.AnDanh == true)
                                {
                                    <span class="badge bg-secondary">Ẩn danh</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-dark">Công khai</span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted p-5">
                            <i class="fas fa-star" style="font-size:2.5rem;opacity:0.2"></i>
                            <p class="mt-2">Chưa có đánh giá nào từ khách hàng.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
