@{
    ViewData["Title"] = "Khuyến mãi";
    var promos = ViewBag.Promotions as List<QLKSan.Models.DTOs.PromotionDto> ?? new List<QLKSan.Models.DTOs.PromotionDto>();
    var roomTypes = ViewBag.RoomTypes as List<QLKSan.Models.DTOs.RoomTypeDto> ?? new List<QLKSan.Models.DTOs.RoomTypeDto>();
    var homNay = DateTime.Today;

    // Trạng thái hiển thị: tắt thủ công > theo ngày
    (string Nhom, string Nhan, string Css) TrangThai(QLKSan.Models.DTOs.PromotionDto p) =>
        !p.KichHoat ? ("tat", "Đã tắt", "badge-muted")
        : p.NgayKetThuc.Date < homNay ? ("het", "Đã kết thúc", "badge-muted")
        : p.NgayBatDau.Date > homNay ? ("sap", "Sắp diễn ra", "badge-booked")
        : p.SoLuotToiDa != null && p.SoLuotDaDung >= p.SoLuotToiDa ? ("het", "Hết lượt", "badge-muted")
        : ("dang", "Đang áp dụng", "badge-available");
    var dem = promos.GroupBy(p => TrangThai(p).Nhom).ToDictionary(g => g.Key, g => g.Count());
    int Dem(string k) => dem.TryGetValue(k, out var n) ? n : 0;
}

<div class="page-header">
    <div>
        <p class="page-label">Doanh thu</p>
        <h2>Khuyến mãi &amp; ưu đãi</h2>
        <p class="page-desc">Mã do khách nhập khi đặt phòng hoặc lễ tân nhập khi lập hoá đơn; hệ thống tự kiểm tra hạn, hạng phòng, số đêm và số lượt.</p>
    </div>
    <button class="btn-gold" onclick="openPromo(null)"><i class="fas fa-plus me-2"></i>Tạo khuyến mãi</button>
</div>

@if (TempData["SuccessMessage"] != null) { <div class="alert alert-success mb-3">@TempData["SuccessMessage"]</div> }
@if (TempData["ErrorMessage"] != null) { <div class="alert alert-danger mb-3">@TempData["ErrorMessage"]</div> }

<div class="filter-chips mb-4" id="promoFilter">
    <button type="button" class="active" data-f="">Tất cả <span>@promos.Count</span></button>
    <button type="button" data-f="dang">Đang áp dụng <span>@Dem("dang")</span></button>
    <button type="button" data-f="sap">Sắp diễn ra <span>@Dem("sap")</span></button>
    <button type="button" data-f="het">Đã kết thúc <span>@Dem("het")</span></button>
    <button type="button" data-f="tat">Đã tắt <span>@Dem("tat")</span></button>
</div>

<div class="row g-4">
    @if (!promos.Any())
    {
        <div class="col-12 text-center p-5 text-muted">
            <i class="fas fa-tags" style="font-size:3rem;opacity:0.3"></i>
            <p class="mt-3">Chưa có chương trình khuyến mãi nào.</p>
        </div>
    }
    @foreach (var p in promos)
    {
        var tt = TrangThai(p);
        var laPhanTram = p.LoaiGiam == "Phần trăm";
        <div class="col-md-6 col-xl-4" data-nhom="@tt.Nhom">
            <div class="card promo-admin h-100 @(tt.Nhom is "tat" or "het" ? "is-off" : "")">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="promo-code">@p.MaKhuyenMai</span>
                    <span class="badge-status @tt.Css">@tt.Nhan</span>
                </div>
                <h6 class="fw-bold mb-1">@p.TenKhuyenMai</h6>
                <div class="promo-value">Giảm @(laPhanTram ? p.GiaTriGiam.ToString("0.##") + "%" : FormatHelper.ToVND(p.GiaTriGiam))<small>@(laPhanTram ? " tiền phòng" : "")</small></div>
                <div class="promo-conds">
                    <span><i class="fas fa-calendar"></i>@p.NgayBatDau.ToString("dd/MM/yyyy") – @p.NgayKetThuc.ToString("dd/MM/yyyy")</span>
                    <span><i class="fas fa-bed"></i>@(p.TenLoai == null ? "Mọi hạng phòng" : FormatHelper.TenHangPhong(p.TenLoai))</span>
                    @if (p.SoDemToiThieu != null) { <span><i class="fas fa-moon"></i>Từ @p.SoDemToiThieu đêm</span> }
                </div>
                <div class="promo-usage">
                    @if (p.SoLuotToiDa != null)
                    {
                        var pct = Math.Min(100, p.SoLuotDaDung * 100 / Math.Max(1, p.SoLuotToiDa.Value));
                        <div class="d-flex justify-content-between small mb-1"><span>Đã dùng</span><strong>@p.SoLuotDaDung / @p.SoLuotToiDa lượt</strong></div>
                        <div class="kpi-meter kpi-meter--light"><span style="width:@pct%"></span></div>
                    }
                    else
                    {
                        <div class="d-flex justify-content-between small"><span>Đã dùng</span><strong>@p.SoLuotDaDung lượt</strong></div>
                    }
                </div>
                <div class="d-flex gap-2 mt-auto pt-3">
                    <button type="button" class="btn btn-sm btn-outline-primary" data-promo="@Json.Serialize(p)" onclick="openPromo(this)"><i class="fas fa-pen me-1"></i>Sửa</button>
                    <form asp-action="SetPromotionStatus" method="post">
                        <input type="hidden" name="maKhuyenMai" value="@p.MaKhuyenMai" />
                        <input type="hidden" name="kichHoat" value="@(p.KichHoat ? "false" : "true")" />
                        <button type="submit" class="btn btn-sm btn-outline-secondary">@(p.KichHoat ? "Tắt" : "Bật lại")</button>
                    </form>
                    @if (p.SoLuotDaDung == 0)
                    {
                        <form asp-action="DeletePromotion" method="post" class="ms-auto" onsubmit="return confirm('Xoá mã @p.MaKhuyenMai?')">
                            <input type="hidden" name="maKhuyenMai" value="@p.MaKhuyenMai" />
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Xoá"><i class="fas fa-trash"></i></button>
                        </form>
                    }
                </div>
            </div>
        </div>
    }
</div>

<!-- Thêm / sửa khuyến mãi: một form, đổi action theo thao tác -->
<div class="modal fade" id="promoModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="pmTitle">Tạo khuyến mãi</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" id="pmForm" data-add="@Url.Action("AddPromotion")" data-edit="@Url.Action("EditPromotion")">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold" for="pmMa">Mã</label>
                            <input name="maKhuyenMai" id="pmMa" class="form-control text-uppercase" maxlength="10" placeholder="VD: SUMMER26" required>
                        </div>
                        <div class="col-md-8">
                            <label class="form-label fw-semibold" for="pmTen">Tên chương trình</label>
                            <input name="tenKhuyenMai" id="pmTen" class="form-control" maxlength="100" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold" for="pmLoai">Loại giảm</label>
                            <select name="loaiGiam" id="pmLoai" class="form-select">
                                <option value="Phần trăm">Phần trăm tiền phòng (%)</option>
                                <option value="Số tiền">Số tiền (₫)</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold" for="pmGiaTri">Giá trị giảm</label>
                            <input name="giaTriGiam" id="pmGiaTri" type="number" class="form-control" min="0" step="any" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold" for="pmLoaiPhong">Hạng phòng áp dụng</label>
                            <select name="maLoai" id="pmLoaiPhong" class="form-select">
                                <option value="">Mọi hạng phòng</option>
                                @foreach (var rt in roomTypes)
                                {
                                    <option value="@rt.MaLoai">@FormatHelper.TenHangPhong(rt.TenLoai)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold" for="pmTu">Từ ngày</label>
                            <input name="ngayBatDau" id="pmTu" type="date" class="form-control" required>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold" for="pmDen">Đến ngày</label>
                            <input name="ngayKetThuc" id="pmDen" type="date" class="form-control" required>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold" for="pmDem">Số đêm tối thiểu</label>
                            <input name="soDemToiThieu" id="pmDem" type="number" class="form-control" min="1" max="60" placeholder="Không giới hạn">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold" for="pmLuot">Số lượt tối đa</label>
                            <input name="soLuotToiDa" id="pmLuot" type="number" class="form-control" min="1" placeholder="Không giới hạn">
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn-gold" id="pmSubmit">Tạo khuyến mãi</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // btn = null: tạo mới; ngược lại đọc khuyến mãi từ data-promo để sửa (mã không đổi được)
        function openPromo(btn) {
            var p = btn ? JSON.parse(btn.getAttribute('data-promo')) : {};
            var f = document.getElementById('pmForm');
            f.action = btn ? f.getAttribute('data-edit') : f.getAttribute('data-add');
            document.getElementById('pmTitle').textContent = btn ? 'Sửa khuyến mãi ' + p.maKhuyenMai : 'Tạo khuyến mãi';
            document.getElementById('pmSubmit').textContent = btn ? 'Lưu thay đổi' : 'Tạo khuyến mãi';
            var set = function (id, v) { document.getElementById(id).value = v == null ? '' : v; };
            set('pmMa', p.maKhuyenMai);
            document.getElementById('pmMa').readOnly = !!btn;
            set('pmTen', p.tenKhuyenMai);
            set('pmLoai', p.loaiGiam || 'Phần trăm');
            set('pmGiaTri', p.giaTriGiam);
            set('pmLoaiPhong', p.maLoai);
            set('pmTu', p.ngayBatDau ? p.ngayBatDau.substring(0, 10) : '');
            set('pmDen', p.ngayKetThuc ? p.ngayKetThuc.substring(0, 10) : '');
            set('pmDem', p.soDemToiThieu);
            set('pmLuot', p.soLuotToiDa);
            bootstrap.Modal.getOrCreateInstance(document.getElementById('promoModal')).show();
        }

        // Lọc theo trạng thái (phía trình duyệt)
        document.querySelectorAll('#promoFilter button').forEach(function (b) {
            b.addEventListener('click', function () {
                var f = b.getAttribute('data-f');
                document.querySelectorAll('#promoFilter button').forEach(function (x) { x.classList.toggle('active', x === b); });
                document.querySelectorAll('[data-nhom]').forEach(function (c) { c.hidden = !!f && c.getAttribute('data-nhom') !== f; });
            });
        });
    </script>
}
