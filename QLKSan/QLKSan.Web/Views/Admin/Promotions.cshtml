@model QLKSan.Models.Requests.PromotionRequest
@{
    ViewData["Title"] = "Quản lý Khuyến mãi";
    var promos = ViewBag.Promotions as IEnumerable<QLKSan.Models.DTOs.PromotionDto>;
}

<div class="page-header">
    <div>
        <p class="page-label">Chiến lược giá</p>
        <h2>Khuyến mãi & Ưu đãi</h2>
    </div>
    <button class="btn-gold" data-bs-toggle="modal" data-bs-target="#addPromoModal">
        <i class="fas fa-plus me-2"></i>Tạo khuyến mãi
    </button>
</div>

@if (TempData["SuccessMessage"] != null) { <div class="alert alert-success mb-3">@TempData["SuccessMessage"]</div> }
@if (TempData["ErrorMessage"] != null) { <div class="alert alert-danger mb-3">@TempData["ErrorMessage"]</div> }

<div class="row g-4">
    @if (promos != null && promos.Any())
    {
        foreach (var promo in promos)
        {
            // So theo ngày: chưa tới ngày bắt đầu là "Sắp diễn ra", không phải "Hết hạn"
            var homNay = DateTime.Today;
            var (nhan, css) = promo.NgayKetThuc.Date < homNay ? ("Hết hạn", "badge-muted")
                : promo.NgayBatDau.Date > homNay ? ("Sắp diễn ra", "badge-booked")
                : ("Đang hoạt động", "badge-available");
            var laPhanTram = promo.LoaiGiam != null && promo.LoaiGiam.Contains("trăm");
            <div class="col-md-4">
                <div class="card p-4 h-100">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="promo-name">@promo.MaKhuyenMai</span>
                        <span class="badge-status @css">@nhan</span>
                    </div>
                    <h6 class="fw-bold mb-1">@promo.TenKhuyenMai</h6>
                    <p class="text-muted small mb-1">Loại: @promo.LoaiGiam</p>
                    <p class="text-gold fw-bold fs-5 mb-2">Giảm @(laPhanTram ? promo.GiaTriGiam.ToString("0.##") + "%" : promo.GiaTriGiam.ToString("N0") + " ₫")</p>
                    <small class="text-muted">
                        <i class="fas fa-calendar me-1"></i>
                        @promo.NgayBatDau.ToString("dd/MM/yyyy") – @promo.NgayKetThuc.ToString("dd/MM/yyyy")
                    </small>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12 text-center p-5 text-muted">
            <i class="fas fa-tags" style="font-size:3rem;opacity:0.3"></i>
            <p class="mt-3">Chưa có chương trình khuyến mãi nào.</p>
        </div>
    }
</div>

<!-- Add Promotion Modal -->
<div class="modal fade" id="addPromoModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold"><i class="fas fa-tags me-2"></i>Tạo khuyến mãi mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="AddPromotion" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label asp-for="MaKhuyenMai" class="form-label fw-semibold">Mã khuyến mãi</label>
                        <input asp-for="MaKhuyenMai" class="form-control" placeholder="VD: SUMMER2025" required>
                        <span asp-validation-for="MaKhuyenMai" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="TenKhuyenMai" class="form-label fw-semibold">Tên chương trình</label>
                        <input asp-for="TenKhuyenMai" class="form-control" placeholder="VD: Ưu đãi hè 2025" required>
                        <span asp-validation-for="TenKhuyenMai" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="LoaiGiam" class="form-label fw-semibold">Loại giảm</label>
                        <select asp-for="LoaiGiam" class="form-select">
                            <option value="Phần trăm">Phần trăm (%)</option>
                            <option value="Số tiền cố định">Số tiền cố định (₫)</option>
                        </select>
                        <span asp-validation-for="LoaiGiam" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="GiaTriGiam" class="form-label fw-semibold">Giá trị giảm</label>
                        <input asp-for="GiaTriGiam" type="number" class="form-control" placeholder="VD: 20 hoặc 500000" min="0" required>
                        <span asp-validation-for="GiaTriGiam" class="text-danger small"></span>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="NgayBatDau" class="form-label fw-semibold">Ngày bắt đầu</label>
                            <input asp-for="NgayBatDau" type="date" class="form-control" required>
                            <span asp-validation-for="NgayBatDau" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="NgayKetThuc" class="form-label fw-semibold">Ngày kết thúc</label>
                            <input asp-for="NgayKetThuc" type="date" class="form-control" required>
                            <span asp-validation-for="NgayKetThuc" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn-gold">Tạo khuyến mãi</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
