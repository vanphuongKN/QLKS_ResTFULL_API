@{
    ViewData["Title"] = "Dashboard Lễ Tân";
    var rooms = ViewBag.Rooms as IEnumerable<QLKSan.Models.Entities.Phong>;
    var onlineBookings = ViewBag.OnlineBookings as IEnumerable<QLKSan.Models.Entities.PhieuDatPhong>;
}

<div class="page-header">
    <div>
        <p class="page-label">Hoạt động thời gian thực</p>
        <h2>Dashboard Lễ Tân</h2>
    </div>
    <a asp-action="WalkIn" class="btn-gold">
        <i class="fas fa-plus me-2"></i>Khách vãng lai (Walk-In)
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success mb-3">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger mb-3">@TempData["ErrorMessage"]</div>
}

<div class="row g-4">
    <!-- Left: Rooms Grid -->
    <div class="col-lg-8">
        <div class="card p-4 h-100">
            <h6 class="fw-bold mb-4"><i class="fas fa-building me-2 text-navy"></i>Trạng thái phòng</h6>
            
            <div class="d-flex gap-3 mb-4 flex-wrap" id="roomStatusFilters">
                <div class="d-flex align-items-center gap-2"><span class="badge-status badge-filter badge-all px-3 active" data-filter="all" onclick="filterRooms('all')">Tất cả</span></div>
                <div class="d-flex align-items-center gap-2"><span class="badge-status badge-filter badge-available px-3" data-filter="Available" onclick="filterRooms('Available')">Trống</span></div>
                <div class="d-flex align-items-center gap-2"><span class="badge-status badge-filter badge-occupied px-3" data-filter="Occupied" onclick="filterRooms('Occupied')">Đang ở</span></div>
                <div class="d-flex align-items-center gap-2"><span class="badge-status badge-filter badge-cleaning px-3" data-filter="Cleaning" onclick="filterRooms('Cleaning')">Đang dọn</span></div>
                <div class="d-flex align-items-center gap-2"><span class="badge-status badge-filter badge-booked px-3" data-filter="Booked" onclick="filterRooms('Booked')">Đã đặt</span></div>
                <div class="d-flex align-items-center gap-2"><span class="badge-status badge-filter badge-maintenance px-3" data-filter="Maintenance" onclick="filterRooms('Maintenance')">Bảo trì</span></div>
            </div>

            <div class="row g-3">
                @if (rooms != null)
                {
                    foreach (var room in rooms)
                    {
                        var statusClass = room.TrangThai == QLKSan.Enums.RoomStatus.Available ? "badge-available"
                                         : room.TrangThai == QLKSan.Enums.RoomStatus.Occupied ? "badge-occupied"
                                         : room.TrangThai == QLKSan.Enums.RoomStatus.Booked ? "badge-booked"
                                         : room.TrangThai == QLKSan.Enums.RoomStatus.Maintenance ? "badge-maintenance"
                                         : "badge-cleaning";

                        var statusLabel = room.TrangThai == QLKSan.Enums.RoomStatus.Available ? "Trống"
                                         : room.TrangThai == QLKSan.Enums.RoomStatus.Occupied ? "Đang ở"
                                         : room.TrangThai == QLKSan.Enums.RoomStatus.Booked ? "Đã đặt"
                                         : room.TrangThai == QLKSan.Enums.RoomStatus.Maintenance ? "Bảo trì"
                                         : "Đang dọn";

                        <div class="col-md-3 col-sm-4 col-6 room-card-wrapper" data-status="@room.TrangThai">
                            <div class="card p-3 h-100 shadow-sm hover-shadow transition-all border d-flex flex-column" style="border-radius: 12px; border-color: #eae8e2 !important;">
                                <!-- Top row: Room Type & Status Badge -->
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <small class="text-gold fw-bold text-uppercase text-start" style="font-size:0.65rem; letter-spacing:0.5px; max-width: 60%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="@(room.LoaiPhong?.TenLoai ?? "Standard")">
                                        @(room.LoaiPhong?.TenLoai ?? "Standard")
                                    </small>
                                    <span class="badge-status @statusClass" style="font-size:0.6rem; padding: 2px 8px; border-radius:4px; font-weight:600; line-height: 1;">
                                        @statusLabel
                                    </span>
                                </div>

                                <!-- Middle: Room Number & Circle Icon -->
                                <div class="my-2 text-center">
                                    <div class="d-inline-flex justify-content-center align-items-center rounded-circle mb-2" 
                                         style="width: 48px; height: 48px; background: @(room.TrangThai == QLKSan.Enums.RoomStatus.Available ? "#e8f5e9" : room.TrangThai == QLKSan.Enums.RoomStatus.Occupied ? "#ffebee" : room.TrangThai == QLKSan.Enums.RoomStatus.Booked ? "#e3f2fd" : room.TrangThai == QLKSan.Enums.RoomStatus.Maintenance ? "#f1f3f5" : "#fff8e1"); color: @(room.TrangThai == QLKSan.Enums.RoomStatus.Available ? "#2e7d32" : room.TrangThai == QLKSan.Enums.RoomStatus.Occupied ? "#c62828" : room.TrangThai == QLKSan.Enums.RoomStatus.Booked ? "#1565c0" : room.TrangThai == QLKSan.Enums.RoomStatus.Maintenance ? "#6c757d" : "#f57f17")">
                                        <i class="fas @(room.TrangThai == QLKSan.Enums.RoomStatus.Available ? "fa-door-open" : room.TrangThai == QLKSan.Enums.RoomStatus.Occupied ? "fa-door-closed" : room.TrangThai == QLKSan.Enums.RoomStatus.Booked ? "fa-calendar-check" : room.TrangThai == QLKSan.Enums.RoomStatus.Maintenance ? "fa-tools" : "fa-broom") fs-4"></i>
                                    </div>
                                    <h4 class="fw-bold mb-0 text-navy" style="font-family:'Playfair Display', serif; font-size:1.5rem">@room.SoPhong</h4>
                                </div>
                                
                                <div class="mt-auto border-top pt-2">
                                    @if (room.TrangThai == QLKSan.Enums.RoomStatus.Occupied)
                                    {
                                        <div class="d-flex justify-content-center gap-2">
                                            <a href="@Url.Action("Index", "Service")?maPhong=@room.MaPhong" class="btn btn-sm btn-outline-navy flex-fill py-1" title="Thêm dịch vụ">
                                                <i class="fas fa-concierge-bell"></i>
                                            </a>
                                            <a href="@Url.Action("Process", "Checkout")?maPhong=@room.MaPhong" class="btn btn-sm btn-gold flex-fill py-1" title="Trả phòng">
                                                <i class="fas fa-file-invoice-dollar"></i>
                                            </a>
                                        </div>
                                    }
                                    else if (room.TrangThai == QLKSan.Enums.RoomStatus.Available)
                                    {
                                        <a asp-action="WalkIn" class="btn btn-sm btn-outline-success w-100 py-1" style="border-radius: 6px; font-weight: 500;">Check-In</a>
                                    }
                                    else 
                                    {
                                        <button class="btn btn-sm btn-light text-muted w-100 py-1" disabled style="border-radius: 6px;">Không khả dụng</button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <!-- Right: Online Bookings (Pending) -->
    <div class="col-lg-4">
        <div class="card p-0 h-100" style="overflow:hidden">
            <div class="p-4 border-bottom bg-light">
                <h6 class="fw-bold mb-0"><i class="fas fa-laptop me-2 text-gold"></i>Xử lý Đặt phòng Online</h6>
            </div>
            
            <div class="p-0">
                @if (onlineBookings != null && onlineBookings.Any())
                {
                    foreach (var booking in onlineBookings)
                    {
                        <div class="p-3 border-bottom hover-bg-light">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <strong class="text-navy">Phiếu #@booking.MaDatPhong</strong>
                                    <span class="badge @(booking.TrangThai == QLKSan.Enums.BookingStatus.Pending ? "bg-warning text-dark" : "bg-primary text-white") ms-2" style="font-size:0.7rem">
                                        @(booking.TrangThai == QLKSan.Enums.BookingStatus.Pending ? "Chờ duyệt" : "Đã duyệt")
                                    </span>
                                </div>
                            </div>
                            
                            <p class="mb-1 text-dark fw-semibold">
                                <i class="fas fa-user text-muted me-2"></i>Khách: @(booking.KhachHang?.Ho) @(booking.KhachHang?.Ten)
                            </p>
                            
                            <div class="d-flex justify-content-between small text-muted mb-3">
                                <span><i class="fas fa-sign-in-alt me-1"></i>@booking.NgayCheckInDuKien.ToString("dd/MM")</span>
                                <span><i class="fas fa-sign-out-alt me-1"></i>@booking.NgayCheckOutDuKien.ToString("dd/MM")</span>
                                <span><i class="fas fa-door-open me-1"></i>Phòng: @(booking.ChiTietDatPhongs?.FirstOrDefault()?.Phong?.SoPhong ?? "Chưa rõ")</span>
                            </div>

                            <div class="d-flex gap-2">
                                @if (booking.TrangThai == QLKSan.Enums.BookingStatus.Pending)
                                {
                                    <form asp-action="ApproveBooking" method="post" class="flex-fill">
                                        <input type="hidden" name="id" value="@booking.MaDatPhong" />
                                        <button type="submit" class="btn btn-sm btn-outline-primary w-100">
                                            <i class="fas fa-check me-1"></i>Duyệt
                                        </button>
                                    </form>
                                }
                                <form asp-action="CheckInOnlineBooking" method="post" class="flex-fill">
                                    <input type="hidden" name="id" value="@booking.MaDatPhong" />
                                    <button type="submit" class="btn btn-sm btn-gold w-100">
                                        <i class="fas fa-key me-1"></i>Nhận phòng
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="p-5 text-center text-muted">
                        <i class="fas fa-check-circle mb-3" style="font-size:2.5rem; opacity:0.3"></i>
                        <p>Không có yêu cầu chờ xử lý.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@{
    var bookings = ViewBag.Bookings as IEnumerable<QLKSan.Models.Entities.PhieuDatPhong>;
}

<div class="row mt-4">
    <div class="col-12">
        <div class="card p-0 mb-4 shadow-sm">
            <div class="d-flex justify-content-between align-items-center p-4 border-bottom flex-wrap gap-3" style="background: #fafafa">
                <div class="d-flex align-items-center gap-2">
                    <h6 class="fw-bold mb-0" style="letter-spacing:1px;color:#2A3B4C">
                        <i class="fas fa-history me-2 text-gold"></i>LỊCH SỬ ĐẶT PHÒNG HỆ THỐNG
                    </h6>
                    <span class="badge bg-light text-muted border py-1 px-2" style="font-size:0.75rem">Tổng số: @(bookings?.Count() ?? 0) giao dịch</span>
                </div>
                
                <div class="d-flex gap-2">
                    <form method="get" class="d-flex gap-2">
                        <input type="text" name="search" value="@ViewBag.Search" class="form-control" style="width:280px;font-size:0.85rem;border-color:#eaddc4" placeholder="Mã đơn, tên khách, số phòng...">
                        <button type="submit" class="btn-gold px-3 border-0 py-1" style="border-radius:4px;color:#fff;font-size:0.85rem">
                            <i class="fas fa-search"></i> Tìm kiếm
                        </button>
                        @if (!string.IsNullOrEmpty(ViewBag.Search as string))
                        {
                            <a href="@Url.Action("Index", "Reception")" class="btn btn-sm btn-outline-secondary d-flex align-items-center" style="border-radius:4px;font-size:0.85rem">Xóa lọc</a>
                        }
                    </form>
                </div>
            </div>
            
            <div class="table-responsive">
                <table class="table align-middle mb-0" style="border-collapse: separate; border-spacing: 0;">
                    <thead style="background:#fafafa">
                        <tr>
                            <th class="text-muted small fw-normal py-3 ps-4" style="font-size:0.7rem;letter-spacing:0.5px;width:120px">MÃ ĐƠN</th>
                            <th class="text-muted small fw-normal py-3" style="font-size:0.7rem;letter-spacing:0.5px">KHÁCH HÀNG</th>
                            <th class="text-muted small fw-normal py-3" style="font-size:0.7rem;letter-spacing:0.5px">PHÒNG NGHỈ</th>
                            <th class="text-muted small fw-normal py-3" style="font-size:0.7rem;letter-spacing:0.5px">NGÀY LƯU TRÚ</th>
                            <th class="text-muted small fw-normal py-3" style="font-size:0.7rem;letter-spacing:0.5px">TIỀN CỌC</th>
                            <th class="text-muted small fw-normal py-3" style="font-size:0.7rem;letter-spacing:0.5px">TRẠNG THÁI</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (bookings != null && bookings.Any())
                        {
                            foreach (var p in bookings)
                            {
                                var detail = p.ChiTietDatPhongs?.FirstOrDefault();
                                var room = detail?.Phong;
                                var customer = p.KhachHang;
                                var phone = customer?.LienHeDiaChis?.FirstOrDefault()?.SDT ?? "N/A";
                                
                                // Badge styling based on booking state
                                var badgeClass = "badge-status badge-available"; // default
                                var statusLabel = p.TrangThai.ToString();
                                
                                if (p.TrangThai == QLKSan.Enums.BookingStatus.Pending)
                                {
                                    badgeClass = "bg-warning text-dark border-0";
                                    statusLabel = "Chờ duyệt";
                                }
                                else if (p.TrangThai == QLKSan.Enums.BookingStatus.Approved)
                                {
                                    badgeClass = "bg-info text-white border-0";
                                    statusLabel = "Đã duyệt";
                                }
                                else if (p.TrangThai == QLKSan.Enums.BookingStatus.CheckedIn)
                                {
                                    badgeClass = "badge-status badge-occupied";
                                    statusLabel = "Đang ở";
                                }
                                else if (p.TrangThai == QLKSan.Enums.BookingStatus.CheckedOut || p.TrangThai == QLKSan.Enums.BookingStatus.Completed)
                                {
                                    badgeClass = "badge-status badge-available";
                                    statusLabel = "Hoàn thành";
                                }
                                else if (p.TrangThai == QLKSan.Enums.BookingStatus.Cancelled)
                                {
                                    badgeClass = "bg-danger text-white border-0";
                                    statusLabel = "Đã hủy";
                                }

                                <tr>
                                    <td class="ps-4 py-3">
                                        <strong class="text-navy" style="font-size:0.85rem">#@p.MaDatPhong</strong>
                                        <small class="d-block text-muted" style="font-size:0.65rem">Đặt: @p.NgayDat.ToString("dd/MM/yyyy")</small>
                                    </td>
                                    <td class="py-3">
                                        @if (customer != null)
                                        {
                                            <strong class="d-block text-navy" style="font-size:0.9rem">@customer.Ho @customer.Ten</strong>
                                            <small class="text-muted d-block" style="font-size:0.7rem">
                                                <i class="fas fa-id-card me-1"></i>CCCD: @customer.CCCD_Passport | <i class="fas fa-phone me-1"></i>SĐT: @phone
                                            </small>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Khách vãng lai</span>
                                        }
                                    </td>
                                    <td class="py-3">
                                        @if (room != null)
                                        {
                                            <strong class="d-block text-navy" style="font-size:0.9rem">Phòng @room.SoPhong</strong>
                                            <small class="text-gold" style="font-size:0.75rem">@(room.LoaiPhong?.TenLoai ?? "Premium Room")</small>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Chưa chỉ định</span>
                                        }
                                    </td>
                                    <td class="py-3">
                                        <div style="font-size:0.8rem">
                                            <span class="text-navy fw-semibold">Check-In:</span> @p.NgayCheckInDuKien.ToString("dd/MM/yyyy")
                                        </div>
                                        <div style="font-size:0.8rem">
                                            <span class="text-muted">Check-Out:</span> @p.NgayCheckOutDuKien.ToString("dd/MM/yyyy")
                                        </div>
                                    </td>
                                    <td class="py-3 font-monospace fw-bold text-navy" style="font-size:0.85rem">
                                        @p.TienCoc.ToString("N0") ₫
                                    </td>
                                    <td class="py-3">
                                        <span class="badge @badgeClass px-3 py-1" style="font-size:0.7rem;font-weight:600;letter-spacing:0.5px">
                                            @statusLabel.ToUpper()
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="fas fa-folder-open mb-3" style="font-size:2.5rem; opacity:0.3"></i>
                                    <p class="mb-0">Không tìm thấy lịch sử đặt phòng nào phù hợp.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .hover-shadow:hover { box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important; transform: translateY(-2px); }
    .transition-all { transition: all 0.2s ease-in-out; }
    .hover-bg-light:hover { background-color: #f8f9fa; }
    .badge-filter { cursor: pointer; opacity: 0.5; transition: all 0.2s ease; }
    .badge-filter:hover { opacity: 0.8; }
    .badge-filter.active { opacity: 1; box-shadow: 0 2px 8px rgba(0,0,0,0.15); transform: scale(1.05); }
    .badge-all { background: #2A3B4C; color: #fff; border: 1px solid #2A3B4C; }
    .room-card-wrapper { transition: all 0.3s ease; }
    .room-card-wrapper.hidden-by-filter { display: none !important; }
</style>

@section Scripts {
    <script>
        function filterRooms(status) {
            // Update active button
            document.querySelectorAll('.badge-filter').forEach(function(btn) {
                btn.classList.remove('active');
            });
            document.querySelector('.badge-filter[data-filter="' + status + '"]').classList.add('active');

            // Filter room cards
            document.querySelectorAll('.room-card-wrapper').forEach(function(card) {
                if (status === 'all') {
                    card.classList.remove('hidden-by-filter');
                } else {
                    if (card.getAttribute('data-status') === status) {
                        card.classList.remove('hidden-by-filter');
                    } else {
                        card.classList.add('hidden-by-filter');
                    }
                }
            });
        }
    </script>
}
