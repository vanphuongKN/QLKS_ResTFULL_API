@model QLKSan.Models.DTOs.FrontDeskTodayDto
@using QLKSan.Enums
@using QLKSan.Models.DTOs
<style>
    .rc-card { border: 1px solid #eae8e2; border-radius: 12px; padding: 12px; height: 100%; display: flex; flex-direction: column; background: #fff; transition: box-shadow .2s; }
    .rc-card:hover { box-shadow: 0 6px 18px rgba(0,0,0,.07); }
    .rc-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 6px; margin-bottom: 8px; }
    .rc-icon { width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: .8rem; }
    .rc-number { font-family: 'Cormorant Garamond', serif; font-size: 1.45rem; font-weight: 700; color: var(--navy); line-height: 1.1; }
    .rc-type { font-size: .68rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: .5px; font-weight: 600; margin-bottom: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .rc-guest { font-size: .76rem; color: var(--text-dark); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .rc-actions { margin-top: auto; padding-top: 10px; display: flex; gap: 6px; flex-wrap: wrap; }
    .rc-actions .btn { flex: 1 1 70px; font-size: .72rem; padding: 4px 6px; border-radius: 6px; text-transform: none; letter-spacing: 0; white-space: nowrap; }
    .rc-available .rc-icon { background: #e8f5e9; color: #2e7d32; }
    .rc-occupied .rc-icon { background: #ffebee; color: #c62828; }
    .rc-booked .rc-icon { background: #e3f2fd; color: #1565c0; }
    .rc-cleaning .rc-icon { background: #fff8e1; color: #f57f17; }
    .rc-maintenance .rc-icon { background: #f1f3f5; color: #6c757d; }
    .room-card-wrapper.hidden-by-filter { display: none !important; }
</style>
@{
    ViewData["Title"] = "Quầy lễ tân";
    var d = Model;
    var rooms = ViewBag.Rooms as IEnumerable<RoomDto> ?? Enumerable.Empty<RoomDto>();
    var thu = new[] { "Chủ nhật", "Thứ Hai", "Thứ Ba", "Thứ Tư", "Thứ Năm", "Thứ Sáu", "Thứ Bảy" };
    var quaHan = d.KhachDi.Count(k => k.QuaHanTra);

    (string Css, string Nhan, string Icon) Phong(RoomStatus t) => t switch
    {
        RoomStatus.Available => ("badge-available", "Trống", "fa-door-open"),
        RoomStatus.Occupied => ("badge-occupied", "Đang ở", "fa-bed"),
        RoomStatus.Booked => ("badge-booked", "Đã đặt", "fa-calendar-check"),
        RoomStatus.Maintenance => ("badge-maintenance", "Bảo trì", "fa-tools"),
        _ => ("badge-cleaning", "Đang dọn", "fa-broom")
    };

    var tabs = new[]
    {
        ("den", "Khách đến", d.KhachDen, "Không có khách đến hôm nay."),
        ("di", "Khách đi", d.KhachDi, "Không có khách trả phòng hôm nay."),
        ("dango", "Đang lưu trú", d.DangO, "Chưa có khách nào đang lưu trú."),
        ("sapden", "Sắp đến", d.SapDen, "Không có phiếu nào sắp đến.")
    };
    var viec = new[]
    {
        (d.PhieuChoDuyet, "Phiếu đặt chờ duyệt", "fa-hourglass-half", "#sapden", d.PhieuChoDuyet > 0 ? "warn" : ""),
        (quaHan, "Khách quá hạn trả phòng", "fa-clock", "#di", quaHan > 0 ? "danger" : ""),
        (d.SuCoBuongPhong, "Sự cố khi dọn phòng", "fa-triangle-exclamation", Url.Action("Tasks", "Housekeeping"), d.SuCoBuongPhong > 0 ? "danger" : ""),
        (d.PhongDangDon, "Phòng đang dọn", "fa-broom", Url.Action("Tasks", "Housekeeping"), ""),
        (d.ViecBuongPhongChuaXong, "Việc buồng phòng chưa xong", "fa-list-check", Url.Action("Tasks", "Housekeeping"), ""),
        (d.PhongBaoTri, "Phòng đang bảo trì", "fa-screwdriver-wrench", Url.Action("Status", "Room"), d.PhongBaoTri > 0 ? "danger" : "")
    };
}

@functions {
    // Lý do chưa nhận phòng được (phòng chưa sẵn sàng) — hiện cảnh báo và gợi ý đổi phòng
    static string PhongChuaSanSang(QLKSan.Models.DTOs.FrontDeskStayDto k) => k.TrangThaiPhong switch
    {
        QLKSan.Enums.RoomStatus.Cleaning => "Phòng đang dọn",
        QLKSan.Enums.RoomStatus.Occupied => "Phòng còn khách ở",
        QLKSan.Enums.RoomStatus.Maintenance => "Phòng đang bảo trì",
        _ => null
    };
}

@{
    // Một dòng phiếu: phòng | khách + thông tin chăm sóc | trạng thái + thao tác (theo danh sách)
    async Task StayRow(FrontDeskStayDto k, string tab)
    {
        var chuaNhan = k.TrangThai is BookingStatus.Pending or BookingStatus.Approved;
        var canhBaoPhong = chuaNhan && tab == "den" ? PhongChuaSanSang(k) : null;
        <div class="stay-row @(k.DaXuLy ? "is-done" : "") @(k.QuaHanTra ? "is-late" : "") @(k.HanChe ? "is-restricted" : "")">
            <div class="stay-room">
                <span class="stay-room-no">@(k.SoPhong ?? "—")</span>
                <small>@FormatHelper.TenHangPhong(k.TenLoaiPhong)</small>
            </div>
            <div class="stay-main">
                <div class="stay-guest">
                    @if (!string.IsNullOrEmpty(k.MaKhachHang))
                    {
                        <a asp-action="CustomerDetails" asp-route-id="@k.MaKhachHang">@k.HoTenKhachHang</a>
                    }
                    else { <span>@k.HoTenKhachHang</span> }
                    @if (k.LaVIP) { <span class="vip-badge"><i class="fas fa-crown me-1"></i>VIP</span> }
                    @if (k.HanChe) { <span class="restrict-badge" title="@k.LyDoHanChe"><i class="fas fa-ban me-1"></i>Hạn chế</span> }
                </div>
                <div class="stay-meta">
                    <span>#@k.MaDatPhong</span>
                    <span><i class="fas fa-calendar"></i>@k.NgayNhan.ToString("dd/MM") → @k.NgayTra.ToString("dd/MM") · @k.SoDem đêm</span>
                    <span><i class="fas fa-user-group"></i>@k.SoKhach khách</span>
                    @if (!string.IsNullOrEmpty(k.SDT)) { <span><i class="fas fa-phone"></i>@k.SDT</span> }
                </div>
                <div class="stay-notes">
                    @if (k.HanChe && !string.IsNullOrEmpty(k.LyDoHanChe)) { <span class="note-danger"><i class="fas fa-ban"></i>@k.LyDoHanChe</span> }
                    @if (!string.IsNullOrEmpty(k.GioDenDuKien) && chuaNhan) { <span><i class="fas fa-clock"></i>Đến @k.GioDenDuKien</span> }
                    @if (!string.IsNullOrEmpty(k.YeuCauDacBiet)) { <span class="note-gold" title="@k.YeuCauDacBiet"><i class="fas fa-comment-dots"></i>@k.YeuCauDacBiet</span> }
                    @if (!string.IsNullOrEmpty(k.SoThich)) { <span title="@k.SoThich"><i class="fas fa-heart"></i>@k.SoThich</span> }
                    @if (!string.IsNullOrEmpty(k.MaKhuyenMai)) { <span><i class="fas fa-tag"></i>@k.MaKhuyenMai</span> }
                    @if (k.TienCoc > 0) { <span><i class="fas fa-wallet"></i>Cọc @FormatHelper.ToVND(k.TienCoc)</span> }
                    @if (!string.IsNullOrEmpty(k.NguonDat) && k.NguonDat != BookingSources.Online) { <span class="note-source"><i class="fas fa-phone-volume"></i>@k.NguonDat</span> }
                    @if (canhBaoPhong != null) { <span class="note-danger"><i class="fas fa-triangle-exclamation"></i>@canhBaoPhong — đổi phòng khác hoặc chờ buồng phòng</span> }
                </div>
            </div>
            <div class="stay-actions">
                @if (tab == "den" && k.DaXuLy)
                {
                    <span class="badge-status badge-available">Đã nhận @k.NgayCheckInThucTe?.ToString("HH:mm")</span>
                }
                else if (tab == "di" && k.DaXuLy)
                {
                    <span class="badge-status badge-muted">Đã trả @k.NgayCheckOutThucTe?.ToString("HH:mm")</span>
                }
                else if (k.QuaHanTra)
                {
                    <span class="badge-status badge-occupied">Quá hạn trả</span>
                }
                else if (chuaNhan)
                {
                    <span class="badge-status @(k.TrangThai == BookingStatus.Pending ? "badge-pending" : "badge-booked")">@(k.TrangThai == BookingStatus.Pending ? "Chờ duyệt" : "Đã xác nhận")</span>
                }

                <div class="stay-btns">
                    @if (chuaNhan)
                    {
                        @if (k.TrangThai == BookingStatus.Pending)
                        {
                            <form asp-action="ApproveBooking" method="post">
                                <input type="hidden" name="id" value="@k.MaDatPhong" />
                                <button type="submit" class="btn btn-sm btn-outline-primary"><i class="fas fa-check me-1"></i>Duyệt</button>
                            </form>
                        }
                        @if (tab == "den")
                        {
                            <button type="button" class="btn btn-sm btn-gold" disabled="@(canhBaoPhong != null)" data-fd-modal="checkInModal"
                                    data-id="@k.MaDatPhong" data-ten="@k.HoTenKhachHang" data-phong="@k.SoPhong" data-sokhach="@k.SoKhach" data-coc="@k.TienCoc.ToString("0")"><i class="fas fa-key me-1"></i>Nhận phòng</button>
                        }
                        <a asp-action="ChangeRoom" asp-route-id="@k.MaDatPhong" class="btn btn-sm @(canhBaoPhong != null ? "btn-outline-danger" : "btn-outline-secondary")"><i class="fas fa-right-left me-1"></i>Đổi phòng</a>
                        <button type="button" class="btn btn-sm btn-outline-secondary" title="Thu cọc" data-fd-modal="depositModal" data-id="@k.MaDatPhong" data-ten="@k.HoTenKhachHang"><i class="fas fa-wallet"></i></button>
                        <button type="button" class="btn btn-sm btn-outline-danger" title="@(k.TrangThai == BookingStatus.Pending ? "Từ chối" : "Huỷ phiếu")" data-fd-modal="cancelModal"
                                data-id="@k.MaDatPhong" data-ten="@k.HoTenKhachHang" data-coc="@k.TienCoc.ToString("0")" data-tuchoi="@(k.TrangThai == BookingStatus.Pending ? "1" : "0")"><i class="fas fa-times"></i></button>
                    }
                    else if (k.TrangThai == BookingStatus.CheckedIn)
                    {
                        <a href="@Url.Action("Index", "Service", new { maPhong = k.MaPhong })" class="btn btn-sm btn-outline-navy"><i class="fas fa-mug-hot me-1"></i>Dịch vụ</a>
                        <a href="@Url.Action("Process", "Checkout", new { maPhong = k.MaPhong })" class="btn btn-sm @(tab == "di" ? "btn-gold" : "btn-outline-secondary")"><i class="fas fa-sign-out-alt me-1"></i>Trả phòng</a>
                    }
                </div>
            </div>
        </div>
    }
}

<div class="page-header">
    <div>
        <p class="page-label">Quầy lễ tân</p>
        <h2>@thu[(int)d.Ngay.DayOfWeek], @d.Ngay.ToString("dd/MM/yyyy")</h2>
        <p class="page-desc">Cập nhật lúc @d.NgayCapNhat.ToString("HH:mm") · @d.TongSoPhong phòng</p>
    </div>
    <div class="d-flex gap-2 flex-wrap align-items-center">
        <form method="get" class="fd-search" role="search">
            <input type="search" name="search" class="form-control form-control-sm" placeholder="Tìm phiếu đặt phòng…" title="Mã phiếu, tên khách hoặc số phòng" aria-label="Tìm phiếu đặt phòng" />
        </form>
        <a asp-action="NewBooking" class="btn btn-outline-gold"><i class="fas fa-calendar-plus me-2"></i>Đặt phòng</a>
        <a asp-action="WalkIn" class="btn-gold"><i class="fas fa-user-plus me-2"></i>Nhận khách vãng lai</a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success mb-3 d-flex justify-content-between align-items-center gap-2 flex-wrap">
        <span>@TempData["SuccessMessage"]</span>
        @if (TempData["PrintInvoiceId"] is string printId)
        {
            <a href="@Url.Action("Print", "Invoice", new { id = printId })" target="_blank" class="btn btn-sm btn-success"><i class="fas fa-print me-1"></i>In hoá đơn @printId</a>
        }
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger mb-3">@TempData["ErrorMessage"]</div>
}

<div class="kpi-grid mb-4">
    <a href="#den" class="kpi-card kpi-card--dark kpi-link" data-tab-link="den">
        <span class="kpi-label">Khách đến</span>
        <div class="kpi-value">@d.SoKhachDen</div>
        <span class="kpi-sub">Đã nhận @d.SoKhachDenDaNhan · còn @(d.SoKhachDen - d.SoKhachDenDaNhan)</span>
    </a>
    <a href="#di" class="kpi-card kpi-link" data-tab-link="di">
        <span class="kpi-label">Khách đi</span>
        <div class="kpi-value">@d.SoKhachDi</div>
        <span class="kpi-sub">Đã trả @d.SoKhachDiDaTra · còn @(d.SoKhachDi - d.SoKhachDiDaTra)@(quaHan > 0 ? $" · {quaHan} quá hạn" : "")</span>
    </a>
    <a href="#dango" class="kpi-card kpi-link" data-tab-link="dango">
        <span class="kpi-label">Đang lưu trú</span>
        <div class="kpi-value">@d.DangO.Count</div>
        <span class="kpi-sub">@d.PhongCoKhach / @d.TongSoPhong phòng có khách</span>
    </a>
    <a href="#rooms" class="kpi-card kpi-link">
        <span class="kpi-label">Trống tối nay</span>
        <div class="kpi-value">@d.PhongTrong</div>
        <span class="kpi-sub">Đang dọn @d.PhongDangDon · bảo trì @d.PhongBaoTri</span>
    </a>
</div>

<div class="row g-4 mb-4">
    <div class="col-xl-8">
        <div class="card h-100">
            <div class="fd-tabs" role="tablist">
                @foreach (var (key, ten, ds, _) in tabs)
                {
                    <button type="button" role="tab" data-tab="@key" aria-controls="tab-@key">@ten <span>@ds.Count</span></button>
                }
            </div>
            @foreach (var (key, _, ds, rong) in tabs)
            {
                <div class="fd-panel" id="tab-@key" role="tabpanel" data-panel="@key" hidden>
                    @if (!ds.Any())
                    {
                        <p class="text-muted small p-4 mb-0">@rong</p>
                    }
                    else if (key == "sapden")
                    {
                        foreach (var g in ds.GroupBy(x => x.NgayNhan.Date))
                        {
                            <div class="stay-day">@thu[(int)g.Key.DayOfWeek], @g.Key.ToString("dd/MM/yyyy") <span>@g.Count() phiếu</span></div>
                            foreach (var k in g) { await StayRow(k, key); }
                        }
                    }
                    else
                    {
                        foreach (var k in ds) { await StayRow(k, key); }
                    }
                </div>
            }
        </div>
    </div>

    <div class="col-xl-4">
        <div class="card p-4 mb-4">
            <h6 class="dash-title mb-3">Việc cần làm</h6>
            <div class="task-list">
                @foreach (var (so, ten, icon, url, muc) in viec)
                {
                    <a href="@url" class="task-row @(so == 0 ? "is-zero" : muc)" data-tab-link="@(url.StartsWith("#") ? url.Substring(1) : null)">
                        <i class="fas @icon"></i><span>@ten</span><strong>@so</strong>
                    </a>
                }
            </div>
        </div>
        <div class="card p-4">
            <h6 class="dash-title mb-3">Tra cứu nhanh</h6>
            <div class="fd-links">
                <a asp-controller="Room" asp-action="Timeline"><i class="fas fa-stream"></i>Lịch phòng</a>
                <a asp-action="BookingHistory"><i class="fas fa-history"></i>Lịch sử đặt phòng</a>
                <a asp-action="Customers"><i class="fas fa-users"></i>Khách hàng</a>
                <a asp-controller="Room" asp-action="Guests"><i class="fas fa-id-card"></i>Sổ lưu trú</a>
            </div>
        </div>
    </div>
</div>

<div class="card p-4" id="rooms">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <h6 class="dash-title mb-0">Sơ đồ phòng</h6>
        <div class="filter-chips" id="roomStatusFilters">
            <button type="button" class="active" data-filter="all">Tất cả <span>@rooms.Count()</span></button>
            @foreach (var t in new[] { RoomStatus.Available, RoomStatus.Occupied, RoomStatus.Cleaning, RoomStatus.Booked, RoomStatus.Maintenance })
            {
                <button type="button" data-filter="@t">@Phong(t).Nhan <span>@rooms.Count(r => r.TrangThai == t)</span></button>
            }
        </div>
    </div>
    <div class="row g-3">
        @foreach (var room in rooms)
        {
            var p = Phong(room.TrangThai);
            <div class="col-xxl-2 col-xl-3 col-md-4 col-6 room-card-wrapper" data-status="@room.TrangThai">
                <div class="rc-card rc-@room.TrangThai.ToString().ToLower()">
                    <div class="rc-top">
                        <div class="rc-icon"><i class="fas @p.Icon"></i></div>
                        <span class="badge-status @p.Css">@p.Nhan</span>
                    </div>
                    <div class="rc-number">@room.SoPhong</div>
                    <div class="rc-type">@FormatHelper.TenHangPhong(room.LoaiPhong?.TenLoai)</div>
                    @if (room.TrangThai == RoomStatus.Occupied && room.DangLuuTru != null)
                    {
                        <div class="rc-guest" title="@room.DangLuuTru.KhachHang?.HoTen"><i class="fas fa-user me-1"></i>@room.DangLuuTru.KhachHang?.HoTen</div>
                    }
                    else if (room.DatPhongHienTai != null)
                    {
                        <div class="rc-guest"><i class="fas fa-sign-in-alt me-1"></i>Khách đến @room.DatPhongHienTai.NgayCheckInDuKien.ToString("dd/MM")</div>
                    }
                    <div class="rc-actions">
                        @if (room.TrangThai == RoomStatus.Occupied)
                        {
                            <a href="@Url.Action("Index", "Service", new { maPhong = room.MaPhong })" class="btn btn-sm btn-outline-navy">Dịch vụ</a>
                            <a href="@Url.Action("Process", "Checkout", new { maPhong = room.MaPhong })" class="btn btn-sm btn-gold">Trả phòng</a>
                        }
                        else if (room.TrangThai == RoomStatus.Available)
                        {
                            <a href="@Url.Action("WalkIn", new { maPhong = room.MaPhong })" class="btn btn-sm btn-outline-success">Nhận khách</a>
                        }
                        else
                        {
                            <a href="@Url.Action("Details", "Room", new { id = room.MaPhong })" class="btn btn-sm btn-light text-muted">Chi tiết</a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Hộp thoại quầy: nhận phòng (số khách thực tế, cọc thêm), thu cọc, huỷ / từ chối (lý do, hoàn cọc) -->
<div class="modal fade fd-modal" id="checkInModal" tabindex="-1" aria-labelledby="ciTitle">
    <div class="modal-dialog">
        <form asp-action="CheckInOnlineBooking" method="post" class="modal-content">
            <div class="modal-header"><h5 class="modal-title fw-bold" id="ciTitle">Nhận phòng</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div>
            <div class="modal-body">
                <input type="hidden" name="id" data-field="id" />
                <p class="mb-3" data-field="tieuDe"></p>
                <div class="row g-3">
                    <div class="col-4">
                        <label class="form-label fw-semibold" for="ciSoKhach">Số khách</label>
                        <input type="number" name="soLuongKhach" id="ciSoKhach" class="form-control" min="1" max="10" data-field="sokhach" />
                    </div>
                    <div class="col-8">
                        <label class="form-label fw-semibold" for="ciCoc">Thu thêm cọc / đảm bảo</label>
                        <div class="input-group">
                            <input type="number" name="tienCoc" id="ciCoc" class="form-control" min="0" step="1000" value="0" />
                            <select name="phuongThucCoc" class="form-select" aria-label="Phương thức">
                                @foreach (var pt in PaymentMethods.TaiQuay) { <option>@pt</option> }
                            </select>
                        </div>
                    </div>
                </div>
                <small class="text-muted d-block mt-2" data-field="cocHienCo"></small>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Đóng</button><button type="submit" class="btn-gold"><i class="fas fa-key me-1"></i>Xác nhận nhận phòng</button></div>
        </form>
    </div>
</div>
<div class="modal fade fd-modal" id="depositModal" tabindex="-1" aria-labelledby="dpTitle">
    <div class="modal-dialog">
        <form asp-action="AddDeposit" method="post" class="modal-content">
            <div class="modal-header"><h5 class="modal-title fw-bold" id="dpTitle">Thu tiền cọc</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div>
            <div class="modal-body">
                <input type="hidden" name="id" data-field="id" />
                <p class="mb-3" data-field="tieuDe"></p>
                <div class="row g-3">
                    <div class="col-7"><label class="form-label fw-semibold" for="dpSoTien">Số tiền</label><input type="number" name="soTien" id="dpSoTien" class="form-control" min="1000" step="1000" required /></div>
                    <div class="col-5"><label class="form-label fw-semibold" for="dpPt">Phương thức</label><select name="phuongThuc" id="dpPt" class="form-select">@foreach (var pt in PaymentMethods.TaiQuay) { <option>@pt</option> }</select></div>
                    <div class="col-12"><label class="form-label fw-semibold" for="dpGhiChu">Ghi chú</label><input name="ghiChu" id="dpGhiChu" class="form-control" maxlength="255" placeholder="VD: Đảm bảo phát sinh minibar" /></div>
                </div>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Đóng</button><button type="submit" class="btn-gold">Thu cọc</button></div>
        </form>
    </div>
</div>
<div class="modal fade fd-modal" id="cancelModal" tabindex="-1" aria-labelledby="cnTitle">
    <div class="modal-dialog">
        <form asp-action="CancelBooking" method="post" class="modal-content">
            <div class="modal-header"><h5 class="modal-title fw-bold" id="cnTitle">Huỷ phiếu đặt phòng</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div>
            <div class="modal-body">
                <input type="hidden" name="id" data-field="id" />
                <p class="mb-3" data-field="tieuDe"></p>
                <label class="form-label fw-semibold" for="cnLyDo">Lý do</label>
                <textarea name="lyDo" id="cnLyDo" class="form-control" rows="2" maxlength="200" required></textarea>
                <div class="form-check mt-3" data-field="hoanCocBox" hidden>
                    <input class="form-check-input" type="checkbox" name="hoanCoc" value="true" id="cnHoanCoc" />
                    <label class="form-check-label" for="cnHoanCoc" data-field="hoanCocText"></label>
                    <small class="d-block text-muted">Không chọn: giữ cọc theo chính sách huỷ (ghi chú vào phiếu).</small>
                </div>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Đóng</button><button type="submit" class="btn btn-danger">Xác nhận</button></div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            // Mở hộp thoại quầy, điền dữ liệu của phiếu từ data-* của nút
            var vnd = function (v) { return new Intl.NumberFormat('vi-VN').format(v) + ' ₫'; };
            document.querySelectorAll('[data-fd-modal]').forEach(function (b) {
                b.addEventListener('click', function () {
                    var m = document.getElementById(b.getAttribute('data-fd-modal'));
                    var f = function (name) { return m.querySelector('[data-field="' + name + '"]'); };
                    var coc = parseInt(b.getAttribute('data-coc') || '0', 10);
                    f('id').value = b.getAttribute('data-id');
                    f('tieuDe').textContent = '#' + b.getAttribute('data-id') + ' · ' + b.getAttribute('data-ten') + (b.getAttribute('data-phong') ? ' · phòng ' + b.getAttribute('data-phong') : '');
                    if (f('sokhach')) f('sokhach').value = b.getAttribute('data-sokhach');
                    if (f('cocHienCo')) f('cocHienCo').textContent = coc > 0 ? 'Đã thu cọc ' + vnd(coc) + '.' : 'Phiếu chưa có tiền cọc.';
                    if (f('hoanCocBox')) {
                        f('hoanCocBox').hidden = coc <= 0;
                        m.querySelector('[name=hoanCoc]').checked = false;
                        f('hoanCocText').textContent = 'Hoàn lại tiền cọc ' + vnd(coc);
                        m.querySelector('.modal-title').textContent = b.getAttribute('data-tuchoi') === '1' ? 'Từ chối phiếu đặt phòng' : 'Huỷ phiếu đặt phòng';
                    }
                    bootstrap.Modal.getOrCreateInstance(m).show();
                });
            });
        })();

        (function () {
            // Thẻ danh sách: nhớ thẻ đang xem (theo trình duyệt), hỗ trợ #den / #di / #dango / #sapden
            var KEY = 'fd-tab';
            function show(tab) {
                var ok = false;
                document.querySelectorAll('.fd-tabs [data-tab]').forEach(function (b) {
                    var on = b.getAttribute('data-tab') === tab;
                    ok = ok || on;
                    b.classList.toggle('active', on);
                    b.setAttribute('aria-selected', on);
                });
                if (!ok) return false;
                document.querySelectorAll('[data-panel]').forEach(function (p) { p.hidden = p.getAttribute('data-panel') !== tab; });
                try { localStorage.setItem(KEY, tab); } catch (e) { }
                return true;
            }
            document.querySelectorAll('.fd-tabs [data-tab]').forEach(function (b) {
                b.addEventListener('click', function () { show(b.getAttribute('data-tab')); });
            });
            document.querySelectorAll('[data-tab-link]').forEach(function (a) {
                var tab = a.getAttribute('data-tab-link');
                if (!tab) return;
                a.addEventListener('click', function (e) {
                    e.preventDefault();
                    show(tab);
                    document.querySelector('.fd-tabs').scrollIntoView({ behavior: 'smooth', block: 'start' });
                });
            });
            var start = location.hash.substring(1), saved = null;
            try { saved = localStorage.getItem(KEY); } catch (e) { }
            if (!show(start) && !show(saved)) show('den');

            // Lọc sơ đồ phòng theo trạng thái
            document.querySelectorAll('#roomStatusFilters [data-filter]').forEach(function (b) {
                b.addEventListener('click', function () {
                    var f = b.getAttribute('data-filter');
                    document.querySelectorAll('#roomStatusFilters [data-filter]').forEach(function (x) { x.classList.toggle('active', x === b); });
                    document.querySelectorAll('.room-card-wrapper').forEach(function (c) {
                        c.classList.toggle('hidden-by-filter', f !== 'all' && c.getAttribute('data-status') !== f);
                    });
                });
            });
        })();

    </script>
}
