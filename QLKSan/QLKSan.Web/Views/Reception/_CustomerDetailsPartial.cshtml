@model QLKSan.Models.DTOs.CustomerDetailDto
@{
    var contact = Model.LienHeDiaChis?.FirstOrDefault();
    var phone = contact?.SDT ?? "Chưa cập nhật";
    var email = contact?.Email ?? "Chưa cập nhật";
    var address = contact?.DiaChi ?? "Chưa cập nhật";
    var country = contact?.QuocGia ?? "Việt Nam";
    var bookingCount = Model.PhieuDatPhongs?.Count() ?? 0;
    
    // Dynamic membership ranking
    int currentPoints = Model.DiemTichLuy;
    string memberTier = "Thành viên Đồng";
    string tierIcon = "fa-medal";
    string badgeClass = "bg-secondary text-white";
    
    if (currentPoints >= 5000)
    {
        memberTier = "Thành viên Kim Cương";
        tierIcon = "fa-gem";
        badgeClass = "bg-primary text-white";
    }
    else if (currentPoints >= 3000)
    {
        memberTier = "Thành viên Vàng";
        tierIcon = "fa-crown";
        badgeClass = "bg-warning text-dark";
    }
    else if (currentPoints >= 1000)
    {
        memberTier = "Thành viên Bạc";
        tierIcon = "fa-award";
        badgeClass = "bg-light text-dark border border-secondary";
    }
}

<style>
    .details-avatar-circle {
        width: 80px;
        height: 80px;
        background: #f5eedc;
        color: #C5A059;
        font-weight: bold;
        font-size: 2.2rem;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 3px solid #C5A059;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }
    .profile-card-header {
        background: linear-gradient(135deg, #2A3B4C 0%, #1A2530 100%);
        border-radius: 8px;
        padding: 24px;
        color: #fff;
        margin-bottom: 20px;
    }
    .timeline-stay-item {
        border-left: 2px solid #eaddc4;
        padding-left: 20px;
        position: relative;
        margin-bottom: 20px;
    }
    .timeline-stay-item::before {
        content: '';
        width: 12px;
        height: 12px;
        background: #C5A059;
        border-radius: 50%;
        position: absolute;
        left: -7px;
        top: 4px;
        box-shadow: 0 0 0 3px #fff;
    }
    .info-list i {
        width: 24px;
        color: #C5A059;
    }
    .stays-container {
        max-height: 350px;
        overflow-y: auto;
        padding-right: 8px;
    }
    .stays-container::-webkit-scrollbar {
        width: 6px;
    }
    .stays-container::-webkit-scrollbar-thumb {
        background-color: #eaddc4;
        border-radius: 4px;
    }
</style>

<div class="row">
    <!-- Cột Trái: Hồ Sơ Cá Nhân -->
    <div class="col-md-5 border-end pe-md-4">
        <div class="profile-card-header text-center">
            <div class="d-flex justify-content-center mb-3">
                <div class="details-avatar-circle rounded-circle">
                    @Model.Ten.Substring(0, Math.Min(1, Model.Ten.Length)).ToUpper()
                </div>
            </div>
            <h4 class="fw-bold mb-1">@Model.Ho @Model.Ten</h4>
            <p class="text-muted small mb-2" style="color: #eaddc4 !important">Mã hồ sơ: #@Model.MaKhachHang</p>
            <span class="badge @badgeClass px-3 py-2 rounded-pill fw-bold" style="font-size:0.8rem">
                <i class="fas @tierIcon me-1"></i> @memberTier.ToUpper()
            </span>
        </div>

        <h6 class="fw-bold text-navy mb-3"><i class="fas fa-id-card me-2"></i>THÔNG TIN CÁ NHÂN</h6>
        <div class="info-list text-muted small d-flex flex-column gap-3 mb-4">
            <div class="d-flex align-items-center">
                <i class="fas fa-passport" title="CCCD / Passport"></i>
                <div>
                    <span class="d-block text-muted" style="font-size: 0.7rem">CCCD / PASSPORT</span>
                    <strong class="text-dark" style="font-size: 0.9rem">@Model.CCCD_Passport</strong>
                </div>
            </div>
            <div class="d-flex align-items-center">
                <i class="fas fa-phone" title="Điện thoại"></i>
                <div>
                    <span class="d-block text-muted" style="font-size: 0.7rem">ĐIỆN THOẠI</span>
                    <strong class="text-dark" style="font-size: 0.9rem">@phone</strong>
                </div>
            </div>
            <div class="d-flex align-items-center">
                <i class="fas fa-envelope" title="Email"></i>
                <div>
                    <span class="d-block text-muted" style="font-size: 0.7rem">EMAIL</span>
                    <strong class="text-dark" style="font-size: 0.85rem">@email</strong>
                </div>
            </div>
            <div class="d-flex align-items-center">
                <i class="fas fa-birthday-cake" title="Ngày sinh"></i>
                <div>
                    <span class="d-block text-muted" style="font-size: 0.7rem">NGÀY SINH</span>
                    <strong class="text-dark" style="font-size: 0.85rem">@Model.NgaySinh.ToString("dd/MM/yyyy")</strong>
                </div>
            </div>
            <div class="d-flex align-items-center">
                <i class="fas fa-map-marker-alt" title="Địa chỉ"></i>
                <div>
                    <span class="d-block text-muted" style="font-size: 0.7rem">ĐỊA CHỈ</span>
                    <strong class="text-dark" style="font-size: 0.85rem">@address, @country</strong>
                </div>
            </div>
            <div class="d-flex align-items-center">
                <i class="fas fa-star" title="Điểm tích lũy"></i>
                <div>
                    <span class="d-block text-muted" style="font-size: 0.7rem">ĐIỂM TÍCH LŨY</span>
                    <strong class="text-gold" style="font-size: 0.9rem">@Model.DiemTichLuy điểm</strong>
                </div>
            </div>
        </div>
    </div>

    <!-- Cột Phải: Lịch Sử Kỳ Nghỉ / Đặt Phòng -->
    <div class="col-md-7 ps-md-4 mt-4 mt-md-0">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="fw-bold text-navy mb-0"><i class="fas fa-history me-2"></i>LỊCH SỬ KỲ NGHỈ</h6>
            <span class="badge bg-light text-muted border px-2 py-1" style="font-size:0.75rem">@bookingCount chuyến đi</span>
        </div>

        <div class="stays-container">
            @if (Model.PhieuDatPhongs != null && Model.PhieuDatPhongs.Any())
            {
                var sortedBookings = Model.PhieuDatPhongs.OrderByDescending(b => b.NgayDat);
                foreach (var b in sortedBookings)
                {
                    var detail = b.ChiTietDatPhongs?.FirstOrDefault();
                    var room = detail?.Phong;
                    
                    var statusBadgeClass = "badge-status badge-available";
                    var statusLabel = b.TrangThai.ToString();
                    
                    if (b.TrangThai == QLKSan.Enums.BookingStatus.Pending)
                    {
                        statusBadgeClass = "badge-status badge-pending";
                        statusLabel = "Chờ duyệt";
                    }
                    else if (b.TrangThai == QLKSan.Enums.BookingStatus.Approved)
                    {
                        statusBadgeClass = "badge-status badge-booked";
                        statusLabel = "Đã duyệt";
                    }
                    else if (b.TrangThai == QLKSan.Enums.BookingStatus.CheckedIn)
                    {
                        statusBadgeClass = "badge-status badge-occupied";
                        statusLabel = "Đang ở";
                    }
                    else if (b.TrangThai == QLKSan.Enums.BookingStatus.CheckedOut || b.TrangThai == QLKSan.Enums.BookingStatus.Completed)
                    {
                        statusBadgeClass = "badge-status badge-available";
                        statusLabel = "Hoàn thành";
                    }
                    else if (b.TrangThai == QLKSan.Enums.BookingStatus.Cancelled)
                    {
                        statusBadgeClass = "badge-status badge-muted";
                        statusLabel = "Đã hủy";
                    }

                    <div class="timeline-stay-item">
                        <div class="d-flex justify-content-between align-items-start flex-wrap">
                            <div>
                                <strong class="text-navy" style="font-size:0.9rem">Đơn đặt #@b.MaDatPhong</strong>
                                @if (room != null)
                                {
                                    <span class="d-block text-gold fw-semibold" style="font-size:0.8rem">
                                        Phòng @room.SoPhong (@(room.LoaiPhong?.TenLoai ?? "Premium Room"))
                                    </span>
                                }
                                else
                                {
                                    <span class="d-block text-muted italic" style="font-size:0.8rem">Chưa chỉ định phòng</span>
                                }
                            </div>
                            <span class="badge @statusBadgeClass px-2 py-1" style="font-size:0.65rem">
                                @statusLabel.ToUpper()
                            </span>
                        </div>
                        <div class="text-muted mt-1" style="font-size:0.75rem">
                            <span class="me-3"><i class="far fa-calendar-alt me-1 text-gold"></i>@b.NgayCheckInDuKien.ToString("dd/MM/yyyy") - @b.NgayCheckOutDuKien.ToString("dd/MM/yyyy")</span>
                            <span><i class="fas fa-coins me-1 text-gold"></i>Cọc: @b.TienCoc.ToString("N0") ₫</span>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <i class="fas fa-history mb-3" style="font-size:2.5rem; opacity:0.3"></i>
                    <p class="mb-0">Khách hàng này chưa có lịch sử đặt phòng.</p>
                </div>
            }
        </div>
    </div>
</div>
