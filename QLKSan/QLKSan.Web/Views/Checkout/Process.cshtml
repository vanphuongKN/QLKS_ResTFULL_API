@{
    ViewData["Title"] = "Trả phòng khách hàng";
    var booking = ViewBag.Booking as QLKSan.Models.DTOs.BookingDto;
    var invoice = ViewBag.Invoice as QLKSan.Models.DTOs.InvoiceDto;
    var customer = ViewBag.Customer as QLKSan.Models.DTOs.CustomerDto;
    var tv = customer?.ThanhVien;
    var folio = ViewBag.Folio as QLKSan.Models.DTOs.FolioDto;
}

<div class="page-header">
    <div>
        <h2>Trả phòng khách hàng</h2>
        <p class="page-desc">Quản lý thanh toán cuối cùng và quy trình rời phòng.</p>
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success mt-2">@TempData["SuccessMessage"]</div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger mt-2">@TempData["ErrorMessage"]</div>
        }
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">

        @if (booking != null && folio != null)
        {
            var thu = new[] { "CN", "T2", "T3", "T4", "T5", "T6", "T7" };
            <div class="card p-4 mb-4">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
                    <div>
                        <p class="page-label mb-1">Bảng kê lưu trú</p>
                        <h5 class="text-navy fw-bold mb-1">@folio.HoTenKhachHang</h5>
                        <div class="small text-muted">#@folio.MaDatPhong · Phòng @folio.SoPhong (@FormatHelper.TenHangPhong(folio.TenLoaiPhong)) · CCCD @booking.KhachHang.CCCD_Passport</div>
                    </div>
                    <span class="badge-status @(folio.TrangThaiHoaDon == QLKSan.Enums.InvoiceStatus.Paid ? "badge-muted" : "badge-available")">@(folio.TrangThaiHoaDon == QLKSan.Enums.InvoiceStatus.Paid ? "ĐÃ THANH TOÁN" : "ĐANG LƯU TRÚ")</span>
                </div>
                <div class="folio-meta">
                    <div><span>Nhận phòng</span><strong>@folio.NgayNhan.ToString("HH:mm dd/MM/yyyy")</strong></div>
                    <div><span>Trả dự kiến</span><strong>@folio.NgayTraDuKien.ToString("dd/MM/yyyy")</strong></div>
                    <div><span>Tính tới</span><strong>@folio.ThoiDiemTinh.ToString("HH:mm dd/MM/yyyy")</strong></div>
                    <div><span>Số khách</span><strong>@booking.SoLuongKhach@(booking.KhachDiCungs.Count > 0 ? $" ({booking.KhachDiCungs.Count} người đi cùng)" : "")</strong></div>
                </div>

                <h6 class="ledger-label mt-4 mb-2">Tiền phòng từng đêm</h6>
                <table class="table table-custom folio-table mb-0" data-no-tools>
                    <thead><tr><th>Đêm</th><th>Ghi chú</th><th class="text-end">Giá</th></tr></thead>
                    <tbody>
                        @foreach (var n in folio.CacDem)
                        {
                            <tr>
                                <td>@thu[(int)n.Dem.DayOfWeek], @n.Dem.ToString("dd/MM")</td>
                                <td class="small text-muted">@(string.IsNullOrEmpty(n.QuyTac) ? "Giá niêm yết" : $"{n.QuyTac} ({(n.PhanTramDieuChinh > 0 ? "+" : "")}{n.PhanTramDieuChinh:0.#}%)")</td>
                                <td class="text-end">@n.Gia.ToString("N0") ₫</td>
                            </tr>
                        }
                        @if (folio.PhuThuTraMuon > 0)
                        {
                            <tr class="text-danger"><td>Phụ thu</td><td class="small">Trả phòng muộn (@folio.PhanTramPhuThu% giá 1 đêm)</td><td class="text-end">@folio.PhuThuTraMuon.ToString("N0") ₫</td></tr>
                        }
                    </tbody>
                    <tfoot><tr><td colspan="2">Cộng tiền phòng (@folio.SoDem đêm)</td><td class="text-end">@((folio.TienPhong + folio.PhuThuTraMuon).ToString("N0")) ₫</td></tr></tfoot>
                </table>

                <h6 class="ledger-label mt-4 mb-2">Dịch vụ đã sử dụng</h6>
                <table class="table table-custom folio-table mb-0" data-no-tools>
                    <thead><tr><th>Dịch vụ</th><th>Thời gian</th><th class="text-center">SL</th><th class="text-end">Thành tiền</th></tr></thead>
                    <tbody>
                        @if (!folio.DichVu.Any())
                        {
                            <tr><td colspan="4" class="text-center text-muted">Không sử dụng dịch vụ phát sinh.</td></tr>
                        }
                        @foreach (var sv in folio.DichVu)
                        {
                            <tr><td>@sv.TenDichVu</td><td class="small text-muted">@sv.NgaySuDung.ToString("HH:mm dd/MM")</td><td class="text-center">@sv.SoLuong</td><td class="text-end">@sv.ThanhTien.ToString("N0") ₫</td></tr>
                        }
                    </tbody>
                    <tfoot><tr><td colspan="3">Cộng dịch vụ</td><td class="text-end">@folio.TongTienDichVu.ToString("N0") ₫</td></tr></tfoot>
                </table>

                <div class="folio-sum mt-4">
                    @if (folio.GiamGiaKhuyenMai > 0) { <div class="text-success"><span>Khuyến mãi @folio.MaKhuyenMai</span><strong>-@folio.GiamGiaKhuyenMai.ToString("N0") ₫</strong></div> }
                    @if (folio.GiamGiaThanhVien > 0) { <div class="text-success"><span>Ưu đãi @folio.HangThanhVien</span><strong>-@folio.GiamGiaThanhVien.ToString("N0") ₫</strong></div> }
                    <div><span>Cộng trước thuế</span><strong>@folio.TienTruocThue.ToString("N0") ₫</strong></div>
                    <div><span>Thuế VAT (8%)</span><strong>@folio.ThueVAT.ToString("N0") ₫</strong></div>
                    <div class="is-total"><span>Tổng cộng</span><strong>@folio.TongCong.ToString("N0") ₫</strong></div>
                    @foreach (var g in folio.GiaoDichCocs)
                    {
                        var hoan = g.LoaiGiaoDich == QLKSan.Enums.PaymentType.Refund;
                        <div class="small @(hoan ? "text-danger" : "text-muted")"><span>@(hoan ? "Hoàn cọc" : "Cọc") @g.ThoiGian.ToString("dd/MM HH:mm") · @g.PhuongThuc@(string.IsNullOrEmpty(g.GhiChu) ? "" : " · " + g.GhiChu)</span><strong>@(hoan ? "+" : "-")@g.SoTien.ToString("N0") ₫</strong></div>
                    }
                    @foreach (var t in folio.ThanhToans)
                    {
                        <div class="small text-muted"><span>Đã thu @t.NgayThanhToan.ToString("dd/MM HH:mm") · @t.PhuongThuc@(string.IsNullOrEmpty(t.GhiChu) ? "" : " · " + t.GhiChu)</span><strong>-@t.SoTienDaTra.ToString("N0") ₫</strong></div>
                    }
                    @if (folio.TrangThaiHoaDon != QLKSan.Enums.InvoiceStatus.Paid)
                    {
                        <div class="is-due"><span>@(folio.ConPhaiThu >= 0 ? "Còn phải thu (tạm tính)" : "Cọc thừa — hoàn lại khách")</span><strong>@Math.Abs(folio.ConPhaiThu).ToString("N0") ₫</strong></div>
                    }
                </div>

                @if (folio.LichSuDoiPhongs.Any())
                {
                    <div class="small text-muted mt-3">
                        @foreach (var mv in folio.LichSuDoiPhongs)
                        {
                            <div><i class="fas fa-right-left me-1"></i>@mv.ThoiGian.ToString("dd/MM HH:mm"): đổi phòng @mv.SoPhongCu → @mv.SoPhongMoi (@mv.LyDo)@(mv.GiaMoi == mv.GiaCu ? ", giữ giá cũ" : "")</div>
                        }
                    </div>
                }
            </div>
        }
    </div>

    <!-- Right: Stats + Ledger + Quick Actions -->
    <div class="col-lg-4">
        @if (invoice != null)
        {
            <!-- Daily Ledger with Invoice details -->
            <div class="ledger-panel mb-4">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Hóa Đơn Cuối (#@invoice.MaHoaDon)</h5>
                    <a href="@Url.Action("Print", "Invoice", new { id = invoice.MaHoaDon })" target="_blank" class="btn btn-sm btn-outline-secondary" title="In phiếu tạm tính"><i class="fas fa-print"></i></a>
                </div>
                
                <div class="d-flex justify-content-between mb-2 mt-4">
                    <span class="text-muted">Tiền phòng (@invoice.SoDem đêm thực tế)</span>
                    <strong>@invoice.TongTienPhong.ToString("N0") ₫</strong>
                </div>
                @if (invoice.TienPhat > 0)
                {
                    <div class="d-flex justify-content-between mb-2 text-danger">
                        <span>Phụ thu trả phòng muộn (@invoice.PhanTramPhuThu%)</span>
                        <strong>@invoice.TienPhat.ToString("N0") ₫</strong>
                    </div>
                }
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Tiền dịch vụ</span>
                    <strong>@invoice.TongTienDichVu.ToString("N0") ₫</strong>
                </div>
                @if (invoice.GiamGiaKhuyenMai > 0)
                {
                    <div class="d-flex justify-content-between mb-2 text-success">
                        <span class="text-muted text-success">Khuyến mãi @(string.IsNullOrEmpty(invoice.MaKhuyenMai) ? "" : $"({invoice.MaKhuyenMai})")</span>
                        <strong class="text-success">-@invoice.GiamGiaKhuyenMai.ToString("N0") ₫</strong>
                    </div>
                }
                @if (invoice.GiamGiaThanhVien > 0)
                {
                    <div class="d-flex justify-content-between mb-2 text-success">
                        <span class="text-success">Ưu đãi @invoice.HangThanhVien</span>
                        <strong class="text-success">-@invoice.GiamGiaThanhVien.ToString("N0") ₫</strong>
                    </div>
                }
                <div class="d-flex justify-content-between mb-3">
                    <span class="text-muted">Thuế VAT (8%)</span>
                    <strong>@invoice.ThueVAT.ToString("N0") ₫</strong>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Tổng giá trị hoá đơn</span>
                    <strong>@invoice.TongTienCanThanhToan.ToString("N0") ₫</strong>
                </div>
                @if (invoice.TienCoc > 0)
                {
                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Tiền đặt cọc đã trừ</span>
                        <strong class="text-success">-@invoice.TienCoc.ToString("N0") ₫</strong>
                    </div>
                }
                <hr>
                @if (invoice.SoTienConLai >= 0)
                {
                    <div class="ledger-label">CÒN PHẢI THANH TOÁN</div>
                    <div class="ledger-total text-danger">@invoice.SoTienConLai.ToString("N0") ₫</div>
                }
                else
                {
                    <div class="ledger-label">TIỀN CỌC THỪA — HOÀN LẠI KHÁCH</div>
                    <div class="ledger-total text-success">@((-invoice.SoTienConLai).ToString("N0")) ₫</div>
                }
                
                @if (invoice.TrangThai == QLKSan.Enums.InvoiceStatus.Unpaid)
                {
                    <style>
                        .payment-methods-grid {
                            display: flex;
                            flex-direction: column;
                            gap: 12px;
                        }
                        .payment-method-card {
                            border: 1px solid #e2e8f0;
                            border-radius: 8px;
                            padding: 16px;
                            background: #ffffff;
                            cursor: pointer;
                            transition: all 0.2s ease-in-out;
                            user-select: none;
                        }
                        .payment-method-card:hover {
                            border-color: #cbd5e1;
                            background: #f8fafc;
                        }
                        .payment-method-card.active {
                            border-color: #C5A059;
                            background: #fdfcf8;
                            box-shadow: 0 2px 8px rgba(197, 160, 89, 0.08);
                        }
                        .payment-icon-wrapper {
                            width: 44px;
                            height: 44px;
                            display: flex;
                            align-items: center;
                            justify-content: center;
                            background: #f1f5f9;
                            border-radius: 8px;
                            color: #475569;
                            font-size: 1.2rem;
                            transition: all 0.2s ease;
                        }
                        .payment-method-card.active .payment-icon-wrapper {
                            background: #C5A059;
                            color: #ffffff;
                        }
                        .payment-title {
                            display: block;
                            font-weight: 600;
                            color: #1e293b;
                            font-size: 0.95rem;
                        }
                        .payment-method-card.active .payment-title {
                            color: #0c1a30;
                        }
                        .payment-desc {
                            display: block;
                            font-size: 0.75rem;
                            color: #64748b;
                            margin-top: 1px;
                        }
                        .payment-radio-circle {
                            width: 20px;
                            height: 20px;
                            border: 2px solid #cbd5e1;
                            border-radius: 50%;
                            display: flex;
                            align-items: center;
                            justify-content: center;
                            transition: all 0.2s ease;
                        }
                        .payment-method-card.active .payment-radio-circle {
                            border-color: #C5A059;
                        }
                        .payment-method-card.active .payment-radio-circle::after {
                            content: "";
                            width: 10px;
                            height: 10px;
                            background: #C5A059;
                            border-radius: 50%;
                            display: block;
                        }
                    </style>
                    
                    <!-- Apply Promo Code Section -->
                    <div class="mb-4 p-3 rounded border" style="background: rgba(197,160,89,0.05); border-color: rgba(197,160,89,0.2) !important;">
                        <label class="form-label-upper mb-2 d-block text-navy fw-bold" style="letter-spacing: 0.5px; font-size: 0.75rem;">MÃ KHUYẾN MÃI</label>
                        <form asp-action="ApplyPromotion" method="post" class="d-flex gap-2">
                            <input type="hidden" name="maDatPhong" value="@booking.MaDatPhong" />
                            <input type="hidden" name="maPhong" value="@booking.ChiTietDatPhongs.FirstOrDefault()?.MaPhong" />
                            <input type="text" name="maKhuyenMai" class="form-control form-control-sm" placeholder="Nhập mã ưu đãi..." value="@invoice.MaKhuyenMai" style="font-size:0.85rem; border-color:#eaddc4; height:36px;" />
                            <button type="submit" class="btn btn-sm btn-gold px-3 fw-bold" style="height:36px; white-space:nowrap;">ÁP DỤNG</button>
                        </form>
                    </div>

                    <form asp-action="Pay" method="post" class="mt-4" id="payForm">
                        <input type="hidden" name="maHoaDon" value="@invoice.MaHoaDon" />
                        <input type="hidden" name="maPhong" value="@booking.ChiTietDatPhongs.FirstOrDefault()?.MaPhong" />
                        <label class="form-label-upper mb-3 d-block text-navy fw-bold" style="letter-spacing: 0.5px; font-size: 0.75rem;">CHỌN PHƯƠNG THỨC</label>
                        
                        <div class="payment-methods-grid mb-4">
                            <!-- Card: Tiền mặt -->
                            <label class="payment-method-card active" for="payCash">
                                <input type="radio" name="phuongThuc" id="payCash" value="Tiền mặt" checked class="d-none" onchange="selectPaymentMethod(this)" />
                                <div class="d-flex align-items-center justify-content-between w-100">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="payment-icon-wrapper">
                                            <i class="fas fa-money-bill-wave"></i>
                                        </div>
                                        <div>
                                            <span class="payment-title">Tiền mặt</span>
                                            <span class="payment-desc">Tiền mặt tại quầy</span>
                                        </div>
                                    </div>
                                    <div class="payment-radio-circle"></div>
                                </div>
                            </label>

                            <!-- Card: Thẻ tín dụng -->
                            <label class="payment-method-card" for="payCard">
                                <input type="radio" name="phuongThuc" id="payCard" value="Thẻ tín dụng" class="d-none" onchange="selectPaymentMethod(this)" />
                                <div class="d-flex align-items-center justify-content-between w-100">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="payment-icon-wrapper">
                                            <i class="fas fa-credit-card"></i>
                                        </div>
                                        <div>
                                            <span class="payment-title">Thẻ tín dụng</span>
                                            <span class="payment-desc">Visa, Mastercard, Amex</span>
                                        </div>
                                    </div>
                                    <div class="payment-radio-circle"></div>
                                </div>
                            </label>

                            <!-- Card: Chuyển khoản -->
                            <label class="payment-method-card" for="payBank">
                                <input type="radio" name="phuongThuc" id="payBank" value="Chuyển khoản" class="d-none" onchange="selectPaymentMethod(this)" />
                                <div class="d-flex align-items-center justify-content-between w-100">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="payment-icon-wrapper">
                                            <i class="fas fa-university"></i>
                                        </div>
                                        <div>
                                            <span class="payment-title">Chuyển khoản</span>
                                            <span class="payment-desc">Ngân hàng hoặc kỹ thuật số</span>
                                        </div>
                                    </div>
                                    <div class="payment-radio-circle"></div>
                                </div>
                            </label>
                        </div>

                        @if (customer != null && tv != null)
                        {
                            var conPhaiTra = Math.Max(0, Math.Round(invoice.SoTienConLai, 0));
                            var diemToiDa = (int)Math.Min(customer.DiemTichLuy, Math.Floor(conPhaiTra / tv.GiaTriMotDiem));
                            <div class="mb-4 p-3 rounded" style="background:#fbf7ef;border:1px solid #eaddc4">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="fw-bold text-navy small"><i class="fas fa-crown text-gold me-1"></i>@tv.Hang</span>
                                    <span class="small">Hiện có <strong>@customer.DiemTichLuy.ToString("N0")</strong> điểm</span>
                                </div>
                                @if (diemToiDa >= tv.DiemDoiToiThieu)
                                {
                                    <label class="form-label small mb-1" for="diemSuDung">Đổi điểm (1 điểm = @tv.GiaTriMotDiem.ToString("N0") ₫, tối thiểu @tv.DiemDoiToiThieu)</label>
                                    <div class="input-group input-group-sm">
                                        <input type="number" name="diemSuDung" id="diemSuDung" class="form-control" min="0" max="@diemToiDa" step="1" value="0"
                                               oninput="document.getElementById('diemQuyDoi').textContent = (Math.max(0, parseInt(this.value || 0)) * @tv.GiaTriMotDiem).toLocaleString('en-US') + ' ₫'">
                                        <button type="button" class="btn btn-outline-secondary" onclick="var i=document.getElementById('diemSuDung'); i.value=@diemToiDa; i.dispatchEvent(new Event('input'))">Tối đa</button>
                                    </div>
                                    <small class="text-muted">Trừ vào hoá đơn: <strong id="diemQuyDoi">0 ₫</strong> — phần còn lại thu bằng phương thức đã chọn.</small>
                                }
                                else
                                {
                                    <small class="text-muted">Chưa đủ điểm để đổi (tối thiểu @tv.DiemDoiToiThieu điểm).</small>
                                }
                            </div>
                        }

                        @if (invoice.SoTienConLai > 0)
                        {
                            <div class="split-box mb-4">
                                <div class="form-check form-switch mb-2">
                                    <input class="form-check-input" type="checkbox" role="switch" name="tachThanhToan" value="true" id="tachThanhToan" />
                                    <label class="form-check-label fw-semibold small" for="tachThanhToan">Tách thanh toán (tối đa 3 khoản)</label>
                                </div>
                                <div id="splitRows" hidden>
                                    @for (var i = 0; i < 3; i++)
                                    {
                                        <div class="split-row">
                                            <select name="ktPhuongThuc" class="form-select form-select-sm" aria-label="Phương thức khoản @(i + 1)">
                                                @foreach (var pt in QLKSan.Enums.PaymentMethods.TaiQuay) { <option>@pt</option> }
                                            </select>
                                            <input type="number" name="ktSoTien" class="form-control form-control-sm" min="0" step="1000" placeholder="Số tiền" aria-label="Số tiền khoản @(i + 1)" />
                                            <input name="ktGhiChu" class="form-control form-control-sm" maxlength="255" placeholder="Ghi chú (VD: công ty trả)" aria-label="Ghi chú khoản @(i + 1)" />
                                        </div>
                                    }
                                    <div class="small mt-1" id="splitInfo" data-can-thu="@Math.Round(invoice.SoTienConLai, 0).ToString("0")"></div>
                                </div>
                            </div>
                        }

                        <button type="submit" class="btn btn-gold w-100 py-3 fw-bold" style="letter-spacing: 1px;">XÁC NHẬN THANH TOÁN & TRẢ PHÒNG</button>
                    </form>

                    <script>
                        // Tách thanh toán: tổng các khoản phải bằng số còn phải thu sau khi đổi điểm
                        (function () {
                            var sw = document.getElementById('tachThanhToan');
                            if (!sw) return;
                            var rows = document.getElementById('splitRows'), info = document.getElementById('splitInfo');
                            var methods = document.querySelector('.payment-methods-grid');
                            function canThu() {
                                var d = document.getElementById('diemSuDung');
                                return parseInt(info.getAttribute('data-can-thu'), 10) - (d ? Math.max(0, parseInt(d.value || 0, 10)) * @(tv?.GiaTriMotDiem ?? 0) : 0);
                            }
                            function capNhat() {
                                var tong = 0;
                                rows.querySelectorAll('[name=ktSoTien]').forEach(function (i) { tong += Math.max(0, parseFloat(i.value || 0)); });
                                var con = canThu() - tong;
                                info.textContent = 'Đã chia ' + tong.toLocaleString('en-US') + ' ₫ / cần thu ' + canThu().toLocaleString('en-US') + ' ₫' + (con !== 0 ? ' — còn lệch ' + con.toLocaleString('en-US') + ' ₫' : ' ✓');
                                info.className = 'small mt-1 ' + (con === 0 ? 'text-success' : 'text-danger');
                                return con === 0;
                            }
                            sw.addEventListener('change', function () {
                                rows.hidden = !sw.checked;
                                methods.style.opacity = sw.checked ? .45 : 1;
                                if (sw.checked) {
                                    var first = rows.querySelector('[name=ktSoTien]');
                                    if (!first.value) first.value = canThu();
                                }
                                capNhat();
                            });
                            rows.addEventListener('input', capNhat);
                            var d = document.getElementById('diemSuDung');
                            if (d) d.addEventListener('input', capNhat);
                            document.getElementById('payForm').addEventListener('submit', function (e) {
                                if (sw.checked && !capNhat()) { e.preventDefault(); alert('Tổng các khoản phải bằng số tiền cần thu.'); }
                            });
                        })();

                        function selectPaymentMethod(radioInput) {
                            document.querySelectorAll('.payment-method-card').forEach(card => {
                                card.classList.remove('active');
                            });
                            if (radioInput.checked) {
                                radioInput.closest('.payment-method-card').classList.add('active');
                            }
                        }
                    </script>
                }
                else
                {
                    <div class="alert alert-success mt-4 text-center">ĐÃ THANH TOÁN</div>
                }

                <details class="vat-box mt-4" @(string.IsNullOrEmpty(invoice.MaSoThue) ? "" : "open")>
                    <summary><i class="fas fa-building me-2"></i>Xuất hoá đơn VAT cho công ty @if (!string.IsNullOrEmpty(invoice.MaSoThue)) { <span class="text-success small ms-1">· MST @invoice.MaSoThue</span> }</summary>
                    <form asp-action="SetCompany" method="post" class="mt-3">
                        <input type="hidden" name="maHoaDon" value="@invoice.MaHoaDon" />
                        <input type="hidden" name="maPhong" value="@booking.ChiTietDatPhongs.FirstOrDefault()?.MaPhong" />
                        <div class="row g-2">
                            <div class="col-12"><input name="TenCongTy" class="form-control form-control-sm" maxlength="200" placeholder="Tên công ty" value="@invoice.TenCongTy" aria-label="Tên công ty" /></div>
                            <div class="col-5"><input name="MaSoThue" class="form-control form-control-sm" maxlength="20" placeholder="Mã số thuế" value="@invoice.MaSoThue" aria-label="Mã số thuế" /></div>
                            <div class="col-7"><input name="EmailHoaDon" type="email" class="form-control form-control-sm" maxlength="100" placeholder="Email nhận hoá đơn" value="@invoice.EmailHoaDon" aria-label="Email nhận hoá đơn" /></div>
                            <div class="col-12"><input name="DiaChiCongTy" class="form-control form-control-sm" maxlength="300" placeholder="Địa chỉ công ty" value="@invoice.DiaChiCongTy" aria-label="Địa chỉ công ty" /></div>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <small class="text-muted">Để trống mã số thuế: hoá đơn cá nhân.</small>
                            <button type="submit" class="btn btn-sm btn-outline-navy">Lưu</button>
                        </div>
                    </form>
                </details>
            </div>
        }
        else if (booking != null)
        {
            <div class="ledger-panel mb-4">
                <h5>Tiến hành xuất Hóa Đơn</h5>
                <p class="text-muted mt-2">Vui lòng kiểm tra kỹ dịch vụ trước khi xuất hóa đơn. Hóa đơn đã xuất không thể thay đổi thông tin dịch vụ.</p>
                <form asp-action="GenerateInvoice" method="post" class="mt-4">
                    <input type="hidden" name="maDatPhong" value="@booking.MaDatPhong" />
                    <input type="hidden" name="maPhong" value="@booking.ChiTietDatPhongs.FirstOrDefault()?.MaPhong" />
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-navy small">MÃ KHUYẾN MÃI (NẾU CÓ)</label>
                        <input type="text" name="maKhuyenMai" class="form-control form-control-sm" placeholder="Nhập mã khuyến mãi..." value="@booking.MaKhuyenMai" style="font-size:0.85rem; border-color:#eaddc4; height: 38px;" />
                    </div>
                    <button type="submit" class="btn btn-outline-navy w-100 py-3">CHỐT DỮ LIỆU & TẠO HÓA ĐƠN</button>
                </form>
            </div>
        }
    </div>
</div>
