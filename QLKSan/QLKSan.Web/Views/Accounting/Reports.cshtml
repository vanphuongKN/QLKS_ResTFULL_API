@model QLKSan.Models.DTOs.RevenueReportDto
@{
    ViewData["Title"] = "Báo cáo doanh thu";
    DateTime tuNgay = ViewBag.TuNgay;
    DateTime denNgay = ViewBag.DenNgay;
    var occ = ViewBag.Occupancy as QLKSan.Models.DTOs.OccupancyReportDto;
    var maxDay = Model.TheoNgay.Any() ? Math.Max(1, Model.TheoNgay.Max(d => d.DoanhThu)) : 1;
}

<div class="page-header">
    <div>
        <p class="page-label">Kế toán</p>
        <h2>Báo cáo doanh thu & công suất phòng</h2>
    </div>
    <a href="@Url.Action("Export", new { tuNgay = tuNgay.ToString("yyyy-MM-dd"), denNgay = denNgay.ToString("yyyy-MM-dd") })" class="btn-gold text-decoration-none">
        <i class="fas fa-file-excel me-2"></i>Xuất Excel
    </a>
</div>

<form method="get" class="card p-3 mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-md-3">
            <label class="form-label small fw-semibold">Từ ngày</label>
            <input type="date" name="tuNgay" value="@tuNgay.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
        </div>
        <div class="col-md-3">
            <label class="form-label small fw-semibold">Đến ngày</label>
            <input type="date" name="denNgay" value="@denNgay.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
        </div>
        <div class="col-md-6 d-flex gap-2">
            <button type="submit" class="btn btn-gold btn-sm"><i class="fas fa-sync me-1"></i>Xem báo cáo</button>
            <a href="@Url.Action("Reports", new { tuNgay = DateTime.Today.AddDays(-6).ToString("yyyy-MM-dd"), denNgay = DateTime.Today.ToString("yyyy-MM-dd") })" class="btn btn-outline-secondary btn-sm">7 ngày qua</a>
            <a href="@Url.Action("Reports", new { tuNgay = DateTime.Today.AddDays(-29).ToString("yyyy-MM-dd"), denNgay = DateTime.Today.ToString("yyyy-MM-dd") })" class="btn btn-outline-secondary btn-sm">30 ngày qua</a>
        </div>
    </div>
</form>

<!-- Chỉ số tổng hợp -->
<div class="row g-3 mb-4">
    <div class="col-md-3"><div class="card p-3 h-100"><small class="text-muted">Doanh thu thuần</small><div class="fs-4 fw-bold text-navy">@Model.DoanhThuThuan.ToString("N0") ₫</div><small class="text-muted">@Model.SoHoaDon hoá đơn đã thanh toán</small></div></div>
    <div class="col-md-3"><div class="card p-3 h-100"><small class="text-muted">Tổng doanh thu / Hoàn tiền</small><div class="fs-5 fw-bold">@Model.TongDoanhThu.ToString("N0") ₫</div><small class="text-danger">Hoàn: -@Model.TongHoanTien.ToString("N0") ₫</small></div></div>
    <div class="col-md-3"><div class="card p-3 h-100"><small class="text-muted">Công suất phòng TB</small><div class="fs-4 fw-bold text-navy">@(occ?.TyLeTrungBinh ?? 0)%</div><small class="text-muted">@(occ?.TongDemPhongDaBan ?? 0) đêm phòng / @(occ?.TongSoPhong ?? 0) phòng</small></div></div>
    <div class="col-md-3"><div class="card p-3 h-100"><small class="text-muted">Cơ cấu</small>
        <small>Phòng: <strong>@Model.TienPhong.ToString("N0")</strong></small>
        <small>Dịch vụ: <strong>@Model.TienDichVu.ToString("N0")</strong></small>
        <small>Phụ thu: <strong>@Model.PhuThu.ToString("N0")</strong> · KM: <strong class="text-success">-@Model.GiamGia.ToString("N0")</strong></small>
        <small>Ưu đãi hạng: <strong class="text-success">-@Model.GiamGiaThanhVien.ToString("N0")</strong></small>
        <small>VAT: <strong>@Model.ThueVAT.ToString("N0")</strong></small>
    </div></div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card mb-4">
            <div class="card-body p-0">
                <div class="p-3 border-bottom"><h6 class="fw-bold mb-0 text-navy">Doanh thu & công suất theo ngày</h6></div>
                <table class="table table-custom mb-0">
                    <thead><tr><th>Ngày</th><th>HĐ</th><th style="width:40%">Doanh thu</th><th class="text-end">Hoàn</th><th class="text-end">Công suất</th></tr></thead>
                    <tbody>
                        @foreach (var d in Model.TheoNgay)
                        {
                            var o = occ?.TheoNgay.FirstOrDefault(x => x.Ngay.Date == d.Ngay.Date);
                            <tr>
                                <td><small>@d.Ngay.ToString("dd/MM")</small></td>
                                <td>@d.SoHoaDon</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div style="height:8px;border-radius:4px;background:#C5A059;width:@((int)(d.DoanhThu * 100 / maxDay))%"></div>
                                        <small class="text-nowrap">@(d.DoanhThu > 0 ? d.DoanhThu.ToString("N0") : "")</small>
                                    </div>
                                </td>
                                <td class="text-end text-danger"><small>@(d.HoanTien > 0 ? "-" + d.HoanTien.ToString("N0") : "")</small></td>
                                <td class="text-end"><small>@(o?.SoPhongCoKhach ?? 0) phòng · @(o?.TyLe ?? 0)%</small></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card mb-4">
            <div class="card-body p-0">
                <div class="p-3 border-bottom"><h6 class="fw-bold mb-0 text-navy">Theo loại phòng</h6></div>
                <table class="table table-custom mb-0">
                    <thead><tr><th>Loại phòng</th><th>Lượt</th><th>Đêm</th><th class="text-end">Tiền phòng</th></tr></thead>
                    <tbody>
                        @foreach (var r in Model.TheoLoaiPhong)
                        {
                            <tr><td>@r.TenLoai</td><td>@r.SoLuot</td><td>@r.SoDem</td><td class="text-end">@r.DoanhThuPhong.ToString("N0")</td></tr>
                        }
                        @if (!Model.TheoLoaiPhong.Any()) { <tr><td colspan="4" class="text-center text-muted">Không có dữ liệu</td></tr> }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-body p-0">
                <div class="p-3 border-bottom"><h6 class="fw-bold mb-0 text-navy">Theo dịch vụ</h6></div>
                <table class="table table-custom mb-0">
                    <thead><tr><th>Dịch vụ</th><th>SL</th><th class="text-end">Doanh thu</th></tr></thead>
                    <tbody>
                        @foreach (var s in Model.TheoDichVu)
                        {
                            <tr><td>@s.TenDichVu</td><td>@s.SoLuong</td><td class="text-end">@s.DoanhThu.ToString("N0")</td></tr>
                        }
                        @if (!Model.TheoDichVu.Any()) { <tr><td colspan="3" class="text-center text-muted">Không có dữ liệu</td></tr> }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-body p-0">
                <div class="p-3 border-bottom"><h6 class="fw-bold mb-0 text-navy">Theo phương thức thanh toán</h6></div>
                <table class="table table-custom mb-0">
                    <thead><tr><th>Phương thức</th><th>GD</th><th class="text-end">Số tiền</th></tr></thead>
                    <tbody>
                        @foreach (var m in Model.TheoPhuongThuc)
                        {
                            <tr><td>@m.PhuongThuc</td><td>@m.SoGiaoDich</td><td class="text-end @(m.SoTien < 0 ? "text-danger" : "")">@m.SoTien.ToString("N0")</td></tr>
                        }
                        @if (!Model.TheoPhuongThuc.Any()) { <tr><td colspan="3" class="text-center text-muted">Không có dữ liệu</td></tr> }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-body p-0">
                <div class="p-3 border-bottom"><h6 class="fw-bold mb-0 text-navy">Theo kênh đặt phòng</h6></div>
                <table class="table table-custom mb-0" data-no-tools>
                    <thead><tr><th>Kênh</th><th>Lượt</th><th>Đêm</th><th class="text-end">Doanh thu</th></tr></thead>
                    <tbody>
                        @foreach (var k in Model.TheoKenh)
                        {
                            <tr><td>@k.Kenh</td><td>@k.SoLuot</td><td>@k.SoDem</td><td class="text-end">@k.DoanhThu.ToString("N0")</td></tr>
                        }
                        @if (!Model.TheoKenh.Any()) { <tr><td colspan="4" class="text-center text-muted">Không có dữ liệu</td></tr> }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card">
            <div class="card-body p-0">
                <div class="p-3 border-bottom"><h6 class="fw-bold mb-0 text-navy">Đối soát theo nhân viên thu</h6></div>
                <table class="table table-custom mb-0">
                    <thead><tr><th>Nhân viên</th><th>GD</th><th class="text-end">Đã thu</th></tr></thead>
                    <tbody>
                        @foreach (var n in Model.TheoNhanVien)
                        {
                            <tr><td>@n.TenNhanVien</td><td>@n.SoGiaoDich</td><td class="text-end">@n.SoTienThu.ToString("N0")</td></tr>
                        }
                        @if (!Model.TheoNhanVien.Any()) { <tr><td colspan="3" class="text-center text-muted">Không có dữ liệu</td></tr> }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
