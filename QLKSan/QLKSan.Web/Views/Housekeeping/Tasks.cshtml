@using QLKSan.Enums
@using QLKSan.Models.DTOs
@{
    ViewData["Title"] = "Buồng phòng";
    var cleaningRooms = ViewBag.CleaningRooms as IEnumerable<RoomDto> ?? Enumerable.Empty<RoomDto>();
    var tasks = ViewBag.Tasks as IEnumerable<HousekeepingTaskDto> ?? Enumerable.Empty<HousekeepingTaskDto>();
    var hkStaff = ViewBag.HousekeepingStaff as IEnumerable<StaffDto> ?? Enumerable.Empty<StaffDto>();
    int countAvailable = ViewBag.CountAvailable ?? 0;

    int Dem(HousekeepingTaskStatus s) => tasks.Count(t => t.TrangThai == s);
    string BadgeClass(HousekeepingTaskStatus s) => s switch
    {
        HousekeepingTaskStatus.Unassigned => "badge-pending",
        HousekeepingTaskStatus.Assigned => "badge-booked",
        HousekeepingTaskStatus.InProgress => "badge-cleaning",
        HousekeepingTaskStatus.Issue => "badge-occupied",
        _ => "badge-available"
    };
    var stats = new[]
    {
        (Label: "Chưa giao", Value: Dem(HousekeepingTaskStatus.Unassigned), Icon: "fa-inbox", Css: "text-warning"),
        (Label: "Đã giao", Value: Dem(HousekeepingTaskStatus.Assigned), Icon: "fa-user-check", Css: "text-primary"),
        (Label: "Đang dọn", Value: Dem(HousekeepingTaskStatus.InProgress), Icon: "fa-broom", Css: "text-gold"),
        (Label: "Báo sự cố", Value: Dem(HousekeepingTaskStatus.Issue), Icon: "fa-exclamation-triangle", Css: "text-danger"),
    };
}

<div class="page-header">
    <div>
        <p class="page-label">Buồng phòng</p>
        <h2>Công việc dọn phòng</h2>
        <p class="page-desc">Việc dọn phòng được tạo tự động khi khách trả phòng. Hiện có @countAvailable phòng trống sẵn sàng đón khách.</p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success mb-3">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger mb-3">@TempData["ErrorMessage"]</div>
}

<div class="row g-3 mb-4">
    @foreach (var s in stats)
    {
        <div class="col-6 col-lg-3">
            <div class="card p-3 h-100 d-flex flex-row align-items-center justify-content-between">
                <div>
                    <span class="text-muted text-uppercase fw-semibold d-block" style="font-size:.7rem;letter-spacing:.5px">@s.Label</span>
                    <span class="fs-4 fw-bold text-navy">@s.Value</span> <small class="text-muted">việc</small>
                </div>
                <i class="fas @s.Icon @s.Css fs-4"></i>
            </div>
        </div>
    }
</div>

<!-- Phân công dọn phòng -->
<div class="card mb-4">
    <div class="card-body p-0">
        <div class="p-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h5 class="text-navy fw-bold mb-0"><i class="fas fa-clipboard-list text-gold me-2"></i>Phân công dọn phòng (@tasks.Count())</h5>
            <small class="text-muted">Giao việc cho nhân viên buồng phòng; nhân viên tự cập nhật khi bắt đầu / dọn xong</small>
        </div>
        <table class="table table-custom mb-0">
            <thead>
                <tr>
                    <th>Phòng</th>
                    <th>Công việc</th>
                    <th>Trạng thái</th>
                    <th>Nhân viên</th>
                    <th style="min-width:280px">Giao việc</th>
                </tr>
            </thead>
            <tbody>
                @if (tasks.Any())
                {
                    foreach (var t in tasks)
                    {
                        var coTheGiao = t.TrangThai == HousekeepingTaskStatus.Unassigned || t.TrangThai == HousekeepingTaskStatus.Assigned;
                        <tr>
                            <td class="nowrap"><strong>Phòng @t.SoPhong</strong><br /><small class="text-muted">@t.TenLoaiPhong</small></td>
                            <td>@t.LoaiCongViec<br /><small class="text-muted">Tạo lúc @t.ThoiGianTao.ToString("dd/MM HH:mm")</small></td>
                            <td>
                                <span class="badge-status @BadgeClass(t.TrangThai)">@t.TrangThai.GetDisplayName()</span>
                                @if (!string.IsNullOrEmpty(t.GhiChu))
                                {
                                    <br /><small class="text-danger">@t.GhiChu</small>
                                }
                            </td>
                            <td>@(t.TenNhanVien ?? "—")</td>
                            <td>
                                @if (coTheGiao)
                                {
                                    <form asp-action="Assign" method="post" class="d-flex gap-2">
                                        <input type="hidden" name="maPhanCong" value="@t.MaPhanCong" />
                                        <select name="maNhanVien" class="form-select form-select-sm" required>
                                            <option value="">-- Chọn nhân viên --</option>
                                            @foreach (var nv in hkStaff)
                                            {
                                                <option value="@nv.MaNhanVien" selected="@(nv.MaNhanVien == t.MaNhanVien)">@nv.TenNhanVien</option>
                                            }
                                        </select>
                                        <button type="submit" class="btn btn-sm btn-gold text-nowrap">@(t.MaNhanVien == null ? "Giao" : "Giao lại")</button>
                                    </form>
                                }
                                else
                                {
                                    <small class="text-muted">@(t.TrangThai == HousekeepingTaskStatus.InProgress ? "Nhân viên đang dọn" : "Chờ xử lý sự cố (đổi trạng thái phòng khi sửa xong)")</small>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="5" class="text-center text-muted p-4">Không có công việc dọn phòng nào đang chờ.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Phòng đang chờ dọn: lễ tân xác nhận nhanh khi đã kiểm tra phòng -->
<h5 class="text-navy fw-bold mb-3"><i class="fas fa-door-closed text-gold me-2"></i>Phòng chờ dọn (@cleaningRooms.Count())</h5>
<div class="row g-3 mb-5">
    @if (cleaningRooms.Any())
    {
        foreach (var room in cleaningRooms)
        {
            var lastBooking = room.LanDatGanNhat;
            var lastCustomer = lastBooking?.KhachHang?.HoTen;
            <div class="col-md-6 col-xl-4">
                <div class="card p-3 h-100">
                    <div class="d-flex gap-3 align-items-center mb-3">
                        <div class="d-flex align-items-center justify-content-center fw-bold text-navy flex-shrink-0" style="width:50px;height:50px;background:#f1f5f9;border-radius:8px;font-size:1.1rem;border:1px solid #e2e8f0">@room.SoPhong</div>
                        <div class="min-w-0">
                            <div class="fw-bold text-navy">@(room.LoaiPhong?.TenLoai ?? "—")</div>
                            <span class="badge-status badge-cleaning">Chờ dọn</span>
                        </div>
                    </div>
                    <p class="text-muted small mb-3">
                        <i class="fas fa-user me-2 text-gold"></i>@(string.IsNullOrWhiteSpace(lastCustomer) ? "Dọn theo lịch" : "Khách vừa trả: " + lastCustomer)
                    </p>
                    <form asp-action="MarkClean" method="post" class="mt-auto">
                        <input type="hidden" name="maPhong" value="@room.MaPhong" />
                        <button type="submit" class="btn btn-outline-gold btn-sm w-100 py-2">Xác nhận đã dọn xong</button>
                    </form>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="card p-4 text-center">
                <i class="fas fa-check-circle text-success mb-2" style="font-size:2.5rem"></i>
                <h6 class="text-navy fw-bold mb-1">Không có phòng nào cần dọn</h6>
                <p class="text-muted small mb-0">Tất cả phòng đã sạch và sẵn sàng đón khách.</p>
            </div>
        </div>
    }
</div>
