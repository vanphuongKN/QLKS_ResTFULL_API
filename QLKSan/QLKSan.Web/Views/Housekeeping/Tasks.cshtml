@using QLKSan.Enums
@using QLKSan.Models.DTOs
@{
    ViewData["Title"] = "Buồng phòng";
    var tasks = ViewBag.Tasks as IEnumerable<HousekeepingTaskDto> ?? Enumerable.Empty<HousekeepingTaskDto>();
    var board = ViewBag.Board as List<HousekeepingRoomDto> ?? new List<HousekeepingRoomDto>();
    var hkStaff = ViewBag.HousekeepingStaff as IEnumerable<StaffDto> ?? Enumerable.Empty<StaffDto>();
    int countAvailable = ViewBag.CountAvailable ?? 0;
    int chuaSan = ViewBag.KhachDenPhongChuaSan ?? 0;

    int Dem(HousekeepingTaskStatus s) => tasks.Count(t => t.TrangThai == s);
    string BadgeClass(HousekeepingTaskStatus s) => s switch
    {
        HousekeepingTaskStatus.Unassigned => "badge-pending",
        HousekeepingTaskStatus.Assigned => "badge-booked",
        HousekeepingTaskStatus.InProgress => "badge-cleaning",
        HousekeepingTaskStatus.Issue => "badge-occupied",
        HousekeepingTaskStatus.AwaitingInspection => "badge-booked",
        _ => "badge-available"
    };
    var choKiemTra = tasks.Where(t => t.TrangThai == HousekeepingTaskStatus.AwaitingInspection).ToList();
    var laNguoiKiemTra = WebRoles.RoomInspectors.Split(',').Any(User.IsInRole);
    (string Css, string Nhan) Phong(RoomStatus t) => t switch
    {
        RoomStatus.Available => ("is-clean", "Sạch"),
        RoomStatus.Cleaning => ("is-dirty", "Chưa dọn"),
        RoomStatus.Occupied => ("is-occupied", "Có khách"),
        RoomStatus.Maintenance => ("is-ooo", "Bảo trì"),
        _ => ("is-clean", "Đã đặt")
    };
    (string Css, string Nhan) UuTien(int u) => u switch
    {
        1 => ("prio-1", "Gấp"),
        2 => ("prio-2", "Cao"),
        4 => ("prio-4", "Sự cố"),
        _ => ("prio-3", "Thường")
    };
    var stats = new[]
    {
        (Label: "Chưa giao", Value: Dem(HousekeepingTaskStatus.Unassigned), Icon: "fa-inbox", Css: "text-warning"),
        (Label: "Đã giao", Value: Dem(HousekeepingTaskStatus.Assigned), Icon: "fa-user-check", Css: "text-primary"),
        (Label: "Đang dọn", Value: Dem(HousekeepingTaskStatus.InProgress), Icon: "fa-broom", Css: "text-gold"),
        (Label: "Báo sự cố", Value: Dem(HousekeepingTaskStatus.Issue), Icon: "fa-exclamation-triangle", Css: "text-danger"),
    };
    var tangCoViec = tasks.Where(t => t.TrangThai is HousekeepingTaskStatus.Unassigned or HousekeepingTaskStatus.Assigned).Select(t => t.Tang).Distinct().OrderBy(x => x).ToList();
}

<div class="page-header">
    <div>
        <p class="page-label">Buồng phòng</p>
        <h2>Công việc dọn phòng</h2>
        <p class="page-desc">Việc được tạo khi khách trả phòng, đổi phòng, gửi yêu cầu, sau sửa chữa, và mỗi ngày cho phòng có khách (dọn hằng ngày, chỉnh trang buổi tối); xếp theo ưu tiên khách sắp đến. Hiện có @countAvailable phòng sạch sẵn sàng đón khách.</p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null) { <div class="alert alert-success mb-3">@TempData["SuccessMessage"]</div> }
@if (TempData["ErrorMessage"] != null) { <div class="alert alert-danger mb-3">@TempData["ErrorMessage"]</div> }
@if (chuaSan > 0)
{
    <div class="alert alert-warning mb-3"><i class="fas fa-triangle-exclamation me-2"></i><strong>@chuaSan phòng</strong> có khách đến hôm nay nhưng chưa sạch — ưu tiên giao dọn trước.</div>
}

@if (choKiemTra.Any())
{
    <div class="card mb-4 inspect-card">
        <div class="p-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h5 class="text-navy fw-bold mb-0"><i class="fas fa-clipboard-check text-gold me-2"></i>Chờ kiểm tra (@choKiemTra.Count)</h5>
            <small class="text-muted">Phòng đã dọn xong; kiểm tra theo danh mục trước khi phòng được bán</small>
        </div>
        <div class="p-3 d-flex flex-wrap gap-3">
            @foreach (var t in choKiemTra)
            {
                <div class="inspect-item">
                    <div><strong>Phòng @t.SoPhong</strong> <span class="prio @UuTien(t.UuTien).Css">@UuTien(t.UuTien).Nhan</span></div>
                    <small class="text-muted d-block">@t.TenNhanVien · xong lúc @t.ThoiGianHoanThanh?.ToString("HH:mm")@(t.SoLanKhongDat > 0 ? $" · đã trả lại {t.SoLanKhongDat} lần" : "")</small>
                    @if (laNguoiKiemTra)
                    {
                        <button type="button" class="btn btn-sm btn-gold mt-2" data-inspect="@t.MaPhanCong" data-phong="@t.SoPhong"
                                data-danhmuc="@System.Text.Json.JsonSerializer.Serialize(t.DanhMucKiemTra)">Kiểm tra</button>
                    }
                </div>
            }
        </div>
    </div>

    <div class="modal fade" id="inspectModal" tabindex="-1" aria-labelledby="inTitle">
        <div class="modal-dialog">
            <form asp-action="Inspect" method="post" class="modal-content">
                <div class="modal-header"><h5 class="modal-title fw-bold" id="inTitle">Kiểm tra phòng</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div>
                <div class="modal-body">
                    <input type="hidden" name="maPhanCong" id="inMa" />
                    <p class="small text-muted">Tích các mục đạt. Bỏ tích mục nào thì phòng được trả lại cho nhân viên dọn lại.</p>
                    <div id="inList" class="inspect-list"></div>
                    <label class="form-label fw-semibold mt-3" for="inGhiChu">Ghi chú</label>
                    <input name="ghiChu" id="inGhiChu" class="form-control" maxlength="300" placeholder="VD: thay khăn tắm bị ố" />
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Đóng</button><button type="submit" class="btn-gold" id="inSubmit">Đạt — mở bán phòng</button></div>
            </form>
        </div>
    </div>
}

<div class="row g-3 mb-4">
    @foreach (var s in stats)
    {
        <div class="col-6 col-lg-3">
            <div class="card p-3 h-100 d-flex flex-row align-items-center justify-content-between">
                <div>
                    <span class="text-muted text-uppercase fw-semibold d-block" style="font-size:.7rem;letter-spacing:.5px">@s.Label</span>
                    <span class="fs-4 fw-bold text-navy">@s.Value</span> <small class="text-muted">việc</small>
                </div>
                <i class="fas @s.Icon @s.Css fs-4"></i>
            </div>
        </div>
    }
</div>

<!-- Sơ đồ buồng phòng theo tầng -->
<div class="card p-4 mb-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <h5 class="text-navy fw-bold mb-0"><i class="fas fa-building text-gold me-2"></i>Sơ đồ buồng phòng
            <a asp-action="Minibar" class="btn btn-sm btn-outline-navy ms-2"><i class="fas fa-wine-bottle me-1"></i>Ghi minibar</a>
            <a asp-action="Maintenance" class="btn btn-sm btn-outline-navy ms-1"><i class="fas fa-screwdriver-wrench me-1"></i>Kỹ thuật</a></h5>
        <form asp-action="GenerateDaily" method="post" class="m-0">
            <button type="submit" class="btn btn-sm btn-outline-gold" title="Dọn hằng ngày phòng có khách + chỉnh trang buổi tối (hệ thống cũng tự tạo định kỳ)"><i class="fas fa-calendar-day me-1"></i>Tạo việc trong ngày</button>
        </form>
        <div class="hk-legend">
            <span class="is-clean">Sạch</span><span class="is-dirty">Chưa dọn</span><span class="is-occupied">Có khách</span><span class="is-ooo">Bảo trì</span>
        </div>
    </div>
    @foreach (var tang in board.GroupBy(r => r.Tang))
    {
        <div class="hk-floor">
            <div class="hk-floor-label">Tầng @tang.Key</div>
            <div class="hk-rooms">
                @foreach (var r in tang)
                {
                    var p = Phong(r.TrangThai);
                    var v = r.ViecDangMo;
                    <div class="hk-room @p.Css @(r.KhachDen != null && r.TrangThai != RoomStatus.Available ? "is-urgent" : "")">
                        <div class="hk-room-top"><strong>@r.SoPhong</strong><span>@p.Nhan</span></div>
                        <small class="hk-room-type">@FormatHelper.TenHangPhong(r.TenLoaiPhong)</small>
                        @if (r.KhachDen != null)
                        {
                            <small class="hk-tag">@if (r.KhachDenVIP) { <i class="fas fa-crown text-gold me-1"></i> }Đến @(r.GioDen ?? "hôm nay")</small>
                        }
                        @if (r.KhachDiHomNay) { <small class="hk-tag"><i class="fas fa-sign-out-alt me-1"></i>Đi hôm nay</small> }
                        @if (r.SuCo != null) { <small class="hk-tag text-danger" title="@r.SuCo"><i class="fas fa-screwdriver-wrench me-1"></i>@r.SuCo</small> }
                        @if (v != null)
                        {
                            <small class="hk-task"><span class="badge-status @BadgeClass(v.TrangThai)">@v.TrangThai.GetDisplayName()</span> @(v.TenNhanVien ?? "")</small>
                        }
                        @if (r.TrangThai == RoomStatus.Cleaning)
                        {
                            <form asp-action="MarkClean" method="post" class="mt-1">
                                <input type="hidden" name="maPhong" value="@r.MaPhong" />
                                <button type="submit" class="btn btn-sm btn-link p-0 hk-clean-btn" title="Lễ tân xác nhận phòng đã dọn">Xác nhận đã dọn</button>
                            </form>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>

<!-- Phân công dọn phòng (theo ưu tiên) -->
<div class="card mb-4">
    <div class="card-body p-0">
        <div class="p-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h5 class="text-navy fw-bold mb-0"><i class="fas fa-clipboard-list text-gold me-2"></i>Phân công dọn phòng (@tasks.Count())</h5>
            <form asp-action="AssignBulk" method="post" id="bulkForm" class="d-flex gap-2 flex-wrap align-items-center">
                @if (tangCoViec.Any())
                {
                    <select class="form-select form-select-sm w-auto" id="chonTang" aria-label="Chọn cả tầng">
                        <option value="">Chọn cả tầng…</option>
                        @foreach (var t in tangCoViec) { <option value="@t">Tầng @t</option> }
                    </select>
                }
                <select name="maNhanVien" class="form-select form-select-sm w-auto" required aria-label="Nhân viên nhận việc">
                    <option value="">-- Nhân viên --</option>
                    @foreach (var nv in hkStaff) { <option value="@nv.MaNhanVien">@nv.TenNhanVien</option> }
                </select>
                <button type="submit" class="btn btn-sm btn-gold text-nowrap" id="bulkBtn" disabled>Giao việc đã chọn</button>
            </form>
        </div>
        <table class="table table-custom mb-0" data-no-tools>
            <thead>
                <tr>
                    <th style="width:36px"></th>
                    <th>Phòng</th>
                    <th>Công việc</th>
                    <th>Ưu tiên</th>
                    <th>Trạng thái</th>
                    <th>Nhân viên</th>
                    <th style="min-width:260px">Giao việc</th>
                </tr>
            </thead>
            <tbody>
                @if (!tasks.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted p-4">Không có công việc dọn phòng nào đang chờ.</td></tr>
                }
                @foreach (var t in tasks)
                {
                    var coTheGiao = t.TrangThai is HousekeepingTaskStatus.Unassigned or HousekeepingTaskStatus.Assigned;
                    var u = UuTien(t.UuTien);
                    <tr>
                        <td>@if (coTheGiao) { <input type="checkbox" class="form-check-input" name="maPhanCongs" value="@t.MaPhanCong" form="bulkForm" data-tang="@t.Tang" aria-label="Chọn phòng @t.SoPhong" /> }</td>
                        <td class="nowrap"><strong>Phòng @t.SoPhong</strong><br /><small class="text-muted">Tầng @t.Tang · @t.TenLoaiPhong</small></td>
                        <td>@t.LoaiCongViec<br /><small class="text-muted">Tạo lúc @t.ThoiGianTao.ToString("dd/MM HH:mm")</small>
                            @if (!string.IsNullOrEmpty(t.GioDonMongMuon)) { <br /><small class="text-navy"><i class="fas fa-clock me-1"></i>Khách muốn dọn: @t.GioDonMongMuon</small> }
                            @if (!string.IsNullOrEmpty(t.GhiChu)) { <br /><small class="@(t.TrangThai == HousekeepingTaskStatus.Issue ? "text-danger" : "text-dark")">@t.GhiChu</small> }
                        </td>
                        <td><span class="prio @u.Css">@u.Nhan</span>@if (!string.IsNullOrEmpty(t.LyDoUuTien)) { <br /><small class="text-muted">@t.LyDoUuTien</small> }</td>
                        <td><span class="badge-status @BadgeClass(t.TrangThai)">@t.TrangThai.GetDisplayName()</span></td>
                        <td>@(t.TenNhanVien ?? "—")</td>
                        <td>
                            @if (coTheGiao)
                            {
                                <form asp-action="Assign" method="post" class="d-flex gap-2">
                                    <input type="hidden" name="maPhanCong" value="@t.MaPhanCong" />
                                    <select name="maNhanVien" class="form-select form-select-sm" required aria-label="Nhân viên">
                                        <option value="">-- Chọn nhân viên --</option>
                                        @foreach (var nv in hkStaff)
                                        {
                                            <option value="@nv.MaNhanVien" selected="@(nv.MaNhanVien == t.MaNhanVien)">@nv.TenNhanVien</option>
                                        }
                                    </select>
                                    <button type="submit" class="btn btn-sm btn-gold text-nowrap">@(t.MaNhanVien == null ? "Giao" : "Giao lại")</button>
                                </form>
                            }
                            else
                            {
                                <small class="text-muted">@(t.TrangThai == HousekeepingTaskStatus.InProgress ? "Nhân viên đang dọn" : "Chờ xử lý sự cố (đổi trạng thái phòng khi sửa xong)")</small>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        // Hộp thoại kiểm tra: danh mục theo hạng phòng; bỏ tích mục nào → chưa đạt
        document.querySelectorAll('[data-inspect]').forEach(function (b) {
            b.addEventListener('click', function () {
                var list = document.getElementById('inList');
                list.innerHTML = '';
                document.getElementById('inMa').value = b.getAttribute('data-inspect');
                document.getElementById('inTitle').textContent = 'Kiểm tra phòng ' + b.getAttribute('data-phong');
                JSON.parse(b.getAttribute('data-danhmuc') || '[]').forEach(function (m, i) {
                    var row = document.createElement('div'); row.className = 'form-check';
                    var all = document.createElement('input'); all.type = 'hidden'; all.name = 'danhMuc'; all.value = m;
                    var cb = document.createElement('input'); cb.type = 'checkbox'; cb.className = 'form-check-input'; cb.name = 'daDat'; cb.value = m; cb.checked = true; cb.id = 'inM' + i;
                    var lb = document.createElement('label'); lb.className = 'form-check-label'; lb.htmlFor = cb.id; lb.textContent = m;
                    cb.addEventListener('change', capNhatKiemTra);
                    row.appendChild(all); row.appendChild(cb); row.appendChild(lb); list.appendChild(row);
                });
                document.getElementById('inGhiChu').value = '';
                capNhatKiemTra();
                bootstrap.Modal.getOrCreateInstance(document.getElementById('inspectModal')).show();
            });
        });
        function capNhatKiemTra() {
            var thieu = document.querySelectorAll('#inList input[name=daDat]:not(:checked)').length;
            var btn = document.getElementById('inSubmit');
            btn.textContent = thieu ? 'Chưa đạt — trả lại dọn lại (' + thieu + ' mục)' : 'Đạt — mở bán phòng';
            btn.className = thieu ? 'btn btn-danger' : 'btn-gold';
        }

        (function () {
            var boxes = document.querySelectorAll('input[name=maPhanCongs]'), btn = document.getElementById('bulkBtn');
            function cap() {
                var n = Array.prototype.filter.call(boxes, function (b) { return b.checked; }).length;
                btn.disabled = n === 0;
                btn.textContent = n ? 'Giao ' + n + ' việc đã chọn' : 'Giao việc đã chọn';
            }
            boxes.forEach(function (b) { b.addEventListener('change', cap); });
            var tang = document.getElementById('chonTang');
            if (tang) tang.addEventListener('change', function () {
                boxes.forEach(function (b) { b.checked = tang.value !== '' && b.getAttribute('data-tang') === tang.value; });
                cap();
            });
        })();
    </script>
}
