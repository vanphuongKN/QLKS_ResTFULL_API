@using QLKSan.Enums
@model IEnumerable<QLKSan.Models.DTOs.HousekeepingTaskDto>
@{
    ViewData["Title"] = "Việc của tôi";
    var dangLam = Model.Where(t => t.TrangThai != HousekeepingTaskStatus.Completed).ToList();
    var daXong = Model.Where(t => t.TrangThai == HousekeepingTaskStatus.Completed).ToList();
}

<div class="page-header">
    <div>
        <p class="page-label">Buồng phòng</p>
        <h2>Việc của tôi hôm nay</h2>
    </div>
    <div class="text-end">
        <div class="fw-bold text-navy">@User.GetHoTen()</div>
        <small class="text-muted">@dangLam.Count việc cần làm · @daXong.Count việc đã xong hôm nay</small>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success mb-3">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger mb-3">@TempData["ErrorMessage"]</div>
}

<div class="row g-4 mb-4">
    @if (dangLam.Any())
    {
        foreach (var t in dangLam)
        {
            var (badge, label) = t.TrangThai switch
            {
                HousekeepingTaskStatus.Assigned => ("bg-primary", "Chưa bắt đầu"),
                HousekeepingTaskStatus.InProgress => ("bg-info text-dark", "Đang dọn"),
                HousekeepingTaskStatus.Issue => ("bg-danger", "Đã báo sự cố"),
                _ => ("bg-secondary", t.TrangThai.GetDisplayName())
            };
            <div class="col-lg-4 col-md-6">
                <div class="card h-100 p-4">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <small class="text-gold fw-bold text-uppercase" style="letter-spacing:1px">@t.TenLoaiPhong</small>
                            <h4 class="text-navy fw-bold mb-0" style="font-family:'Cormorant Garamond', serif">Phòng @t.SoPhong</h4>
                        </div>
                        <span class="badge @badge">@label</span>
                    </div>
                    <p class="text-muted small mb-1"><i class="fas fa-broom me-2"></i>@t.LoaiCongViec</p>
                    <p class="text-muted small mb-3">
                        <i class="fas fa-clock me-2"></i>Giao lúc @(t.ThoiGianGiao?.ToString("HH:mm dd/MM") ?? "—")
                        @if (t.ThoiGianBatDau != null)
                        {
                            <span> · bắt đầu @t.ThoiGianBatDau.Value.ToString("HH:mm")</span>
                        }
                    </p>
                    @if (!string.IsNullOrEmpty(t.GhiChu))
                    {
                        <p class="small text-danger mb-3"><i class="fas fa-sticky-note me-2"></i>@t.GhiChu</p>
                    }

                    <div class="mt-auto d-flex gap-2 flex-wrap">
                        @if (t.TrangThai == HousekeepingTaskStatus.Assigned)
                        {
                            <form asp-action="Start" method="post" class="flex-fill">
                                <input type="hidden" name="id" value="@t.MaPhanCong" />
                                <button type="submit" class="btn btn-outline-navy w-100"><i class="fas fa-play me-1"></i>Bắt đầu</button>
                            </form>
                        }
                        @if (t.TrangThai == HousekeepingTaskStatus.Assigned || t.TrangThai == HousekeepingTaskStatus.InProgress)
                        {
                            <form asp-action="Complete" method="post" class="flex-fill">
                                <input type="hidden" name="id" value="@t.MaPhanCong" />
                                <button type="submit" class="btn btn-gold w-100"><i class="fas fa-check me-1"></i>Dọn xong</button>
                            </form>
                            <form asp-action="ReportIssue" method="post" class="w-100" onsubmit="return askIssue(this)">
                                <input type="hidden" name="id" value="@t.MaPhanCong" />
                                <input type="hidden" name="ghiChu" />
                                <button type="submit" class="btn btn-sm btn-outline-danger w-100"><i class="fas fa-exclamation-triangle me-1"></i>Báo sự cố</button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="card p-5 text-center text-muted">
                <i class="fas fa-mug-hot" style="font-size:2.5rem;opacity:0.3"></i>
                <p class="mt-3 mb-0">Chưa có việc nào được giao. Lễ tân sẽ giao việc khi có phòng cần dọn.</p>
            </div>
        </div>
    }
</div>

@if (daXong.Any())
{
    <div class="card">
        <div class="card-body p-0">
            <div class="p-3 border-bottom"><h6 class="fw-bold mb-0 text-navy"><i class="fas fa-check-circle text-success me-2"></i>Đã hoàn thành hôm nay</h6></div>
            <table class="table table-custom mb-0">
                <thead><tr><th>Phòng</th><th>Công việc</th><th>Bắt đầu</th><th>Hoàn thành</th></tr></thead>
                <tbody>
                    @foreach (var t in daXong)
                    {
                        <tr>
                            <td>Phòng @t.SoPhong</td>
                            <td>@t.LoaiCongViec</td>
                            <td>@(t.ThoiGianBatDau?.ToString("HH:mm") ?? "—")</td>
                            <td>@(t.ThoiGianHoanThanh?.ToString("HH:mm") ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<script>
    // Bắt buộc mô tả sự cố trước khi gửi
    function askIssue(form) {
        var note = prompt('Mô tả sự cố (vd: vòi sen rò nước, điều hoà không lạnh):', '');
        if (note === null) return false;
        if (!note.trim()) { alert('Vui lòng mô tả sự cố.'); return false; }
        form.querySelector('input[name=ghiChu]').value = note;
        return true;
    }
</script>
