@{
    ViewData["Title"] = "Quản lý Loại Phòng";
    var roomTypes = ViewBag.RoomTypes as IEnumerable<QLKSan.Models.Entities.LoaiPhong>;
}

<div class="page-header">
    <div>
        <p class="page-label">Quản lý tài sản</p>
        <h2>Danh sách Loại phòng</h2>
    </div>
    <button class="btn-gold" data-bs-toggle="modal" data-bs-target="#addRoomTypeModal">
        <i class="fas fa-plus me-2"></i>Thêm loại phòng
    </button>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success mb-3">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger mb-3">@TempData["ErrorMessage"]</div>
}

<div class="card">
    <div class="card-body p-0">
        <table class="table table-custom mb-0">
            <thead>
                <tr>
                    <th>Mã loại</th>
                    <th>Tên loại phòng</th>
                    <th>Số người tối đa</th>
                    <th>Giá / Ngày</th>
                    <th>Giá / Giờ</th>
                    <th>Mô tả</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (roomTypes != null && roomTypes.Any())
                {
                    foreach (var rt in roomTypes)
                    {
                        <tr>
                            <td><strong>@rt.MaLoai</strong></td>
                            <td class="text-gold fw-bold">@rt.TenLoai</td>
                            <td>@rt.SoNguoiToiDa</td>
                            <td class="text-gold fw-bold">@QLKSan.Helpers.FormatHelper.ToVND(rt.GiaThueNgay)</td>
                            <td>@QLKSan.Helpers.FormatHelper.ToVND(rt.GiaThueGio)</td>
                            <td>@rt.MoTa</td>
                            <td>
                                <div class="d-flex gap-2">
                                    <button type="button" class="btn btn-sm btn-outline-primary" 
                                            onclick="editRoomType('@rt.MaLoai', '@rt.TenLoai', '@rt.SoNguoiToiDa', '@rt.GiaThueNgay.ToString("0")', '@rt.GiaThueGio.ToString("0")', '@rt.MoTa')">
                                        <i class="fas fa-pen"></i>
                                    </button>
                                    <form asp-action="DeleteRoomType" method="post" class="d-inline" onsubmit="return confirm('Xóa loại phòng @rt.TenLoai?')">
                                        <input type="hidden" name="maLoai" value="@rt.MaLoai" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="7" class="text-center text-muted p-4">Chưa có loại phòng nào.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Add RoomType Modal -->
<div class="modal fade" id="addRoomTypeModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold"><i class="fas fa-layer-group me-2"></i>Thêm loại phòng mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="AddRoomType" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tên loại phòng</label>
                        <input type="text" name="tenLoai" class="form-control" placeholder="VD: VIP, Standard..." required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Số người tối đa</label>
                        <input type="number" name="soNguoiToiDa" class="form-control" placeholder="VD: 2" min="1" max="10" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Giá thuê / Ngày (₫)</label>
                        <input type="number" name="giaThueNgay" class="form-control" placeholder="VD: 1500000" min="0" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Giá thuê / Giờ (₫)</label>
                        <input type="number" name="giaThueGio" class="form-control" placeholder="VD: 200000" min="0" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Mô tả</label>
                        <textarea name="moTa" class="form-control" rows="3" placeholder="Mô tả về loại phòng..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn-gold">Thêm</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit RoomType Modal -->
<div class="modal fade" id="editRoomTypeModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold"><i class="fas fa-pen me-2"></i>Cập nhật loại phòng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="EditRoomType" method="post">
                <div class="modal-body">
                    <input type="hidden" name="maLoai" id="editRTMaLoai" />
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tên loại phòng</label>
                        <input type="text" name="tenLoai" id="editRTTenLoai" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Số người tối đa</label>
                        <input type="number" name="soNguoiToiDa" id="editRTSoNguoi" class="form-control" min="1" max="10" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Giá thuê / Ngày (₫)</label>
                        <input type="number" name="giaThueNgay" id="editRTGiaNgay" class="form-control" min="0" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Giá thuê / Giờ (₫)</label>
                        <input type="number" name="giaThueGio" id="editRTGiaGio" class="form-control" min="0" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Mô tả</label>
                        <textarea name="moTa" id="editRTMoTa" class="form-control" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn-gold">Cập nhật</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function editRoomType(maLoai, tenLoai, soNguoi, giaNgay, giaGio, moTa) {
            document.getElementById('editRTMaLoai').value = maLoai;
            document.getElementById('editRTTenLoai').value = tenLoai;
            document.getElementById('editRTSoNguoi').value = soNguoi;
            document.getElementById('editRTGiaNgay').value = Math.floor(giaNgay);
            document.getElementById('editRTGiaGio').value = Math.floor(giaGio);
            document.getElementById('editRTMoTa').value = moTa;
            var modal = new bootstrap.Modal(document.getElementById('editRoomTypeModal'));
            modal.show();
        }
    </script>
}
