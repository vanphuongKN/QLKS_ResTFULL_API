# Sao chép thành .env rồi đổi giá trị (file .env không đưa lên git)
# Mật khẩu sa của SQL Server: tối thiểu 8 ký tự, có chữ hoa, chữ thường, số và ký tự đặc biệt; không dùng dấu ; hoặc '
SA_PASSWORD=Doi-Mat-Khau-Nay-2026
# Khoá ký JWT (API lõi và Gateway dùng chung): chuỗi ngẫu nhiên tối thiểu 32 ký tự
JWT_KEY=thay-bang-chuoi-ngau-nhien-it-nhat-32-ky-tu
# Mật khẩu tài khoản qlksan của RabbitMQ (chỉ chữ và số để ghép vào địa chỉ amqp://)
