{
  "Jwt": {
    "Key": "",
    "Issuer": "QLKSan.API",
    "Audience": "QLKSan.Web"
  },
  "RateLimit": {
    "MoiPhut": 600,
    "DangNhapMoiPhut": 20,
    "ChatMoiPhut": 20
  },
  "Gateway": {
    "MangTinCay": []
  },
  "ReverseProxy": {
    "Routes": {
      "dang-nhap": {
        "ClusterId": "core",
        "Order": 1,
        "RateLimiterPolicy": "dang-nhap",
        "Match": { "Path": "/api/auth/login", "Methods": [ "POST" ] }
      },
      "dang-ky": {
        "ClusterId": "core",
        "Order": 1,
        "RateLimiterPolicy": "dang-nhap",
        "Match": { "Path": "/api/auth/register", "Methods": [ "POST" ] }
      },
      "tro-ly-ao": {
        "ClusterId": "chatbot",
        "Order": 5,
        "RateLimiterPolicy": "chat",
        "Match": { "Path": "/api/chat/{**duong-dan}" }
      },
      "api": {
        "ClusterId": "core",
        "Order": 10,
        "RateLimiterPolicy": "mac-dinh",
        "Match": { "Path": "/api/{**duong-dan}" }
      },
      "anh-tai-len": {
        "ClusterId": "core",
        "Order": 10,
        "Match": { "Path": "/uploads/{**duong-dan}" }
      }
    },
    "Clusters": {
      "core": {
        "Destinations": {
          "api": { "Address": "http://localhost:5001/" }
        }
      },
      "chatbot": {
        "Destinations": {
          "chatbot": { "Address": "http://localhost:5004/" }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*"
}
