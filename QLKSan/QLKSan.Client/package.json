{
  "name": "qlksan-client",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Trang khách LUXE RESERVE (React SPA) — gọi API qua QLKSan.Gateway",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "gen:api": "openapi-typescript ${API_OPENAPI_URL:-https://localhost:7001/openapi/v1.json} -o src/api/schema.d.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.4"
  }
}
